    {
      "id": "n2",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FIRMS = [\n  { key: 'Fireside Ventures', re: /^fireside ventures$/i },\n  { key: 'Flipkart Ventures', re: /^flipkart ventures$/i },\n  { key: 'Blinc Invest',      re: /^blinc invest$/i },\n  { key: 'M Venture Partners',re: /^m venture partners$/i },\n  { key: 'Debtworks DEBT',    re: /^debtworks/i },\n];\nconst yes = (x) => String(x || '').trim().toLowerCase() === 'yes';\nconst out = {};\nfor (const f of FIRMS) { out[f.key] = { total: 0, sent: 0, unsent: 0, with_reply: 0, sent_rows: [] }; }\n\nfor (const p of $('Read PIPELINE').all()) {\n  const inv = String(p.json.investor || '').trim();\n  for (const f of FIRMS) {\n    if (!f.re.test(inv)) continue;\n    const o = out[f.key];\n    o.total++;\n    if (String(p.json.investor_response || '').trim() !== '') { o.with_reply++; }\n    if (yes(p.json.deal_shared)) {\n      o.sent++;\n      o.sent_rows.push({ deal_id: p.json.deal_id, startup: p.json.startup, owner: p.json.owner, date_shared: p.json.date_shared, next_action: p.json.next_action, next_due: p.json.next_due, resp: p.json.investor_response });\n    } else { o.unsent++; }\n  }\n}\nreturn [{ json: out }];"
      }
    }
  ],
