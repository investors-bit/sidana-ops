        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nconst pipe = $input.all().map(function (i) { return i.json; });\nif (pipe.length < 500) { throw new Error('ABORT: PIPELINE only ' + pipe.length); }\n\nconst out = [];\nfor (const p of pipe) {\n  if (nz(p.investor).indexOf('kaecapital') < 0) { continue; }\n  if (s(p.deal_shared).toLowerCase() === 'yes') { continue; }   // never touch sent rows (thread_id lives there)\n  if (s(p.pause).toLowerCase() === 'yes') { continue; }          // idempotent\n  const note = s(p.notes);\n  out.push({ json: { row_number: p.row_number, pause: 'Yes', next_due: '',\n    notes: (note ? note + ' | ' : '') + 'Stopped 2026-09-09 - Kae Capital do_not_contact' } });\n}\nif (out.length > 20) { throw new Error('ABORT: ' + out.length + ' rows exceeds guard of 20'); }\nif (out.length === 0) { throw new Error('NOTHING TO DO: no unsent unpaused Kae Capital rows'); }\nreturn out;"
      }
