      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nconst hdr = (($('GET INV header').first().json.values || [[]])[0] || []).map(s);\nconst rows = $input.all().map(i => i.json);\nif (rows.length < 150) throw new Error('ABORT: INVESTORS only ' + rows.length + ' rows');\nconst row = {\n  investor: 'RTP Global',\n  contact_person: 'Madhur Makkar',\n  email: 'info@rtp.vc',\n  cc: '',\n  sector: 'B2B Software, Fintech, Consumer Tech, Climate (India team, Bangalore); backs TERN Group (recruitment) - check conflicts',\n  stage: 'Seed, Series A, Series B',\n  cheque_inr_cr: 'US$1-15M'\n};\nconst dom = row.email.split('@')[1];\nconst dup = rows.filter(r => nz(r.investor) === nz(row.investor) || s(r.email).toLowerCase() === row.email || s(r.email).toLowerCase().endsWith('@' + dom));\nif (dup.length) throw new Error('ABORT: ' + row.investor + ' already in INVESTORS at row ' + dup.map(d => d.row_number).join(','));\nif (hdr.includes('contacted_by')) row.contacted_by = 'Akansha';\nconst missing = ['investor', 'contact_person', 'email', 'sector', 'stage', 'cheque_inr_cr'].filter(k => !hdr.includes(k));\nif (missing.length) throw new Error('ABORT: INVESTORS header missing ' + missing.join(','));\nreturn [{ json: { row, header: hdr, rows_before: rows.length } }];"
      }
    },
