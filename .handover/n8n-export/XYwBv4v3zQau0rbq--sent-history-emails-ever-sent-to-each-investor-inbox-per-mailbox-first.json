        "jsCode": "const rows=$('Compile').all().map(i=>i.json);const olds=$input.all().map(i=>i.json);\nconst out=rows.map((r,i)=>{const o=olds[i]||{};const hs=((o.payload||{}).headers||[]);const g=n=>((hs.find(h=>h.name===n)||{}).value||'');return {term:r.term,investors:r.investors,sent_msgs:r.sent_msgs,more_than_500:r.more,threads:r.threads,first_sent:o.internalDate?new Date(Number(o.internalDate)).toISOString().slice(0,10):'',first_subject:g('Subject').slice(0,90),err:r.err};});\nreturn [{json:{mb:$('Webhook').first().json.body.mb,terms:out.length,rows:out}}];"
