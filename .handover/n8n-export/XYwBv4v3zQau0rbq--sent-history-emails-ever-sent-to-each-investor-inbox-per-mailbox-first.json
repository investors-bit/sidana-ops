        "jsCode": "const terms=$('Terms').all().map(i=>i.json);const res=$input.all().map(i=>i.json);\nconst rows=terms.map((t,i)=>{const r=res[i]||{};const msgs=r.messages||[];return {term:t.term,investors:t.investors,sent_msgs:msgs.length,more:!!r.nextPageToken,threads:[...new Set(msgs.map(m=>m.threadId))].length,oldest_id:msgs.length?msgs[msgs.length-1].id:'',err:r.error?String(r.error.message||r.error).slice(0,80):''};});\nreturn rows.map(r=>({json:r}));"
