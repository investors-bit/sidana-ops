      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst b=$('Webhook').first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst mb=s(b.mb);if(['2','3','4','5'].indexOf(mb)<0){throw new Error('mb 2-5');}\nconst inv=$('GET investors').first().json.values||[];const GENERIC=/^(gmail|googlemail|yahoo|outlook|hotmail|icloud|live|rediffmail|protonmail|aol|me|ymail)\\./i;\nconst terms={};for(let i=1;i<inv.length;i++){const r=inv[i]||[];(s(r[2])+','+s(r[3])).toLowerCase().split(/[,;\\s]+/).forEach(e=>{const m=e.match(/^[^@\\s]+@([a-z0-9.-]+\\.[a-z]{2,})$/);if(!m||/sidanaventures\\.com$/.test(m[1])){return;}const t=GENERIC.test(m[1])?e:m[1];(terms[t]=terms[t]||[]).push(s(r[0]));});}\nreturn Object.keys(terms).sort().map(t=>({json:{mb:mb,route:['2','3','4','5'].indexOf(mb),term:t,investors:[...new Set(terms[t])].join(' / ')}}));"
      }
