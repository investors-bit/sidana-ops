        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows = $('Read STARTUPS').all().map(i => i.json);\nconst blank = (x) => x === undefined || x === null || String(x).trim() === '';\nlet total = 0, hasMemo = 0, memoHasDeck = 0, memoHasClosing = 0, memoMissingDeck = 0;\nconst missingDeckExamples = [];\nconst deckDetail = [];\nfor (const s of rows) {\n  total++;\n  const m = String(s.memo_html == null ? '' : s.memo_html);\n  if (blank(m)) continue;\n  hasMemo++;\n  const lower = m.toLowerCase();\n  const deck = lower.includes('pitch deck');\n  const closing = lower.includes('if the opportunity fits') || lower.includes('happy to arrange a discussion');\n  if (deck) memoHasDeck++; else { memoMissingDeck++; if (missingDeckExamples.length < 15) missingDeckExamples.push(s.startup); }\n  if (closing) memoHasClosing++;\n}\nreturn [{ json: {\n  total_startups: total,\n  with_memo_html: hasMemo,\n  memo_contains_pitch_deck_line: memoHasDeck,\n  memo_MISSING_pitch_deck_line: memoMissingDeck,\n  memo_contains_closing_line: memoHasClosing,\n  startups_whose_memo_has_NO_deck_line: missingDeckExamples,\n} }];\n"
      }
    }
  ],
