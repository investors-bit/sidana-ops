      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// BlueGreen pending rows that no longer fit the new mandate.\n// SkillBytes/Springbase.ai/AI Signal Labs/Orbit AI/Vira Jal -> SaaS/DeepTech, dropped from thesis.\nconst TARGETS = ['D00544','D01192','D01257','D01289','D01819'];\nfunction s(v) { return String(v == null ? '' : v).trim(); }\n\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst out = [];\nfor (const t of TARGETS) {\n  const hits = rows.filter(function (r) { return s(r.deal_id) === t; });\n  if (hits.length !== 1) { throw new Error('ABORT: expected 1 row for ' + t + ', found ' + hits.length); }\n  const h = hits[0];\n  if (s(h.investor) !== 'BlueGreen Ventures') { throw new Error('ABORT: ' + t + ' is not BlueGreen (' + s(h.investor) + ')'); }\n  if (s(h.deal_shared).toLowerCase() === 'yes') { throw new Error('ABORT: ' + t + ' has deal_shared=Yes - refusing to delete a sent row'); }\n  if (!h.row_number) { throw new Error('ABORT: no row_number for ' + t); }\n  out.push({ json: { row_number: Number(h.row_number), deal_id: t, startup: s(h.startup) } });\n}\nif (out.length !== TARGETS.length) { throw new Error('ABORT: resolved ' + out.length + ' of ' + TARGETS.length); }\nout.sort(function (a, b) { return b.json.row_number - a.json.row_number; });\nfor (let i = 1; i < out.length; i++) {\n  if (out[i].json.row_number === out[i - 1].json.row_number) { throw new Error('ABORT: duplicate row_number'); }\n}\nreturn out;"
      }
    },
