      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function sh(n){var j={};try{j=$(n).first().json||{};}catch(e){return [];}return j.values||[];}\nfunction s(v){return String(v==null?'':v).trim();}\nfunction norm(x){return s(x).toLowerCase().replace(/[^a-z0-9]/g,'');}\nvar body=($('Webhook').first().json.body)||{};\nvar names=(body.names||[]).map(norm).filter(function(x){return x;});\nfunction hit(rowtext){for(var i=0;i<names.length;i++){if(norm(rowtext).indexOf(names[i])>=0)return names[i];}return '';}\nvar out={};\n\nvar iv=sh('Read INV');var ivh=(iv[0]||[]).map(s);\nout.inv_header=ivh;var im=[];\nfor(var a=1;a<iv.length;a++){var r=iv[a]||[];var t=r.slice(0,4).map(s).join(' | ');var h=hit(t);if(!h)continue;var o={row:a+1};for(var b=0;b<ivh.length;b++){if(ivh[b]&&s(r[b]))o[ivh[b]]=s(r[b]).slice(0,220);}im.push(o);}\nout.inv_matches=im;out.inv_rows=iv.length-1;\n\nvar cv=sh('Read CRIT');var cvh=(cv[0]||[]).map(s);\nout.crit_header=cvh;var cm=[];\nfor(var c=1;c<cv.length;c++){var q=cv[c]||[];var t2=q.slice(0,4).map(s).join(' | ');var h2=hit(t2);if(!h2)continue;var o2={row:c+1};for(var d=0;d<cvh.length;d++){if(cvh[d]&&s(q[d]))o2[cvh[d]]=s(q[d]).slice(0,300);}cm.push(o2);}\nout.crit_matches=cm;out.crit_rows=cv.length-1;\n\nvar su=sh('Read SU');var suh=(su[0]||[]).map(s);\nout.su_header=suh;\nout.su_first3_raw=su.slice(1,4).map(function(r){return (r||[]).map(function(x){return s(x).slice(0,50);});});\nvar sl=[];\nfor(var e=1;e<su.length;e++){var sr=su[e]||[];var any=false;for(var f=0;f<sr.length;f++){if(s(sr[f])){any=true;break;}}if(!any)continue;sl.push({row:e+1,cells:sr.map(function(x){return s(x).slice(0,60);})});}\nout.su_rows=sl.length;out.su=sl;\nreturn [{json:out}];"
      }
    }
