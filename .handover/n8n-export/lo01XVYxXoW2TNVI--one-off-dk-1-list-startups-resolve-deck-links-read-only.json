    {
      "id": "cf",
      "name": "Rows with a link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst out = [];\nfor (const i of $input.all()) { const r = i.json; const n = s(r.startup); if (!n) { continue; }\n  const link = s(r.deck_link).split(/\\s+/)[0];\n  out.push({ json: { row: r.row_number, startup: n, active: s(r.active), owner: s(r.owner), sector: s(r.sector), stage: s(r.stage), deck_link: link, url: /^https?:\\/\\//i.test(link) ? link : (link ? 'https://' + link : '') } }); }\nreturn out.filter(function (x) { return x.json.url; });"
      }
    },
    {
      "id": "hr",
      "name": "Resolve link (no follow)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        600,
        0
      ],
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 20000
        }
      }
    },
    {
      "id": "cc",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src = $('Rows with a link').all().map(function (i) { return i.json; });\nconst res = $input.all().map(function (i) { return i.json; });\nconst all = $('Read STARTUPS').all().map(function (i) { return i.json; });\nconst rows = src.map(function (r, k) { const x = res[k] || {}; const h = x.headers || {};\n  return [r.row, r.startup, r.active, r.owner, r.deck_link, x.statusCode || '', h.location || h.Location || '', x.error ? String(x.error.message || x.error).slice(0, 80) : '']; });\nconst noLink = all.filter(function (r) { return String(r.startup || '').trim() && !String(r.deck_link || '').trim(); }).map(function (r) { return [r.row_number, r.startup, r.active]; });\nreturn [{ json: { startups_total: all.filter(function (r) { return String(r.startup || '').trim(); }).length, with_link: rows.length, rows: rows, no_link: noLink } }];"
      }
    }
  ],
