    {
      "id": "n2",
      "name": "Build resets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FIRMS = [/^fireside ventures$/i, /^flipkart ventures$/i];\nconst RESEND_DUE = '2026-09-05';\nconst yes = (x) => String(x || '').trim().toLowerCase() === 'yes';\nconst blank = (x) => String(x || '').trim() === '';\n\nconst out = [];\nconst detail = [];\nfor (const p of $('Read PIPELINE').all()) {\n  const inv = String(p.json.investor || '').trim();\n  if (!FIRMS.some((re) => re.test(inv))) { continue; }\n  if (!yes(p.json.deal_shared)) { continue; }          // never sent - nothing to reset\n  if (!blank(p.json.investor_response)) { continue; }  // they replied - address worked, leave alone\n  if (!blank(p.json.pause)) { continue; }\n  const id = String(p.json.deal_id || '').trim();\n  detail.push(id + ' ' + p.json.startup + ' / ' + inv + ' (' + p.json.owner + ')');\n  out.push({ json: {\n    deal_id: id,\n    deal_shared: 'No', date_shared: '', channel: '', thread_id: '', message_id: '',\n    fu1_done: '', fu1_date: '', fu2_done: '', fu2_date: '', fu3_done: '', fu3_date: '',\n    last_contact: '', next_action: 'Initial', next_due: RESEND_DUE,\n  } });\n}\n\nif (out.length === 0) { throw new Error('No rows to reset - aborting'); }\nif (out.length > 15) { throw new Error('Sanity check: ' + out.length + ' resets is more than expected'); }\nconsole.log('Resetting ' + out.length + ': ' + detail.join(' | '));\nreturn out;"
      }
    },
