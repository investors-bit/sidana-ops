        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const LBL={'2':'dealflow@','3':'investors@','4':'akansha@','5':'shradhaa@','6':'admin@'};\nconst p=$('Prep').first().json;const first=$input.first().json||{};\nif(first.meta){return [{json:{mode:'count',mb:p.mb,mailbox:LBL[p.mb],ids:first.ids,estimate:first.estimate,nextPageToken:first.nextPageToken}}];}\nconst RX=/[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/g;\nconst rows=[];let n=0;\nfor(const it of $input.all()){const m=it.json||{};if(!m.payload){continue;}n++;\n const H={};(m.payload.headers||[]).forEach(h=>{H[String(h.name).toLowerCase()]=h.value;});\n const ts=Number(m.internalDate||0);\n const to=[H.to,H.cc].filter(Boolean).join(', ');\n const toA=[];const seen={};for(const raw of (String(to).match(RX)||[])){const a=raw.toLowerCase();if(/@sidanaventures\\.com$/.test(a)){continue;}if(!seen[a]){seen[a]=1;toA.push(a);}}\n const fromA=(String(H.from||'').match(RX)||[]).map(x=>x.toLowerCase());\n rows.push({id:m.id,thread:m.threadId||'',ts:ts,subject:String(H.subject||'').slice(0,160),to:toA,from:fromA[0]||'',labels:(m.labelIds||[]).join(',')});}\nconst npt=$('Split').first().json.nextPageToken||'';\nreturn [{json:{mode:'fetch',mb:p.mb,mailbox:LBL[p.mb],q:p.q,messages:n,nextPageToken:npt,rows:rows}}];"
        }
      }
