      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst DEL=['D01660','D02265','D03212','D00268','D00496','D00528','D00578','D01132','D01621','D01637','D02214','D02296','D02367','D02378','D02460','D02699','D02774','D03070','D03071','D03072','D03073'];\nconst inv=$('Read INVESTORS').all().map(i=>i.json);\nconst el=$('Read ERROR LOG').all().map(i=>i.json);\nconst pipe=$input.all().map(i=>i.json);\nconst recs={};\nfor(const n of ['Riceberg Ventures','Siana Capital','Elevation Capital']){\n  recs[n]=inv.filter(r=>s(r.investor)===n).map(r=>({row:r.row_number,sector:s(r.sector),stage:s(r.stage),cheque:s(r.cheque_inr_cr),email:s(r.email)}));\n}\nconst stillThere=DEL.filter(id=>pipe.some(r=>s(r.deal_id)===id));\nconst remaining={};\nfor(const n of ['Riceberg Ventures','Siana Capital']){\n  remaining[n]=pipe.filter(r=>s(r.investor)===n).map(r=>s(r.deal_id)+' '+s(r.startup)+' shared='+s(r.deal_shared)+' pri='+s(r.priority));\n}\nconst openFlags=el.filter(r=>s(r.workflow).toUpperCase()==='THESIS-WATCH'&&s(r.resolved)==='').map(r=>({row:r.row_number,investor:s(r.investor),error_type:s(r.error_type)}));\nconst closedToday=el.filter(r=>s(r.workflow).toUpperCase()==='THESIS-WATCH'&&s(r.resolved).toLowerCase()==='yes').map(r=>({row:r.row_number,investor:s(r.investor),resolved:s(r.resolved)}));\nreturn [{json:{pipeline_rows:pipe.length,error_log_rows:el.length,investors_rows:inv.length,deleted_ids_still_present:stillThere,records:recs,remaining_rows:remaining,open_thesis_watch_flags:openFlags,resolved_thesis_watch_flags:closedToday}}];"
      }
    }
  ],
