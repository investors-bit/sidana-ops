        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst v = $input.first().json.values || [];\nconst before = $('Build row').first().json.rows_before;\nconst hits = [];\nv.forEach(function (r, i) { if (s((r || [])[2]).toLowerCase() === 'gk@gautamkapur.com') { hits.push({ row: i + 1, cells: (r || []).map(function (c) { return s(c); }) }); } });\nif (hits.length !== 1) { throw new Error('ABORT: expected exactly 1 Gautam row, found ' + hits.length); }\nconst r = hits[0].cells;\nconst blanks = [];\n[[0,'investor'],[1,'contact_person'],[2,'email'],[4,'sector'],[5,'stage'],[6,'cheque_inr_cr']].forEach(function (p) { if (!s(r[p[0]])) { blanks.push(p[1]); } });\nreturn [{ json: { rows_before: before, rows_after: v.length, added: v.length - before, investor_row: hits[0].row, blanks: blanks, cells: r } }];"
      }
