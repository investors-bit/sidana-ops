      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst v = $input.first().json.values || [];\nif (v.length < 200) { throw new Error('ABORT: INVESTORS only ' + v.length + ' rows'); }\nconst hdr = (v[0] || []).map(s);\nconst want = ['investor','contact_person','email','cc','sector','stage','cheque_inr_cr','last_contacted_any','contacted_by','do_not_contact'];\nif (hdr.join('|') !== want.join('|')) { throw new Error('ABORT: unexpected INVESTORS header: ' + JSON.stringify(hdr)); }\nconst EMAIL = 'gk@gautamkapur.com';\nfor (const r of v.slice(1)) { const row = r || [];\n  if (s(row[2]).toLowerCase().indexOf(EMAIL) >= 0) { throw new Error('ABORT: an INVESTORS row already uses ' + EMAIL + ': ' + s(row[0])); }\n  if (s(row[0]).toLowerCase() === 'gautam' || s(row[0]).toLowerCase() === 'gautam kapur') { throw new Error('ABORT: an investor called ' + s(row[0]) + ' already exists'); } }\nconst row = [\n'Gautam Kapur',\n'Gautam',\nEMAIL,\n'',\n'Sector agnostic - excludes deep science and healthcare',\n'Idea stage, Pre-seed',\n'US$20-50K (INR 0.17-0.43 Cr)',\n'',\n'',\n''\n];\nif (row.length !== 10) { throw new Error('ABORT: row length ' + row.length); }\nfor (const i of [0,1,2,4,5,6]) { if (!s(row[i])) { throw new Error('ABORT: blank required column ' + want[i]); } }\nreturn [{ json: { rows_before: v.length, body: { values: [row] } } }];"
      }
