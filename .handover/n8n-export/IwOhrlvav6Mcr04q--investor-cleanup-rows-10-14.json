        "jsCode": "// Reset rows 10-14 back to originals and clear verification flag + source.\n// Row 10 a99 VC: original khushi@a99.vc (bad append kruti@247vc.in removed)\n// Row 11 Capital-A: original raashi@capital-a.vc ; Utkarsh@aakashemprise.com (bad append rahul@hanu.ai removed)\n// Row 12 Capital-A: original raashi@capital-a.vc (bad xproguard appends removed)\n// Row 13 Aavishkar Capital DEBT: mukund@aavishkaar.in (unchanged, just clear flag)\n// Row 14 Aavishkar Capital DEBT: mukund@aavishkaar.in (unchanged, just clear flag)\nconst rows = [\n  { row_number: 10, \"Investors Email\": \"khushi@a99.vc\" },\n  { row_number: 11, \"Investors Email\": \"raashi@capital-a.vc ; Utkarsh@aakashemprise.com\" },\n  { row_number: 12, \"Investors Email\": \"raashi@capital-a.vc\" },\n  { row_number: 13, \"Investors Email\": \"mukund@aavishkaar.in\" },\n  { row_number: 14, \"Investors Email\": \"mukund@aavishkaar.in\" },\n];\nreturn rows.map(r => ({ json: {\n  row_number: r.row_number,\n  \"Investors Email\": r[\"Investors Email\"],\n  \"Verification of email\": \"\",\n  \"Email Verification Source / Date\": \"\",\n} }));"
