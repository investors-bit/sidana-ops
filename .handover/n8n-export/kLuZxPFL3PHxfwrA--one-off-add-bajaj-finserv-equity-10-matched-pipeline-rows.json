    {
      "id": "n6",
      "name": "Build PIPELINE rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const INVESTOR = 'Bajaj Finserv (Equity)';\nconst EMAIL = 'gaurav.navani@bajajfinserv.in';\nconst SCORE = 85;\nconst NOTE = 'Very High match (85)';\n\n// 2 per day, one per mailbox, weekdays only\nconst PLAN = [\n  { startup: 'Xproguard',     next_due: '2026-09-04' },\n  { startup: 'Ulai',          next_due: '2026-09-04' },\n  { startup: 'GroCliq',       next_due: '2026-09-07' },\n  { startup: 'AI Signal Labs', next_due: '2026-09-07' },\n  { startup: 'Springbase.ai', next_due: '2026-09-08' },\n  { startup: 'Orbo AI',       next_due: '2026-09-08' },\n  { startup: 'Opulytics',     next_due: '2026-09-09' },\n  { startup: 'Vilva AI',      next_due: '2026-09-09' },\n  { startup: 'Pixelence',     next_due: '2026-09-10' },\n  { startup: 'EosNox',        next_due: '2026-09-10' },\n];\n\nconst startupByName = {};\nfor (const s of $('Read STARTUPS').all()) { startupByName[String(s.json.startup).trim()] = s.json; }\n\nlet maxId = 0;\nfor (const p of $('Read PIPELINE').all()) {\n  const m = String(p.json.deal_id || '').trim().match(/^D(\\d+)$/);\n  if (m) { const n = parseInt(m[1], 10); if (n > maxId) maxId = n; }\n}\n\nconst out = [];\nlet seq = maxId;\nfor (const p of PLAN) {\n  const st = startupByName[p.startup];\n  if (!st) { throw new Error('Startup not found in STARTUPS: ' + p.startup); }\n  if (String(st.active || '').trim().toLowerCase() !== 'yes') { throw new Error('Startup not active: ' + p.startup); }\n  const owner = String(st.owner || '').trim();\n  if (owner === '') { throw new Error('Startup has no owner: ' + p.startup); }\n  seq++;\n  out.push({ json: {\n    deal_id: 'D' + String(seq).padStart(5, '0'),\n    startup: p.startup,\n    owner: owner,\n    investor: INVESTOR,\n    email: EMAIL,\n    cc: '',\n    priority: SCORE,\n    deal_shared: 'No',\n    next_action: 'Initial',\n    next_due: p.next_due,\n    notes: NOTE,\n  } });\n}\nif (out.length !== PLAN.length) { throw new Error('Row count mismatch - aborting'); }\nreturn out;"
      }
