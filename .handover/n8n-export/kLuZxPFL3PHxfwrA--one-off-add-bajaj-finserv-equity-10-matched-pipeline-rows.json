      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const INVESTOR = 'Bajaj Finserv (Equity)';\nfor (const v of $('Read INVESTORS').all()) {\n  if (String(v.json.investor || '').trim().toLowerCase() === INVESTOR.toLowerCase()) {\n    throw new Error('Investor already exists in INVESTORS - aborting to avoid a duplicate');\n  }\n}\nfor (const p of $('Read PIPELINE').all()) {\n  if (String(p.json.investor || '').trim().toLowerCase() === INVESTOR.toLowerCase()) {\n    throw new Error('PIPELINE already has rows for this investor - aborting');\n  }\n}\nreturn [{ json: {\n  investor: INVESTOR,\n  contact_person: 'Gaurav',\n  email: 'gaurav.navani@bajajfinserv.in',\n  cc: '',\n  sector: 'Quantum, AI, Consumer Tech, Cybersecurity',\n  stage: 'Pre-Seed, Seed, Pre-Series A, Series A, Series B',\n  cheque_inr_cr: 'INR 5-50 Cr',\n  last_contacted_any: '',\n  contacted_by: '',\n  do_not_contact: '',\n} }];"
      }
    },
