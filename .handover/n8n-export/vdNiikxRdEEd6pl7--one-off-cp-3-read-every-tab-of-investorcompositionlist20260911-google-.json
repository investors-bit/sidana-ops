      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const t = ($input.first().json.sheets || []).map(function (x) { return x.properties.title; });\nif (!t.length) { throw new Error('ABORT: no tabs returned'); }\nreturn t.map(function (title) { return { json: { tab: title } }; });"
      }
    },
