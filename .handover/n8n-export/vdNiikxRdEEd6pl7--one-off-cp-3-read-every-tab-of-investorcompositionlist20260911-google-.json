      "id": "cc",
      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const tabs = $('One item per tab').all().map(function (i) { return i.json.tab; });\nconst vals = $input.all().map(function (i) { return i.json; });\nreturn [{ json: { tabs: tabs.map(function (t, i) { const v = (vals[i] || {}).values || []; return { tab: t, rows: v.length, values: v }; }) } }];"
      }
    }
