    {
      "id": "ex",
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst v = $('GET pilot').first().json.valueRanges || [];\nconst inv = (v[0] || {}).values || [], st = (v[1] || {}).values || [];\nif (inv.length < 200 || st.length < 40) { throw new Error('ABORT short read'); }\nconst ih = (inv[0] || []).map(s); const I = {}; ih.forEach(function (h, i) { I[h] = i; });\nconst sh = (st[0] || []).map(s); const S = {}; sh.forEach(function (h, i) { S[h] = i; });\nconst investors = [];\nfor (let r = 1; r < inv.length; r++) { const row = inv[r] || []; const n = s(row[I.investor]); if (!n) { continue; }\n  investors.push([r + 1, n, s(row[I.sector]), s(row[I.stage]), s(row[I.cheque_inr_cr]), s(row[I.do_not_contact]), s(row[I.email]) ? 'email' : 'NO EMAIL'].join(' ~ ')); }\nfunction strip(h) { return s(h).replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&[a-z#0-9]+;/gi, ' ').replace(/\\s+/g, ' ').trim(); }\nconst startups = [];\nfor (let r = 1; r < st.length; r++) { const row = st[r] || []; const n = s(row[S.startup]); if (!n) { continue; }\n  startups.push([r + 1, n, 'active=' + s(row[S.active]), s(row[S.sector]), s(row[S.stage]), 'raise=' + s(row[S.raise_inr_cr]), 'rev=' + s(row[S.revenue]), 'h1=' + s(row[S.highlight_1]).slice(0, 110), 'memo=' + strip(row[S.memo_html]).slice(0, 380)].join(' ~ ')); }\nreturn [{ json: { investors: investors, startups: startups } }];"
      }
    },
