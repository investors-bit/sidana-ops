      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const COL=$('Prep').first().json.col;\nfunction cn(i){let s='';i=i+1;while(i>0){const m=(i-1)%26;s=String.fromCharCode(65+m)+s;i=Math.floor((i-1)/26);}return s;}\nconst m=$input.first().json;\nconst sh=(m.sheets||[]).find(s=>((s.properties||{}).title)==='ONBOARDING');\nif(!sh){throw new Error('ONBOARDING not found');}\nconst mg=sh.merges||[];\nconst inCol=mg.filter(r=>COL>=r.startColumnIndex&&COL<r.endColumnIndex);\nconst nonAnchor=[];const anchor=[];\nfor(const r of inCol){for(let row=r.startRowIndex;row<r.endRowIndex;row++){\n  const isAnchor=(r.startColumnIndex===COL&&r.startRowIndex===row);\n  (isAnchor?anchor:nonAnchor).push(row+1);\n}}\nreturn [{json:{probeCol:cn(COL)+' (idx '+COL+')',totalMerges:mg.length,mergesCoveringProbeCol:inCol.length,nonAnchorRowCount:nonAnchor.length,nonAnchorRows:nonAnchor.sort((a,b)=>a-b),anchorRowCount:anchor.length}}];"
      }
    }
  ],
