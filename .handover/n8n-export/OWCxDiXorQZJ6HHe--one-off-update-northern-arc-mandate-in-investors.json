      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const matches = [];\nfor (const v of $('Read INVESTORS').all()) {\n  if (/northern\\s*arc/i.test(String(v.json.investor || ''))) { matches.push(v.json); }\n}\nif (matches.length === 0) { throw new Error('NORTHERN ARC not found in INVESTORS - aborting'); }\nif (matches.length > 1) { throw new Error('Found ' + matches.length + ' NORTHERN ARC rows - aborting to avoid ambiguity'); }\n\nconst row = matches[0];\nconst exactName = String(row.investor).trim();\n\nreturn [{ json: {\n  investor: exactName,\n  sector: 'DEBT ONLY | B2B, Consumer, D2C, F&B, FMCG, FinTech, SaaS, Supply Chain | Excludes: infrastructure with government end-customer | Cautious: jewellery, gems, logistics',\n  stage: 'Profit-generating required; if loss-making needs prior institutional investor backing; if rated, BBB- or above',\n  cheque_inr_cr: 'INR 15-25 Cr sweet spot; supply chain INR 5-20 Cr; +/- INR 3-4 Cr workable; 14-16% transaction charges; tenor up to 90 days',\n} }];"
      }
    },
