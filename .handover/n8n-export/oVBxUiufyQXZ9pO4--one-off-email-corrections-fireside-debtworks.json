      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FIX = [\n  { match: /^fireside ventures$/i, email: 'aashish@firesideventures.com,satwik@firesideventures.com' },\n  { match: /^debtworks/i,          email: 'kunal@debtworks.co.in,chetan@debtworks.co.in' },\n];\nconst out = [];\nfor (const p of $('Read PIPELINE').all()) {\n  const inv = String(p.json.investor || '').trim();\n  for (const f of FIX) {\n    if (f.match.test(inv)) {\n      out.push({ json: { deal_id: String(p.json.deal_id).trim(), email: f.email } });\n    }\n  }\n}\nif (out.length === 0) { throw new Error('No PIPELINE rows matched - aborting'); }\nif (out.length > 40) { throw new Error('Sanity check: ' + out.length + ' rows is more than expected'); }\nreturn out;"
      }
