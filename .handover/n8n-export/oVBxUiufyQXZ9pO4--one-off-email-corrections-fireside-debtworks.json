    {
      "id": "n3",
      "name": "Build INVESTORS updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FIX = [\n  { match: /^fireside ventures$/i, contact_person: 'Aashish, Satwik', email: 'aashish@firesideventures.com,satwik@firesideventures.com' },\n  { match: /^debtworks/i,          contact_person: 'Kunal, Chetan',   email: 'kunal@debtworks.co.in,chetan@debtworks.co.in' },\n];\nconst out = [];\nconst seen = {};\nfor (const v of $('Read INVESTORS').all()) {\n  const name = String(v.json.investor || '').trim();\n  for (const f of FIX) {\n    if (f.match.test(name)) {\n      out.push({ json: { investor: name, contact_person: f.contact_person, email: f.email } });\n      seen[f.email] = true;\n    }\n  }\n}\nif (out.length !== FIX.length) { throw new Error('Expected ' + FIX.length + ' INVESTORS matches, found ' + out.length + ' - aborting'); }\nreturn out;"
      }
    },
