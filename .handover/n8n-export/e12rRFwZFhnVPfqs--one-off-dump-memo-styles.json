    {
      "id": "b71a819d-7e16-41a9-bffa-df134f2c0459",
      "name": "Dump memo styles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nlet target = null;\nfor (const r of rows) { if (String(r.startup || r.startup_name || '').trim().toLowerCase() === 'indie stori') { target = r; break; } }\nif (!target) target = rows[0];\nconst memo = String(target.memo_html || '');\n// Collect every distinct style=\"\" attribute value that appears\nconst styleAttrs = [];\nconst styleRe = /style\\s*=\\s*\"([^\"]*)\"/gi;\nlet m;\nwhile ((m = styleRe.exec(memo)) !== null) { styleAttrs.push(m[1]); }\n// Collect distinct opening tags (first 40)\nconst tagRe = /<([a-zA-Z0-9]+)([^>]*)>/g;\nconst tags = [];\nlet t;\nwhile ((t = tagRe.exec(memo)) !== null && tags.length < 60) { tags.push('<' + t[1] + t[2] + '>'); }\nreturn [{ json: {\n  startup: target.startup || target.startup_name,\n  memo_length: memo.length,\n  distinct_style_attrs: Array.from(new Set(styleAttrs)),\n  first_tags: tags,\n  head: memo.slice(0, 1200),\n} }];"
      }
    }
  ],
