        "jsCode": "function hstr(v){if(!v)return '';if(typeof v==='string')return v;if(v.text)return String(v.text);if(v.value&&v.value[0])return '<'+v.value[0].address+'>';return String(v);}\nfunction grab(n,lbl){var out=[];var it=[];try{it=$(n).all();}catch(e){return out;}\n for(var i=0;i<it.length;i++){var j=it[i].json||{};if(!j.id&&!j.messages)continue;\n  var msgs=j.messages?j.messages:[j];\n  for(var k=0;k<msgs.length;k++){var m=msgs[k]||{};if(!m.id)continue;\n   var body=m.text||m.textPlain||'';if(!body&&m.html)body=String(m.html).replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&');\n   if(!body)body=String(m.snippet||'');\n   body=String(body).replace(/\\r/g,'');while(body.indexOf('\\n\\n\\n')>-1)body=body.split('\\n\\n\\n').join('\\n\\n');\n   out.push({box:lbl,id:m.id,thread:m.threadId||'',from:hstr(m.from),to:hstr(m.to),date:String(m.date||''),subject:String(m.subject||''),labels:(m.labelIds||[]).join(','),hasCalendly:body.toLowerCase().indexOf('calendly')>-1,body:body.slice(0,3000)});}}\n return out;}\nvar ip=grab('IronPillar thread','admin@');var nv=grab('Navam thread','shradhaa@');\nreturn [{json:{ironPillar:{count:ip.length,anyCalendly:ip.some(function(x){return x.hasCalendly;}),messages:ip},navam:{count:nv.length,anyCalendly:nv.some(function(x){return x.hasCalendly;}),messages:nv}}}];"
