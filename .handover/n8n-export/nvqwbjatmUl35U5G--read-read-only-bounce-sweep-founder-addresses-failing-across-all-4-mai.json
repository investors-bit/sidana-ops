      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = (v) => String(v == null ? '' : v).trim();\nconst low = (v) => s(v).toLowerCase();\n\n// founder addresses on file\nconst byEmail = {};\nfor (const it of $input.all()) {\n  const j = it.json; const st = s(j['Startup']); if (!st) continue;\n  for (const e of s(j['Emails']).split(/[,;\\s]+/)) {\n    const a = low(e);\n    if (/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(a)) (byEmail[a] = byEmail[a] || { startup: st, row: j.row_number });\n  }\n}\n\nconst boxes = [['Aditya investors@', 'DSN Aditya (investors@)'], ['Chaman dealflow@', 'DSN Chaman (dealflow@)'], ['Akansha', 'DSN Akansha'], ['Shradhaa', 'DSN Shradhaa']];\nconst hits = {};\nconst scanned = {};\nlet errors = [];\nfor (const [label, node] of boxes) {\n  let items = [];\n  try { items = $(node).all(); } catch (e) { errors.push(label + ': ' + e.message); continue; }\n  let n = 0;\n  for (const it of items) {\n    const m = it.json || {};\n    if (m.error) { errors.push(label + ': ' + JSON.stringify(m.error).slice(0, 120)); continue; }\n    n++;\n    const text = [m.snippet, m.text, m.textPlain, m.Subject, m.subject].map(s).join(' \\n ');\n    const failure = /not delivered|delivery to the following recipient failed|permanent(ly)? fail|address not found|couldn'?t be found|does not exist|550|553|554/i.test(text);\n    const delay = /delivery incomplete|temporary problem|will retry|delayed/i.test(text);\n    if (!failure && !delay) continue;\n    const date = s(m.date || m.internalDate);\n    for (const raw of (text.match(/[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}/g) || [])) {\n      const a = low(raw);\n      if (!byEmail[a]) continue;\n      const k = a;\n      const h = hits[k] || (hits[k] = { email: a, startup: byEmail[a].startup, founders_info_row: byEmail[a].row, hard_failures: 0, delays: 0, mailboxes: {}, latest: '' });\n      if (failure) h.hard_failures++; else h.delays++;\n      h.mailboxes[label] = (h.mailboxes[label] || 0) + 1;\n      if (date > h.latest) h.latest = date;\n    }\n  }\n  scanned[label] = n;\n}\nconst list = Object.values(hits).sort((a, b) => (b.hard_failures - a.hard_failures) || (b.delays - a.delays));\nreturn [{ json: { window: 'mailer-daemon notices, last 120 days', dsn_messages_scanned: scanned, errors, founder_addresses_on_file: Object.keys(byEmail).length, affected_count: list.length, affected: list } }];"
      }
    }
