        "jsCode": "const b=$('Webhook').first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst vr=$input.first().json.valueRanges;\nfor(const t of vr){const col=(t.values||[]).map(r=>String(r[0]||'').trim());if(col[63]!=='Slice'||col.filter(x=>/^slice$/i.test(x)).length!==1){throw new Error(t.range+' row 64 is not the single Slice row');}}\nreturn [{json:{body:{valueInputOption:'RAW',data:b.data}}}];"
