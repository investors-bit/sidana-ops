      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TODAY = '2026-09-01';\nconst rows = $('Read PIPELINE').all();\nconst hit = [];\nfor (const it of rows) {\n  const r = it.json;\n  if (String(r.last_contact).trim() === TODAY) {\n    hit.push({\n      deal_id: r.deal_id,\n      startup: r.startup,\n      investor: r.investor,\n      owner: r.owner,\n      email: r.email,\n      stage_sent: r.fu3_done === 'Yes' ? 'FU3' : (r.fu2_done === 'Yes' ? 'FU2' : (r.fu1_done === 'Yes' ? 'FU1' : (r.deal_shared === 'Yes' ? 'INITIAL' : '?'))),\n      fu1_done: r.fu1_done,\n      deal_shared: r.deal_shared,\n      last_contact: r.last_contact,\n      next_due: r.next_due,\n      thread_id: r.thread_id,\n      message_id: r.message_id,\n    });\n  }\n}\nconst uniqEmails = Array.from(new Set(hit.map(h => String(h.email).trim().toLowerCase()))).filter(e => e);\nreturn [{ json: { total_rows_contacted_today: hit.length, unique_recipient_emails: uniqEmails.length, recipients: uniqEmails, rows: hit } }];"
      }
    }
