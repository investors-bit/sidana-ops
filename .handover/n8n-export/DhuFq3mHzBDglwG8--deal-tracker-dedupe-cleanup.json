    {
      "id": "525689b0-fe7b-4da7-907a-5fe55475a335",
      "name": "Dedupe List Columns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $('Read Deal Tracker').all().map(i => i.json);\n// Columns that hold comma-separated startup-name lists. Trailing/leading spaces preserved (real header names).\nconst listCols = ['Latest deal shared ', 'All Deals Shared till date', 'Picked / Interested Deals'];\nfunction normKey(s){ return String(s).toLowerCase().replace(/[^a-z0-9]+/g,''); }\nfunction dedupeList(v){\n  if (v == null) return { value: v, changed: false };\n  const parts = String(v).split(',');\n  const seen = {};\n  const out = [];\n  for (const p of parts){\n    const trimmed = p.trim();\n    if (trimmed === '') continue;\n    const k = normKey(trimmed);\n    if (!k) continue;\n    if (!seen[k]){ seen[k] = 1; out.push(trimmed); }\n  }\n  const joined = out.join(', ');\n  const changed = joined !== String(v == null ? '' : v).trim();\n  return { value: joined, changed: changed };\n}\nconst out = [];\nfor (const r of rows){\n  const name = r['Investor / VC Name'];\n  if (name == null || String(name).trim() === '') continue;\n  const payload = { 'Investor / VC Name': name };\n  let anyChanged = false;\n  for (const c of listCols){\n    const res = dedupeList(r[c]);\n    payload[c] = res.value == null ? '' : res.value;\n    if (res.changed) anyChanged = true;\n  }\n  if (anyChanged) out.push({ json: payload });\n}\nreturn out;"
      }
    },
