      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nfunction colLetter(i) { let n = i + 1, out = ''; while (n > 0) { const m = (n - 1) % 26; out = String.fromCharCode(65 + m) + out; n = Math.floor((n - 1) / 26); } return out; }\nconst ih = (($('GET INV header').first().json.values || [[]])[0] || []).map(s);\nconst ci = ih.indexOf('do_not_contact'); if (ci < 0) { throw new Error('ABORT: do_not_contact column missing'); }\nconst inv = $input.all().map(function (i) { return i.json; });\nif (inv.length < 200) { throw new Error('ABORT: INVESTORS only ' + inv.length); }\nconst rows = inv.filter(function (r) { return nz(r.investor) === 'climateangels'; });\nif (!rows.length) { throw new Error('ABORT: Climate Angels not found in INVESTORS'); }\nif (rows.length > 2) { throw new Error('ABORT: ' + rows.length + ' Climate Angels rows - check duplicates first'); }\nconst data = rows.filter(function (r) { return s(r.do_not_contact) !== ''; }).map(function (r) { return { range: 'INVESTORS!' + colLetter(ci) + r.row_number, values: [['']] }; });\nif (!data.length) { data.push({ range: 'INVESTORS!' + colLetter(ci) + '1', values: [['do_not_contact']] }); }\nreturn [{ json: { before: rows.map(function (r) { return [r.row_number, s(r.investor), s(r.contact_person), s(r.email), s(r.sector), s(r.stage), s(r.cheque_inr_cr), s(r.do_not_contact)]; }), data: data } }];"
      }
    },
