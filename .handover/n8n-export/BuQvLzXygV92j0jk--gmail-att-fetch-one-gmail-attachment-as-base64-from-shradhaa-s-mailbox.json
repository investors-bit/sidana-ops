{
  "id": "BuQvLzXygV92j0jk",
  "name": "GMAIL-ATT — fetch one Gmail attachment as base64 from Shradhaa's mailbox (webhook, one-off)",
  "description": null,
  "active": true,
  "activeVersionId": "3d0c7740-8bde-463f-bc98-43f25ba58eb9",
