      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sendAs = ($('Get Shradhaa signature').first().json.sendAs) || [];\nconst me = sendAs.find(s => String(s.sendAsEmail || '').toLowerCase() === 'shradhaa@sidanaventures.com') || sendAs.find(s => s.isDefault) || {};\nconst SIG = String(me.signature || '');\nfunction finalise(html) {\n  let h = String(html || '');\n  if (!h.includes('rakeshsidana.org\">rakeshsidana.org</a> ') && !h.includes('LinkedIn</a> | ')) {\n    h = h.replace('LinkedIn</a>)', 'LinkedIn</a> | <a href=\"https://rakeshsidana.org\">rakeshsidana.org</a>)');\n  }\n  if (!h.includes('mail-sig')) {\n    h = h.replace(/<p>Best,<br>Shradhaa<br>[\\s\\S]*?<\\/p>\\s*$/, '');\n    h = h + '<br><div>-- </div>' + SIG;\n  }\n  return h;\n}\nconst r = $('Read ONBOARDING').all().map(i => i.json).find(x => x.firm === 'PeerCapital');\nconst html = finalise(r.body_html);\nconst text = html.replace(/<br\\s*\\/?>/g, '\\n').replace(/<\\/(p|div|li|tr)>/g, '\\n').replace(/<[^>]+>/g, '').replace(/&quot;/g, '\"').replace(/\\n\\s*\\n+/g, '\\n').trim();\nif (!SIG.includes('Investor Relations') || !html.includes('mail-sig')) throw new Error('signature missing - test not sent');\nreturn [{ json: {\n  to: 'investors@sidanaventures.com',\n  subject: r.subject,\n  html: html,\n  signature_found: SIG.includes('Investor Relations'),\n  old_signoff_removed: !html.includes('<p>Best,<br>Shradhaa'),\n  signature_appended: html.includes('mail-sig'),\n  logo_url_present: html.includes('ci3.googleusercontent.com/mail-sig'),\n  founder_links: html.includes('LinkedIn</a> | <a href=\"https://rakeshsidana.org\">rakeshsidana.org</a>)'),\n  html_length: html.length,\n  last_900_chars_as_text: text.slice(-900)\n} }];"
      }
    },
