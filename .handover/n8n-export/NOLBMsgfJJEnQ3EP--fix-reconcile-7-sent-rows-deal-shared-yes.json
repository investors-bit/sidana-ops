      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst want = ['D00001','D00002','D00003','D00004','D00005','D00006','D00007'];\nconst rows = $('Read back D00001-D00007').all().map(i => i.json).filter(r => want.includes(String(r.deal_id).trim()));\nreturn rows.map(r => ({ json: {\n  deal_id: r.deal_id, deal_shared: r.deal_shared, fu1_done: r.fu1_done, fu2_done: r.fu2_done,\n  next_action: r.next_action, next_due: r.next_due, thread_id: r.thread_id, message_id: r.message_id,\n} }));\n"
