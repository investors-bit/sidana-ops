    {
      "id": "c1",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst re=/accelerator|vasu|priyanshu|finvolve|iangels/i;\nconst vr=$('GET pilot').first().json.valueRanges||[];\nconst inv=(vr[0]||{}).values||[], crit=(vr[1]||{}).values||[], pipe=(vr[2]||{}).values||[];\nconst invRows=[];inv.forEach((r,i)=>{if(r.some(c=>re.test(s(c))))invRows.push({row:i+1,cells:r.map(s)});});\nconst critRows=[];crit.forEach((r,i)=>{if(re.test(s(r[1])))critRows.push({row:i+1,cells:r.slice(0,21).map(c=>s(c).slice(0,160))});});\nconst h=(pipe[0]||[]).map(s);const X={};h.forEach((k,i)=>X[k]=i);\nconst pr=[];for(let i=1;i<pipe.length;i++){const r=pipe[i]||[];if(re.test(s(r[X.investor]))||re.test(s(r[X.email]))){pr.push([i+1,s(r[X.deal_id]),s(r[X.startup]),s(r[X.investor]),s(r[X.email]),s(r[X.cc]),s(r[X.deal_shared]),s(r[X.date_shared]),s(r[X.next_action]).slice(0,40),s(r[X.next_due]),s(r[X.pause]),s(r[X.investor_response]).slice(0,40),s(r[X.match_type]).slice(0,60)].join(' | '));}}\nconst cv=$('GET corrections').first().json.valueRanges||[];\nconst th=[];((cv[0]||{}).values||[]).forEach((r,i)=>{if(i<2||r.some(c=>re.test(s(c))))th.push({row:i+1,cells:r.map(s)});});\nconst mc=[];((cv[1]||{}).values||[]).forEach((r,i)=>{if(i<1||r.some(c=>re.test(s(c))))mc.push({row:i+1,cells:r.map(s)});});\nreturn [{json:{investors:invRows,criteria:critRows,pipeline_count:pr.length,pipeline:pr.slice(0,120),thesis_tab:th,mail_tab:mc}}];"
      }
    }
