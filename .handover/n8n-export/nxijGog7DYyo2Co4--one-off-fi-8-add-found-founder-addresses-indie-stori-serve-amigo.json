    {
      "id": "f8-plan",
      "name": "Plan additions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = (v) => String(v == null ? '' : v).trim();\nconst low = (v) => s(v).toLowerCase();\nconst norm = (x) => low(x).replace(/[^a-z0-9]/g, '');\n// ADD alongside what is already there - never replace, so a transient bounce cannot orphan a founder\nconst TARGETS = [\n  { startup: 'Indie Stori', row: 69, add: 'siddharth@indiestori.com', note: 'found on Indie Stori <> LvLUp Ventures threads (MB4/MB5); gmail address has 4 hard bounces' },\n  { startup: 'Serve Amigo', row: 113, add: 'priyanka@serveamigo.com', note: 'second founder, live on CedarHill and VC Mint threads 14-18 Sep' },\n];\nconst rows = $input.all().map((i) => i.json);\nconst cols = Object.keys(rows[0]).filter((k) => k !== 'row_number');\nconst iE = cols.indexOf('Emails');\nconst iR = cols.findIndex((c) => low(c) === 'call remark');\nif (iE < 0) throw new Error('Emails column not found');\nconst L = (i) => String.fromCharCode(65 + i);\nconst data = []; const plan = [];\nfor (const t of TARGETS) {\n  const hit = rows.filter((r) => r.row_number === t.row);\n  if (hit.length !== 1) throw new Error('row ' + t.row + ' not found');\n  const r = hit[0];\n  if (norm(r['Startup']) !== norm(t.startup)) throw new Error('row ' + t.row + ' is ' + r['Startup'] + ', expected ' + t.startup);\n  const before = s(r['Emails']);\n  const parts = before.split(/[,;\\s]+/).map(s).filter(Boolean);\n  if (parts.some((p) => low(p) === low(t.add))) { plan.push({ startup: t.startup, row: t.row, action: 'noop - already present', before }); continue; }\n  const after = parts.concat([t.add]).join(', ');\n  data.push({ range: \"'Founders Info'!\" + L(iE) + t.row, values: [[after]] });\n  if (iR >= 0) {\n    const old = s(r[cols[iR]]);\n    data.push({ range: \"'Founders Info'!\" + L(iR) + t.row, values: [[(old ? old + ' | ' : '') + 'Added ' + t.add + ' - ' + t.note + ' (25 Sep 2026).']] });\n  }\n  plan.push({ startup: t.startup, row: t.row, action: 'add', added: t.add, before, after });\n}\nreturn [{ json: { writes: data.length, plan, body: { valueInputOption: 'RAW', data } } }];"
      }
    },
