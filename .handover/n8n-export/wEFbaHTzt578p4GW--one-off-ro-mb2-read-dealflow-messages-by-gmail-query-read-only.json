        "jsCode": "const b = $('Webhook').first().json.body || {};\nif (b.secret !== 'romb2-05oct-Vq2nJ8') throw new Error('bad secret');\nif (!b.q) throw new Error('q required');\nreturn [{ json: { q: b.q, max: Math.min(+(b.max||15), 30) } }];"
