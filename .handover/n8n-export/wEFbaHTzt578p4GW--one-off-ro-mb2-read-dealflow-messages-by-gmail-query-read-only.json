    {
      "id": "o",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const dec = s => { try { return Buffer.from(String(s).replace(/-/g,'+').replace(/_/g,'/'), 'base64').toString('utf8'); } catch (e) { return ''; } };\nconst findText = p => { if (!p) return ''; if (p.mimeType === 'text/plain' && p.body && p.body.data) return dec(p.body.data); for (const c of (p.parts||[])) { const t = findText(c); if (t) return t; } if (p.mimeType === 'text/html' && p.body && p.body.data) return dec(p.body.data).replace(/<[^>]+>/g,' '); return ''; };\nconst out = [];\nfor (const it of $input.all()) { const j = it.json; if (!j.payload) { if (j.emailAddress) out.push({ mailbox: j.emailAddress, note: 'no messages matched' }); continue; } const h = {}; for (const x of (j.payload.headers||[])) h[x.name.toLowerCase()] = x.value; let body = findText(j.payload); const cut = body.search(/\\nOn .{5,80}wrote:|\\n-----Original Message|\\nFrom: .*\\nSent:/); if (cut > 0) body = body.slice(0, cut); out.push({ id: j.id, threadId: j.threadId, date: h.date, from: h.from, to: h.to, subject: h.subject, body: body.replace(/\\r/g,'').replace(/\\n{3,}/g,'\\n\\n').trim().slice(0, 1500), attachments: [] }); }\nreturn [{ json: { count: out.length, messages: out } }];"
      }
    }
