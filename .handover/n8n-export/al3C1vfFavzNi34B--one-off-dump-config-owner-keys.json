      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cfg = {};\nfor (const r of rows) {\n  const k = r.setting !== undefined ? r.setting : r.key;\n  if (k === undefined || k === null || String(k).trim() === '') continue;\n  cfg[String(k).trim()] = r.value;\n}\nconst ownerKeys = Object.keys(cfg).filter(k => /^OWNER_[A-Z]$/.test(k));\nconst derivedValidOwners = ownerKeys.map(k => String(cfg[k]).trim()).filter(Boolean);\nreturn [{ json: {\n  all_setting_keys: Object.keys(cfg),\n  owner_keys_found: ownerKeys,\n  derived_VALID_OWNERS: derivedValidOwners,\n  owner_key_count: ownerKeys.length,\n} }];"
      }
    }
