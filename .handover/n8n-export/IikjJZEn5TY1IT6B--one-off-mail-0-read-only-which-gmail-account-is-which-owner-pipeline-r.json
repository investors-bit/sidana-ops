      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst prof={};for(const n of ['Profile 2','Profile 3','Profile 4','Profile 5']){const j=$(n).first().json;prof[n]={email:j.emailAddress||'',messages:j.messagesTotal,threads:j.threadsTotal,err:j.error?String(j.error.message||j.error).slice(0,150):''};}\nconst pipe=(($('GET pipeline').first().json.valueRanges||[])[0]||{}).values||[];const h=(pipe[0]||[]).map(s);const X={};h.forEach((k,i)=>X[k]=i);\nconst byOwner={},resp={},pass={},meet={},status={};let sent=0,withThread=0,withResp=0;const firstSent={};\nfor(let i=1;i<pipe.length;i++){const r=pipe[i]||[];const g=k=>s(r[X[k]]);if(!/^yes$/i.test(g('deal_shared'))){continue;}sent++;const o=g('owner');byOwner[o]=(byOwner[o]||0)+1;if(g('thread_id')){withThread++;}\n const d=g('date_shared');if(d&&(!firstSent[o]||d<firstSent[o])){firstSent[o]=d;}\n const rp=g('investor_response');if(rp){withResp++;resp[rp.slice(0,40)]=(resp[rp.slice(0,40)]||0)+1;}\n const pr=g('pass_reason');if(pr){pass[pr.slice(0,80)]=(pass[pr.slice(0,80)]||0)+1;}\n const ms=g('meeting_scheduled');if(ms){meet[ms]=(meet[ms]||0)+1;}const st=g('deal_status');if(st){status[st]=(status[st]||0)+1;}}\nreturn [{json:{profiles:prof,sent:sent,with_thread:withThread,with_response:withResp,sent_by_owner:byOwner,first_sent_by_owner:firstSent,responses:resp,pass_reasons:pass,meeting_scheduled:meet,deal_status:status}}];"
      }
    }
