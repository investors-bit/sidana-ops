        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TARGET = 'D03010';\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst hits = rows.filter(function (r) { return String(r.deal_id == null ? '' : r.deal_id).trim() === TARGET; });\nif (hits.length !== 1) { throw new Error('ABORT: expected exactly 1 row for ' + TARGET + ', found ' + hits.length); }\nconst h = hits[0];\nif (String(h.deal_shared == null ? '' : h.deal_shared).trim().toLowerCase() === 'yes') { throw new Error('ABORT: ' + TARGET + ' has deal_shared=Yes'); }\nif (String(h.investor).trim() !== 'Kaizenvest') { throw new Error('ABORT: unexpected investor ' + h.investor); }\nif (!h.row_number) { throw new Error('ABORT: no row_number on target'); }\n\n// neighbours recorded so the deletion can be verified afterwards\nconst rn = Number(h.row_number);\nconst before = rows.filter(function (r) { return Number(r.row_number) === rn - 1; })[0] || {};\nconst after  = rows.filter(function (r) { return Number(r.row_number) === rn + 1; })[0] || {};\n\nreturn [{ json: {\n  row_number: rn,\n  deal_id: h.deal_id,\n  investor: h.investor,\n  startup: h.startup,\n  total_rows: rows.length,\n  neighbour_above: (before.deal_id || '(none)') + ' / ' + (before.investor || ''),\n  neighbour_below: (after.deal_id || '(none)') + ' / ' + (after.investor || '')\n}}];"
      }
    },
