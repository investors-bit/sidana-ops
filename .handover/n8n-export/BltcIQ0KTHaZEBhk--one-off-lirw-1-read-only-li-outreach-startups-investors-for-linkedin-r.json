    {
      "id": "bu",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('Webhook').first().json.body || {};\nif (b.secret !== 'lirw-1oct-Qv7mK2') throw new Error('bad secret');\nconst ranges = { LI_OUTREACH: \"'LI_OUTREACH'!A1:U500\", STARTUPS: \"'STARTUPS'!A1:Z200\", INVESTORS: \"'INVESTORS'!A1:Z1000\" };\nconst all = ['LI_OUTREACH','STARTUPS','INVESTORS'];\nconst want = (Array.isArray(b.want) && b.want.length) ? b.want.filter(x => all.indexOf(x) !== -1) : all;\nif (!want.length) throw new Error('no valid tab requested');\nreturn [{ json: { titles: want, body: { dataFilters: want.map(x => ({ a1Range: ranges[x] })), majorDimension: 'ROWS', valueRenderOption: 'FORMATTED_VALUE' } } }];"
      }
    },
    {
      "id": "rd",
      "name": "Read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4/values:batchGetByDataFilter",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "o",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const vr = $input.first().json.valueRanges || [];\nconst tabs = {};\nfor (const x of vr) {\n  const rng = ((x||{}).valueRange||{}).range || '';\n  const vals = ((x||{}).valueRange||{}).values || [];\n  const name = rng.split('!')[0].replace(/^'/,'').replace(/'$/,'');\n  tabs[name] = { range: rng, rows: vals.length, values: vals.map(r => (r||[]).map(c => String(c)).join(' | ')) };\n}\nreturn [{ json: { tabs } }];"
      }
    }
  ],
