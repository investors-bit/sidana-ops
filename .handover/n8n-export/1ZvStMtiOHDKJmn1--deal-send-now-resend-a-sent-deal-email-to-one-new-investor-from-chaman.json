      "id": "bd",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Check').first().json;const m=$input.first().json;\nconst H={};((m.payload||{}).headers||[]).forEach(h=>H[h.name.toLowerCase()]=h.value);\nif(!/dealflow@sidanaventures\\.com/i.test(H.from||'')){throw new Error('template not sent by Chaman');}\nfunction dec(d){return Buffer.from(String(d).replace(/-/g,'+').replace(/_/g,'/'),'base64').toString('utf8');}\nlet html='';(function walk(x){if(!x||html){return;}if(x.mimeType==='text/html'&&x.body&&x.body.data){html=dec(x.body.data);return;}(x.parts||[]).forEach(walk);})(m.payload);\nif(!html){throw new Error('no html part');}\nconst re=new RegExp('Hi\\\\s+'+p.old_name.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&')+',');const n=(html.match(new RegExp(re.source,'g'))||[]).length;if(n!==1){throw new Error('greeting found '+n+' times');}\nhtml=html.replace(re,'Hi '+p.new_name+',');\nconst subj=H.subject||'';\nconst b64=Buffer.from(html,'utf8').toString('base64').replace(/(.{76})/g,'$1\\r\\n');\nconst mime=['From: Chaman SV <dealflow@sidanaventures.com>','To: '+p.to,'Subject: =?UTF-8?B?'+Buffer.from(subj,'utf8').toString('base64')+'?=','MIME-Version: 1.0','Content-Type: text/html; charset=\"UTF-8\"','Content-Transfer-Encoding: base64','',b64].join('\\r\\n');\nconst raw=Buffer.from(mime,'utf8').toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');\nconst text=html.replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').slice(0,600);\nif(p.dry!==false){throw new Error('DRY OK | to='+p.to+' | subject='+subj+' | '+text);}\nreturn [{json:{raw,subject:subj,to:p.to}}];"
      }
    },
