        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!/^[0-9a-f]{16}$/.test(b.template_id||'')){throw new Error('bad template id');}\nif(!/^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$/i.test(b.to||'')||!b.old_name||!b.new_name){throw new Error('missing to / names');}\nreturn [{json:b}];"
      }
    },
