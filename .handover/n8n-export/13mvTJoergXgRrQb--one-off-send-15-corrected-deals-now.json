      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = {};\nfor (const it of $input.all()) {\n  const k = it.json.setting !== undefined ? it.json.setting : it.json.key;\n  if (k === undefined || k === null || String(k).trim() === '') continue;\n  cfg[String(k).trim()] = it.json.value;\n}\nif (String(cfg.GLOBAL_PAUSE || '').trim() !== '') { throw new Error('GLOBAL_PAUSE is set - aborting'); }\nreturn [{ json: cfg }];"
      }
