      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Build CONFIG object').first().json;\nconst tz = cfg.TIMEZONE || 'Asia/Kolkata';\nconst now = DateTime.now().setZone(tz);\nconst today = now.toISODate();\nconst fu1 = parseInt(cfg.FU1_DAYS, 10); const FU1 = isNaN(fu1) ? 2 : fu1;\nconst resp = $json;\nconst be = $('Build email').item.json;\nreturn { json: {\n  deal_id: be.deal_id,\n  deal_shared: 'Yes',\n  date_shared: today,\n  channel: 'Email',\n  thread_id: resp.threadId || '',\n  message_id: resp.id || '',\n  last_contact: today,\n  next_action: 'Follow-up 1',\n  next_due: now.plus({ days: FU1 }).toISODate(),\n} };"
