    {
      "id": "n7",
      "name": "Select 15 deals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TARGETS = ['D00064','D00598','D01724','D00596','D00621','D00635','D00659','D00660','D01727','D01766','D02517','D02542','D00050','D00610','D01777'];\nconst blank = (x) => String(x || '').trim() === '';\nconst yes = (x) => String(x || '').trim().toLowerCase() === 'yes';\nconst out = [];\nfor (const p of $('Read PIPELINE').all()) {\n  const id = String(p.json.deal_id || '').trim();\n  if (TARGETS.indexOf(id) === -1) { continue; }\n  if (yes(p.json.deal_shared)) { throw new Error('Row ' + id + ' is already marked shared - aborting'); }\n  if (!blank(p.json.investor_response)) { throw new Error('Row ' + id + ' has an investor_response - aborting'); }\n  if (!blank(p.json.pause)) { throw new Error('Row ' + id + ' is paused - aborting'); }\n  if (blank(p.json.email)) { throw new Error('Row ' + id + ' has no email - aborting'); }\n  out.push({ json: { deal_id: id, startup: p.json.startup, investor: p.json.investor, owner: String(p.json.owner || '').trim(), email: p.json.email, cc: p.json.cc || '', channel: p.json.channel || '', stage: 'INITIAL' } });\n}\nif (out.length !== TARGETS.length) { throw new Error('Expected ' + TARGETS.length + ' rows, found ' + out.length + ' - aborting'); }\nreturn out;"
      }
    },
    {
      "id": "n8",
      "name": "Build email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Build CONFIG object').first().json;\nconst r = $json;\nconst stage = r.stage;\n\nlet st = null;\nfor (const s of $('Read STARTUPS').all()) { if (String(s.json.startup).trim() === String(r.startup).trim()) { st = s.json; break; } }\nlet inv = null;\nfor (const v of $('Read INVESTORS').all()) { if (String(v.json.investor).trim() === String(r.investor).trim()) { inv = v.json; break; } }\nif (!st) throw new Error('Startup not found: ' + r.startup);\nif (!inv) throw new Error('Investor not found: ' + r.investor);\nif (String(inv.do_not_contact || '').trim().toLowerCase() === 'yes') { throw new Error('Investor is do_not_contact: ' + r.investor); }\n\nconst isRouting = String(r.channel || '').toUpperCase() === 'ROUTING';\nconst tid = (stage === 'INITIAL' && isRouting) ? 'INITIAL_ROUTING' : stage;\nlet tpl = null;\nfor (const t of $('Read TEMPLATES').all()) { if (String(t.json.template_id).trim() === tid) { tpl = t.json; break; } }\nif (!tpl) throw new Error('Template not found for stage ' + tid);\n\nconst senderKey = String(r.owner || '').trim();\nconst tokens = {\n  '{{InvestorName}}': inv.investor,\n  '{{ContactPerson}}': inv.contact_person,\n  '{{StartupName}}': st.startup,\n  '{{Sector}}': st.sector,\n  '{{FundraiseAmount}}': st.raise_inr_cr,\n  '{{Revenue}}': st.revenue,\n  '{{Highlight1}}': st.highlight_1,\n  '{{Highlight2}}': st.highlight_2,\n  '{{Highlight3}}': st.highlight_3,\n  '{{DeckLink}}': st.deck_link,\n  '{{SenderName}}': senderKey,\n};\nconst fill = (s) => { let o = String(s == null ? '' : s); for (const k in tokens) { o = o.split(k).join(String(tokens[k] == null ? '' : tokens[k])); } return o; };\nconst subject = fill(tpl.subject);\nconst body0 = fill(tpl.body);\nconst memoHtml = (st.memo_html == null ? '' : String(st.memo_html));\nconst body = String(body0).split('{{MemoBody}}').join('%%MEMOBODY_SLOT%%');\nif (/\\{\\{[^}]+\\}\\}/.test(subject) || /\\{\\{[^}]+\\}\\}/.test(body)) { throw new Error('Unresolved template token for deal ' + r.deal_id); }\n\nconst ownerNames = { Aditya: \"Aditya Mishra\", Chaman: \"Chaman Yadav\", Akansha: \"Akansha\", Shradha: \"Shradha\" };\nconst senderFull = ownerNames[senderKey] || senderKey;\nconst logoUrl = \"https://drive.google.com/uc?export=view&id=1iLMGooCx6B8bmYJxlYMdNg0YhdSoFAFi\";\nconst bodyHtml0 = String(body).split(String.fromCharCode(10)).join(\"<br>\");\nconst bodyHtml = bodyHtml0.split('%%MEMOBODY_SLOT%%').join(\"<div style='height:18px;'></div>\" + memoHtml + \"<div style='height:18px;'></div>\");\nconst sig = \"<br>--<br>\" + \"<img src='\" + logoUrl + \"' alt='Sidana Ventures' width='120' style='display:block;margin-bottom:8px;border:0;'>\" + \"<div style='font-family:Arial,sans-serif;font-size:13px;color:#333333;line-height:1.4;'>\" + \"<span style='font-weight:bold;color:#1a5fb4;'>\" + senderFull + \"</span><br>\" + \"Investor Relations<br>\" + \"<span style='font-weight:bold;'>SIDANA VENTURES LLP</span><br>\" + \"424A Tower B3, Spaze iTech Park, Sector 49, Sohna Road<br>\" + \"Gurgaon, Haryana 122022<br>\" + \"+91 87965 31802<br>\" + \"<a href='https://www.sidanaventures.com' style='color:#1a5fb4;'>www.sidanaventures.com</a>\" + \"</div>\";\nconst html = \"<div style='font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65;color:#222222;max-width:640px;'>\" + bodyHtml + \"</div>\" + sig;\n\nreturn { json: Object.assign({}, r, { to: r.email, cc: r.cc || '', subject, body, html }) };"
      }
    },
