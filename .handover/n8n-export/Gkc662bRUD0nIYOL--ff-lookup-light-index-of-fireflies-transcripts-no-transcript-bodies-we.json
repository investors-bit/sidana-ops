      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const g=$('Gate').first().json;const q=g.q.toLowerCase();\nconst all=$input.all().map(i=>i.json).filter(r=>r&&r.ff_id);\nif(g.ff_id){const one=all.find(r=>String(r.ff_id)===g.ff_id);if(!one){throw new Error('no such ff_id');}\n return [{json:{ff_id:one.ff_id,title:one.title,meeting_date:one.meeting_date,duration_min:one.duration_min,attendees:one.attendees,overview:one.overview,action_items:one.action_items,keywords:one.keywords,ff_url:one.ff_url,transcript:g.full?one.transcript:undefined,transcript_chars:one.transcript_chars}}];}\nlet rows=all;\nif(q){rows=all.filter(r=>((r.title||'')+' '+(r.startup_guess||'')+' '+(r.investor_guess||'')+' '+(r.attendees||'')).toLowerCase().includes(q));}\nrows.sort((a,b)=>String(b.meeting_date||'').localeCompare(String(a.meeting_date||'')));\nconst light=rows.map(r=>({ff_id:r.ff_id,date:String(r.meeting_date||'').slice(0,10),title:r.title,startup:r.startup_guess,investor:r.investor_guess,mins:r.duration_min,chars:r.transcript_chars,has_overview:!!(r.overview&&r.overview.length>10)}));\nreturn [{json:{total_in_table:all.length,matched:light.length,rows:light}}];"
      }
    }
