      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Remove the THESIS-WATCH rows written during testing. 9 of the 12 were cosmetic\n// (case/punctuation) and one was a duplicate; clearing them all lets a fixed run\n// re-create only the genuine ones.\nfunction s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 100) { throw new Error('ABORT: ERROR LOG returned only ' + rows.length + ' rows'); }\n\nconst mine = rows.filter(function (r) { return s(r.workflow) === 'THESIS-WATCH'; });\nif (mine.length === 0) { throw new Error('ABORT: no THESIS-WATCH rows found - already cleaned?'); }\nif (mine.length > 20) { throw new Error('ABORT: ' + mine.length + ' rows exceeds guard of 20'); }\nfor (const r of mine) { if (!r.row_number) { throw new Error('ABORT: missing row_number'); } }\n\nconst out = mine.map(function (r) {\n  return { json: { row_number: Number(r.row_number), investor: s(r.investor), error_type: s(r.error_type) } };\n});\nout.sort(function (a, b) { return b.json.row_number - a.json.row_number; });\nreturn out;"
      }
    },
