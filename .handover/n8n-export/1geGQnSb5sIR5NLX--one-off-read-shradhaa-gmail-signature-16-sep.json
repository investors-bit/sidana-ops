        "jsCode": "const j = $input.first().json;\nif (j.error) return [{ json: { ok: false, source: 'sendAs', error: j.error.message || JSON.stringify(j.error).slice(0, 400) } }];\nconst list = j.sendAs || [];\nreturn [{ json: { ok: true, addresses: list.map(s => ({ email: s.sendAsEmail, isDefault: !!s.isDefault, displayName: s.displayName, sig_len: (s.signature || '').length })), signature: (list.find(s => s.isDefault) || list[0] || {}).signature || '' } }];"
