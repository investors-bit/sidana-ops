      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body=$('Webhook').first().json.body||{};\nif(body.secret!=='sv-mail-2026-09-17-Kq7')throw new Error('bad secret');\nconst dry=body.dry!==false;\nconst R=$input.first().json.valueRanges||[];\nconst inv=((R[0]||{}).values)||[];\nconst g=(r,i)=>(r&&r[i]!=null)?String(r[i]).trim():'';\nconst nz=x=>String(x||'').toLowerCase().replace(/[^a-z0-9]/g,'');\nconst has=r=>r&&r.some(c=>String(c||'').trim()!=='');\nif(inv.length<250)throw new Error('ABORT: INVESTORS read only '+inv.length+' rows');\n\nconst ROW=['Iron Pillar','Ashok Ananthakrishnan','ashok@ironpillarfund.com','','B2B product: physical AI, semiconductors, energy, bio manufacturing, enterprise B2B (his words, 30 Sep 2026)','Growth (tracks companies from early stage)','INR 100 Cr minimum (no upper bound stated)','2026-09-30','Bhawna',''];\nconst KEY='ironpillar';\nconst EM='ashok@ironpillarfund.com';\nconst DOM='ironpillarfund.com';\n\nconst problems=[];\ninv.forEach((r,i)=>{if(i===0)return;const e=(g(r,2)+' '+g(r,3)).toLowerCase();\n if(e.indexOf(EM)>=0||e.indexOf('@'+DOM)>=0||nz(g(r,0)).indexOf(KEY)>=0)problems.push('already in INVESTORS row '+(i+1)+': '+g(r,0)+' / '+g(r,2));});\nif(problems.length)throw new Error('ABORT dedupe: '+problems.join('; '));\n\nlet last=0;inv.forEach((r,i)=>{if(has(r))last=i+1;});\nconst target=last+1;\nif(has(inv[target-1]))throw new Error('ABORT: INVESTORS row '+target+' is not empty');\nif(target<296||target>340)throw new Error('ABORT: target row '+target+' outside the expected 296-340 window');\n\nconst data=[{range:'INVESTORS!A'+target+':J'+target,values:[ROW]}];\nreturn [{json:{dry,lastDataRow:last,targetRow:target,row:ROW,cells:ROW.length,body:{valueInputOption:'RAW',data}}}];"
      }
