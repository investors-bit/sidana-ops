      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows = $('Read PIPELINE').all().map(i => i.json);\nconst matches = rows.filter(r => String(r.deal_id).trim() === 'TEST-ADITYA-001');\nif (matches.length === 0) throw new Error('ABORT: no TEST-ADITYA-001 row found — nothing to delete.');\nif (matches.length > 1) throw new Error('ABORT: found ' + matches.length + ' TEST-ADITYA-001 rows; refusing to delete to avoid removing the wrong one.');\nconst r = matches[0];\nif (!r.row_number) throw new Error('ABORT: matched row has no row_number.');\n// Safety: confirm it is the throwaway test row (pause held) before deleting.\nif (String(r.pause || '').indexOf('TEST-HOLD') === -1) throw new Error('ABORT: matched row does not carry the TEST-HOLD pause marker; refusing to delete.');\nreturn [{ json: { rowNumber: Number(r.row_number), deal_id: r.deal_id, startup: r.startup, investor: r.investor } }];\n"
      }
    },
