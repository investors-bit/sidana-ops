      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const incoming = [], sentReplies = [];\nfor (const it of $input.all()) { const m = it.json; if (!m.payload) continue;\n  const h = {}; for (const x of m.payload.headers || []) h[x.name.toLowerCase()] = x.value;\n  const d = new Date(Number(m.internalDate)).toLocaleString('sv-SE', { timeZone: 'Asia/Kolkata' });\n  const isSent = (m.labelIds || []).includes('SENT');\n  const line = d + ' | from ' + (h.from || '') + ' | to ' + (h.to || '') + ' | ' + (h.subject || '') + ' | ' + String(m.snippet || '').slice(0, 120);\n  if (!isSent) incoming.push(line); else if (/^re:/i.test(h.subject || '')) sentReplies.push(line); }\nincoming.sort().reverse(); sentReplies.sort().reverse();\nreturn [{ json: { incoming_replies: incoming.length, incoming, shradha_replies_in_threads: sentReplies } }];"
      }
    }
