        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst sel=$('Select slice').all().map(i=>i.json);const selBy={};sel.forEach(x=>selBy[x.thread_id]=x);\nconst vr=$('GET pilot mine').first().json.valueRanges||[];const inv=(vr[0]||{}).values||[];const pipe=(vr[1]||{}).values||[];\nconst h=(pipe[0]||[]).map(s);const X={};h.forEach((k,i)=>X[k]=i);const dealBy={};for(let i=1;i<pipe.length;i++){const r=pipe[i]||[];const id=s(r[X.deal_id]);if(id){dealBy[id]={startup:s(r[X.startup]),investor:s(r[X.investor])};}}\nconst domInv={};for(let i=1;i<inv.length;i++){const r=inv[i]||[];(s(r[2])+','+s(r[3])).toLowerCase().split(/[,;\\s]+/).forEach(function(e){const m=e.match(/@([a-z0-9.-]+)$/);if(m&&!/gmail|yahoo|outlook|hotmail|icloud|rediff/.test(m[1])){domInv[m[1]]=domInv[m[1]]||s(r[0]);}if(/@/.test(e)){domInv[e]=domInv[e]||s(r[0]);}});}\nfunction hdr(p,n){const x=((p&&p.headers)||[]).find(y=>y.name.toLowerCase()===n);return x?x.value:'';}\nfunction b64(d){try{return Buffer.from(String(d).replace(/-/g,'+').replace(/_/g,'/'),'base64').toString('utf8');}catch(e){return '';}}\nfunction find(p,type){if(!p){return '';}if(p.mimeType===type&&p.body&&p.body.data){return b64(p.body.data);}for(const c of (p.parts||[])){const t=find(c,type);if(t){return t;}}return '';}\nfunction strip(html){return html.replace(/<style[\\s\\S]*?<\\/style>/gi,' ').replace(/<br\\s*\\/?>/gi,'\\n').replace(/<\\/(p|div|tr|li)>/gi,'\\n').replace(/<blockquote[\\s\\S]*$/i,'').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&#39;/g,\"'\").replace(/&quot;/g,'\"');}\nfunction clean(t){t=String(t||'').replace(/\\r/g,'');const cuts=[/\\n\\s*On [^\\n]{0,250}(\\n[^\\n]{0,120})?wrote:/i,/\\n\\s*-{2,}\\s*Original Message/i,/\\n\\s*From:\\s[^\\n]*\\n\\s*(Sent|Date):/i,/\\n\\s*-{5,}\\s*Forwarded message/i,/\\n\\s*_{10,}/];let cut=t.length;cuts.forEach(function(re){const m=t.match(re);if(m&&m.index<cut&&m.index>0){cut=m.index;}});t=t.slice(0,cut);return t.split('\\n').filter(l=>!/^\\s*>/.test(l)).join('\\n').replace(/[ \\t]+/g,' ').replace(/\\n{3,}/g,'\\n\\n').trim();}\nconst rows=[];let threads=0,errors=0;\nfor(const it of $input.all()){const j=it.json;if(!j.messages){errors++;continue;}threads++;const meta=selBy[j.id]||{};const ids=s(meta.deal_ids).split(',').filter(Boolean);const d0=dealBy[ids[0]]||{};\n  let invName=d0.investor||'';\n  (j.messages||[]).forEach(function(m,k){const p=m.payload||{};const from=hdr(p,'from');const ours=/@sidanaventures\\.com/i.test(from);\n    if(!invName&&!ours){const em=(from.match(/[\\w.+-]+@([\\w-]+\\.)+[\\w-]+/)||[''])[0].toLowerCase();const dm=em.split('@')[1]||'';invName=domInv[em]||domInv[dm]||'';}\n    let txt=find(p,'text/plain');if(!txt){txt=strip(find(p,'text/html'));}txt=clean(txt);\n    rows.push([meta.mb||'',j.id,meta.kind||'',ids.join(','),d0.startup||'',invName,String(k),new Date(Number(m.internalDate||0)).toISOString().slice(0,16),from.slice(0,150),hdr(p,'to').slice(0,200),hdr(p,'subject').slice(0,200),ours?'Y':'N',ours?txt.slice(0,500):txt.slice(0,4000),(m.labelIds||[]).join(' ').slice(0,80)]);});}\nreturn [{json:{threads:threads,errors:errors,rows:rows.length,values:rows}}];"
