      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst body=$('Webhook sync').first().json.body||{};\nif(body.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst mode=s(body.mode);const MB={'2':0,'3':1,'4':2,'5':3};\nif(mode==='init'){return [{json:{route:4}}];}\nif(mode==='status'){return [{json:{route:5}}];}\nif(mode!=='index'||MB[s(body.mb)]===undefined){throw new Error('mode must be init|status|index with mb 2-5');}\nconst vr=$('GET pilot sync').first().json.valueRanges||[];const inv=(vr[0]||{}).values||[];\nconst GENERIC=/^(gmail|googlemail|yahoo|outlook|hotmail|icloud|live|rediffmail|protonmail|aol|me|ymail)\\./i;\nconst terms={};\nfor(let i=1;i<inv.length;i++){const r=inv[i]||[];(s(r[2])+','+s(r[3])).toLowerCase().split(/[,;\\s]+/).forEach(function(e){const m=e.match(/^[^@\\s]+@([a-z0-9.-]+\\.[a-z]{2,})$/);if(!m){return;}const d=m[1];if(/sidanaventures\\.com$/.test(d)){return;}terms[GENERIC.test(d)?e:('@'+d)]=true;});}\nconst list=Object.keys(terms).sort();const out=[];\nfor(let i=0;i<list.length;i+=20){out.push({json:{route:MB[s(body.mb)],mb:s(body.mb),q:'from:('+list.slice(i,i+20).join(' OR ')+')'}});}\nreturn out;"
      }
    },
