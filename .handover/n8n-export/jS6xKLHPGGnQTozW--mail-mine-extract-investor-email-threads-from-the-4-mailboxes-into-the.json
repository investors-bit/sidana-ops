    {
      "id": "bi1",
      "name": "Build index",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst body=$('Webhook sync').first().json.body||{};const mb=s(body.mb);\nconst OWNER={'2':'Chaman','3':'Aditya','4':'Akansha','5':'Shradha'};\nconst found={};let pages=0;\n$input.all().forEach(function(it){pages++;(it.json.threads||[]).forEach(function(t){found[t.id]=true;});});\nconst vr=$('GET pilot sync').first().json.valueRanges||[];const pipe=(vr[1]||{}).values||[];const h=(pipe[0]||[]).map(s);const X={};h.forEach((k,i)=>X[k]=i);\nconst pilot={};for(let i=1;i<pipe.length;i++){const r=pipe[i]||[];if(s(r[X.owner])!==OWNER[mb]){continue;}const t=s(r[X.thread_id]);if(!t){continue;}(pilot[t]=pilot[t]||[]).push(s(r[X.deal_id]));}\nconst rows=[];const all=Object.assign({},found);Object.keys(pilot).forEach(t=>all[t]=true);\nObject.keys(all).forEach(function(t){rows.push([mb,t,pilot[t]?'pilot':'history',(pilot[t]||[]).join(','),found[t]?'Y':'N']);});\nif(!rows.length){return [{json:{mb:mb,rows:0,pages:pages}}];}\nreturn [{json:{mb:mb,rows:rows.length,pages:pages,query_threads:Object.keys(found).length,pilot_threads:Object.keys(pilot).length,values:rows}}];"
      }
    },
