      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const vr=$('Status counts').first().json.valueRanges||[];const idx=((vr[0]||{}).values||[]).slice(1);const mm=((vr[1]||{}).values||[]).slice(1);\nconst im={};idx.forEach(r=>{im[r[0]]=(im[r[0]]||0)+1;});const mt={};const tset={};mm.forEach(r=>{mt[r[0]]=(mt[r[0]]||0)+1;tset[r[0]+'|'+r[1]]=1;});\nconst tm={};Object.keys(tset).forEach(k=>{const m=k.split('|')[0];tm[m]=(tm[m]||0)+1;});\nreturn [{json:{index_threads_by_mb:im,mine_messages_by_mb:mt,mine_threads_by_mb:tm}}];"
      }
