        672,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inv = [];\nfor (const v of $('Read INVESTORS').all()) {\n  const n = String(v.json.investor || '').trim();\n  if (/tvs capital|climate angels|flipkart|m venture/i.test(n)) {\n    inv.push({ row: v.json.row_number, investor: n, contact: v.json.contact_person, email: v.json.email, dnc: v.json.do_not_contact });\n  }\n}\n\nconst pick = (p) => ({ row: p.row_number, deal_id: p.deal_id, startup: p.startup, owner: p.owner, investor: p.investor, email: p.email, shared: p.deal_shared, date_shared: p.date_shared, next_action: p.next_action, next_due: p.next_due, resp: p.investor_response, thread: p.thread_id });\n\nconst tvs = [], climate = [], flip = [], mv = [];\nfor (const p of $('Read PIPELINE').all()) {\n  const n = String(p.json.investor || '').trim();\n  if (/tvs capital/i.test(n)) { tvs.push(pick(p.json)); }\n  if (/climate angels/i.test(n)) { climate.push(pick(p.json)); }\n  if (/flipkart/i.test(n)) { flip.push(pick(p.json)); }\n  if (/m venture/i.test(n)) { mv.push(pick(p.json)); }\n}\n\nreturn [{ json: {\n  investors_rows: inv,\n  tvs_count: tvs.length, tvs_rows: tvs,\n  climate_count: climate.length, climate_rows: climate,\n  flipkart_count: flip.length, flipkart_rows: flip,\n  mventures_count: mv.length, mventures_rows: mv,\n} }];"
      }
    }
