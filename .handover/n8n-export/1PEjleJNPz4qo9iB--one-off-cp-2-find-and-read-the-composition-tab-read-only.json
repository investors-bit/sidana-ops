      "name": "Collect",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const picks = $('Pick composition tab').all().map(function (i) { return i.json; });\nconst vals = $input.all().map(function (i) { return i.json; });\nconst p = ($('GET pilot tabs').first().json.sheets || []).map(function (x) { return x.properties.title + ' (' + ((x.properties.gridProperties || {}).rowCount || '?') + ' rows)'; });\nconst c = ($('GET corrections tabs').first().json.sheets || []).map(function (x) { return x.properties.title; });\nconst iv = $('GET INVESTORS names').first().json.values || [];\nreturn [{ json: { investors_header: iv[0] || [], investors: iv.slice(1), pilot_tabs: p, corrections_tabs: c, found: picks.map(function (k, i) { return { book: k.book, tab: k.tab, rows: ((vals[i] || {}).values || []).length, values: (vals[i] || {}).values || [] }; }) } }];"
      }
