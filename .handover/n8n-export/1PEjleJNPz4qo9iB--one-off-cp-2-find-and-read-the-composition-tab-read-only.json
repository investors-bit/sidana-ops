    {
      "id": "cf",
      "name": "Pick composition tab",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = ($('GET pilot tabs').first().json.sheets || []).map(function (x) { return x.properties; });\nconst c = ($('GET corrections tabs').first().json.sheets || []).map(function (x) { return x.properties; });\nconst out = [];\nfor (const t of p) { if (/compos/i.test(t.title)) { out.push({ json: { book: 'pilot', id: '1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4', tab: t.title } }); } }\nfor (const t of c) { if (/compos/i.test(t.title)) { out.push({ json: { book: 'corrections', id: '1WOErvuYawblG-HkrK5In5YWtEiKKt_DeoVpmL5na6GU', tab: t.title } }); } }\nif (!out.length) { out.push({ json: { book: 'none', id: '', tab: '' } }); }\nreturn out;"
      }
    },
