    {
      "id": "o",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Prep').first().json;const first=$input.first().json||{};if(first.meta){return [{json:{mode:'count',mb:first.mb,dir:p.dir,ids:first.ids,estimate:first.estimate,nextPageToken:first.nextPageToken}}];}\nconst RX=/[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/g;\nconst seen={};let n=0;\nfor(const it of $input.all()){const m=it.json||{};if(!m.payload){continue;}n++;const H={};(m.payload.headers||[]).forEach(h=>H[String(h.name).toLowerCase()]=h.value);const ts=Number(m.internalDate||0);const subj=String(H.subject||'').slice(0,70);const line=(p.dir==='in')?String(H.from||''):[H.to,H.cc,H.bcc].filter(Boolean).join(', ');const hits=String(line).match(RX)||[];for(const raw of hits){const a=raw.toLowerCase();if(/@sidanaventures\\.com$/.test(a)){continue;}if(!seen[a]){seen[a]={a:a,n:0,first:ts,last:ts,subj:subj};}const s=seen[a];s.n++;if(ts<s.first){s.first=ts;}if(ts>s.last){s.last=ts;s.subj=subj;}}}\nconst npt=$('Split').first().json.nextPageToken||'';\nconst rows=Object.values(seen).sort((x,y)=>y.last-x.last);\nreturn [{json:{mode:'fetch',mb:p.mb,dir:p.dir,messages_scanned:n,distinct_addresses:rows.length,nextPageToken:npt,rows:rows}}];"
      }
    },
