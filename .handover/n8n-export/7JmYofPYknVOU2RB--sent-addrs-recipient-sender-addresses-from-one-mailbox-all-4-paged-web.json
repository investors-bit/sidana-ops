      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}const mb=String(b.mb);if(['2','3','4','5'].indexOf(mb)<0){throw new Error('mb must be 2,3,4 or 5');}const dir=(b.dir==='in')?'in':'sent';return [{json:{mb:mb,dir:dir,q:String(b.q||''),pageToken:String(b.pageToken||''),countOnly:!!b.countOnly}}];"
