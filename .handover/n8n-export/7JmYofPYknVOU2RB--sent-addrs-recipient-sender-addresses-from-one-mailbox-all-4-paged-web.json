        "jsCode": "const p=$('Prep').first().json;const r=$input.first().json;const ids=(r.messages||[]);const npt=r.nextPageToken||'';if(p.countOnly||!ids.length){return [{json:{meta:true,mb:p.mb,ids:ids.length,estimate:r.resultSizeEstimate||0,nextPageToken:npt}}];}return ids.map(x=>({json:{id:x.id,mb:p.mb,nextPageToken:npt}}));"
