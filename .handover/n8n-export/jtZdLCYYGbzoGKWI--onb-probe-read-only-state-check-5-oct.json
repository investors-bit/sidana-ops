      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body||{};\nconst vr=$json.valueRanges||[];\nconst map={};\nfor(const v of vr){const x=v.valueRange||v;map[x.range||'(none)']=x.values||[];}\nif(!b.project) return [{json:map}];\nconst find=p=>{const k=Object.keys(map).find(r=>r.replace(/'/g,'').indexOf(p)===0);return k?map[k]:[];};\nconst cols={};\nfor(const [label,pref] of Object.entries(b.project.cols)) cols[label]=find(pref);\nconst res=(b.project.rows||[]).map(r=>{const o={row:r};for(const [label,arr] of Object.entries(cols)) o[label]=((arr[r-1]||[])[0]||'');return o;});\nreturn [{json:{rows:res}}];"
      }
    }
