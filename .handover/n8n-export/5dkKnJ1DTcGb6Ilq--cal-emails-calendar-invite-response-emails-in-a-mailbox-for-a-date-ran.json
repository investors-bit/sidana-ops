      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows=$input.all().map(i=>i.json).filter(j=>j.payload).map(j=>{const h=(j.payload.headers||[]);const g=n=>((h.find(x=>x.name===n)||{}).value||'');return {id:j.id,thread:j.threadId,date:new Date(Number(j.internalDate)).toISOString().slice(0,16),from:g('From').slice(0,80),to:g('To').slice(0,300),subject:g('Subject').slice(0,250),snippet:String(j.snippet||'').slice(0,200),labels:(j.labelIds||[]).join(' ')};});\nreturn [{json:{mb:$('Query').first().json.mb,count:rows.length,more_than_500:$('Ids').first().json.more||false,rows:rows}}];"
      }
    }
