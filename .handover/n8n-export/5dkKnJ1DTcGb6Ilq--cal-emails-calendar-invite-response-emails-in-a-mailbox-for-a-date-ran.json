      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst mb=String(b.mb);if(['2','3','4','5'].indexOf(mb)<0){throw new Error('mb 2-5');}\nconst q=(b.after?'after:'+b.after+' ':'')+'(subject:(Invitation OR \"Updated invitation\" OR Accepted OR Declined OR \"Tentatively accepted\" OR Canceled OR Cancelled OR Rescheduled OR \"New Event\") OR filename:ics OR calendly OR \"meet.google.com\" OR \"zoom.us/j\")';\nreturn [{json:{mb:mb,route:['2','3','4','5'].indexOf(mb),q:q}}];"
      }
