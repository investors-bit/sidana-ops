      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction colLetter(i) { let n = i + 1, out = ''; while (n > 0) { const m = (n - 1) % 26; out = String.fromCharCode(65 + m) + out; n = Math.floor((n - 1) / 26); } return out; }\nconst hdr = (($('GET header').first().json.values || [[]])[0] || []).map(s);\nconst P = {}; for (const h of ['pause', 'next_action', 'match_type', 'notes']) { const i = hdr.indexOf(h); if (i < 0) { throw new Error('ABORT: column missing ' + h); } P[h] = colLetter(i); }\nconst t = $('Plan rewrite').first().json.targets;\nconst mid = $input.all().map(function (i) { return i.json; });\nconst byRow = {}; let maxN = 0;\nfor (const p of mid) { byRow[p.row_number] = p; const id = s(p.deal_id); if (id.charAt(0) === 'D') { const v = parseInt(id.slice(1), 10); if (!isNaN(v) && v > maxN) { maxN = v; } } }\nconst held = [], stillBlank = [];\nfor (const x of t) { const p = byRow[x.row]; if (!p || s(p.deal_id) !== x.deal_id) { throw new Error('ABORT: row ' + x.row + ' no longer holds ' + x.deal_id); }\n  if (s(p.email) === x.email) { held.push(x.deal_id); } else { stillBlank.push({ x: x, p: p }); } }\nconst data = [], newRows = []; let n = maxN;\nfor (const y of stillBlank) { const p = y.p, rn = p.row_number; n++; let pad = String(n); while (pad.length < 5) { pad = '0' + pad; } const nid = 'D' + pad;\n  const nt = s(p.notes);\n  data.push({ range: 'PIPELINE!' + P.pause + rn, values: [['Yes']] }, { range: 'PIPELINE!' + P.next_action + rn, values: [['DROPPED - replaced by ' + nid + ' (email would not save)']] },\n    { range: 'PIPELINE!' + P.notes + rn, values: [[(nt ? nt + ' | ' : '') + 'REPLACED 2026-09-11 by ' + nid + ' - email cell kept clearing']] });\n  newRows.push({ deal_id: nid, startup: s(p.startup), owner: s(p.owner), investor: s(p.investor), email: y.x.email, cc: s(p.cc) || y.x.cc, match_type: s(p.match_type),\n    deal_shared: 'No', next_action: 'Initial', next_due: s(p.next_due), notes: 'REPLACEMENT for ' + s(p.deal_id) + ' (email fix 11 Sep) | ' + (s(p.match_type) === 'Exact match' ? 'Strict match' : 'Meeting-push: stage one step off') });\n}\nif (newRows.length > 80) { throw new Error('ABORT: too many replacements ' + newRows.length); }\nif (!data.length) { data.push({ range: 'PIPELINE!' + P.pause + '1', values: [['pause']] }); }\nreturn [{ json: { targets: t.length, email_held_on_rewrite: held, replaced: newRows.map(function (r) { return r.deal_id + ' <- ' + r.notes.split(' ')[2]; }), data: data, newRows: newRows, rows_before: mid.length } }];"
