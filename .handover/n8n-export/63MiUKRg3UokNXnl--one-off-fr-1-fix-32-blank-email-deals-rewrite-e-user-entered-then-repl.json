        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nfunction colLetter(i) { let n = i + 1, out = ''; while (n > 0) { const m = (n - 1) % 26; out = String.fromCharCode(65 + m) + out; n = Math.floor((n - 1) / 26); } return out; }\nconst hdr = (($('GET header').first().json.values || [[]])[0] || []).map(s);\nconst iE = hdr.indexOf('email'); if (iE < 0) { throw new Error('ABORT: email column missing'); }\nconst LE = colLetter(iE);\nconst invRaw = $('Read INVESTORS').all().map(function (i) { return i.json; });\nconst pipe = $input.all().map(function (i) { return i.json; });\nif (pipe.length < 4000) { throw new Error('ABORT: PIPELINE only ' + pipe.length); }\nconst inv = {}; for (const r of invRaw) { const k = nz(r.investor); if (!k) { continue; } const x = inv[k] || (inv[k] = { email: '', cc: '', dnc: false });\n  if (!x.email && s(r.email)) { x.email = s(r.email); x.cc = s(r.cc); } if (s(r.do_not_contact).toLowerCase() === 'yes') { x.dnc = true; } }\nconst targets = [], data = [];\nfor (const p of pipe) {\n  if (s(p.deal_shared).toLowerCase() === 'yes' || s(p.pause).toLowerCase() === 'yes' || s(p.email)) { continue; }\n  const b = inv[nz(p.investor)]; if (!b || !b.email || b.dnc) { continue; }\n  if (!p.row_number) { throw new Error('ABORT: row without row_number'); }\n  targets.push({ row: p.row_number, deal_id: s(p.deal_id), email: b.email, cc: b.cc });\n  data.push({ range: 'PIPELINE!' + LE + p.row_number, values: [[b.email]] });\n}\nif (targets.length > 80) { throw new Error('ABORT: ' + targets.length + ' blank-email rows exceeds guard'); }\nif (!data.length) { data.push({ range: 'PIPELINE!' + LE + '1', values: [['email']] }); }\nreturn [{ json: { email_col: LE, targets: targets, data: data } }];"
      }
    },
