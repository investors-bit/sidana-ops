        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst plan = $('Plan replace').first().json;\nconst after = $input.all().map(function (i) { return i.json; });\nconst ids = {}; for (const p of after) { ids[s(p.deal_id)] = p; }\nconst newBad = plan.newRows.filter(function (r) { const p = ids[r.deal_id]; return !p || s(p.email) !== r.email || s(p.pause) !== ''; }).map(function (r) { return r.deal_id; });\nconst heldLost = plan.email_held_on_rewrite.filter(function (id) { const p = ids[id]; return !p || !s(p.email); });\nconst activeBlank = after.filter(function (p) { return s(p.deal_shared).toLowerCase() !== 'yes' && s(p.pause).toLowerCase() !== 'yes' && !s(p.email); }).map(function (p) { return s(p.deal_id) + ' ' + s(p.investor); });\nreturn [{ json: { targets: plan.targets, held_on_rewrite: plan.email_held_on_rewrite.length, replaced: plan.newRows.length, replacements_missing_or_blank: newBad, held_then_lost: heldLost,\n  rows_after: after.length, expected_rows: plan.rows_before + plan.newRows.length, active_rows_blank_email: activeBlank, ok: newBad.length === 0 && heldLost.length === 0 && after.length === plan.rows_before + plan.newRows.length } }];"
