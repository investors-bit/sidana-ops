    {
      "id": "fi2-find",
      "name": "Find Pixelence row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NEW = 'anton.kunnel@gmail.com';\nconst BAD = 'ceo@orbislives.com';\nconst REMARK = 'Do not use ' + BAD + ' - hard bounce (Delivery Status Notification Failure, 24 Sep 2026; delays from 25 Aug). Correct founder address: ' + NEW;\nconst norm = (x) => String(x == null ? '' : x).toLowerCase().replace(/[^a-z0-9]/g, '');\nconst rows = $input.all().map((i) => i.json);\nconst hits = rows.filter((r) => norm(r['Startup']) === 'orbislives');\nif (hits.length !== 1) throw new Error('Expected exactly one Orbis Lives row, found ' + hits.length);\nconst h = hits[0];\nif (norm(h['Startup']).indexOf('roadathena') >= 0) throw new Error('refusing: matched Road Athena');\nconst cols = Object.keys(rows[0]).filter((k) => k !== 'row_number');\nconst iE = cols.indexOf('Emails');\nconst iR = cols.findIndex((c) => String(c).toLowerCase().trim() === 'call remark');\nif (iE < 0) throw new Error('Emails column not found: ' + JSON.stringify(cols));\nconst old = String(h['Emails'] || '').trim();\nconst L = (i) => String.fromCharCode(65 + i);\nconst data = [{ range: \"'Founders Info'!\" + L(iE) + h.row_number, values: [[NEW]] }];\nif (iR >= 0) data.push({ range: \"'Founders Info'!\" + L(iR) + h.row_number, values: [[REMARK]] });\nreturn [{ json: { action: old.toLowerCase() === NEW ? 'noop' : 'update', row_number: h.row_number, startup: h['Startup'], founder: h['Founder Name'], old_email: old, new_email: NEW, remark_written: iR >= 0, body: { valueInputOption: 'RAW', data } } }];"
      }
    },
