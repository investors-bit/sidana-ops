    {
      "id": "8a02fb7c-56fd-4de9-96c7-b509e0261c20",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pipeline = $('Read PIPELINE').all().map(i => i.json);\nconst cfgRows = $('Read CONFIG').all().map(i => i.json);\nconst cfg = {};\nfor (const r of cfgRows) { if (r.key !== undefined && String(r.key).trim() !== '') cfg[String(r.key).trim()] = r.value; }\n\nconst rows = pipeline.map(r => ({\n  deal_id: r.deal_id,\n  owner: r.owner,\n  email: r.email,\n  startup: r.startup,\n  investor: r.investor,\n  next_due: r.next_due,\n  deal_shared: r.deal_shared,\n}));\n\nconst emails = [...new Set(pipeline.map(r => String(r.email || '').trim()))];\nconst owners = [...new Set(pipeline.map(r => String(r.owner || '').trim()))];\n\nreturn [{ json: {\n  pipeline_row_count: pipeline.length,\n  deal_ids: pipeline.map(r => r.deal_id),\n  distinct_owners: owners,\n  distinct_emails: emails,\n  CONFIG_GLOBAL_PAUSE: cfg.GLOBAL_PAUSE,\n  CONFIG_ROTATE_BY_SEND_DAY: cfg.ROTATE_BY_SEND_DAY,\n  CONFIG_INVESTOR_LOCK_DAYS: cfg.INVESTOR_LOCK_DAYS,\n  PLT_008_next_due: (pipeline.find(r => String(r.deal_id).trim() === 'PLT-008') || {}).next_due,\n  rows,\n} }];"
      }
    }
