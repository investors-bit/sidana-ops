    {
      "id": "wh",
      "name": "Webhook",
      "webhookId": "d7269718-5a28-4199-9d92-163a57295d1d",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sidana-sheet-create-7d2f4b9e13",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson",
        "options": {}
      }
    },
    {
      "id": "prep",
      "name": "Prep create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!b.title||!Array.isArray(b.sheets)||!b.sheets.length){throw new Error('need title + sheets[]');}\nconst sheets=b.sheets.map((s,i)=>({properties:{title:String(s.name),index:i,gridProperties:{frozenRowCount:s.freeze===false?0:1}}}));\nreturn [{json:{body:{properties:{title:String(b.title)},sheets:sheets},_share:b.share!==false}}];"
      }
    },
    {
      "id": "create",
      "name": "Create spreadsheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "prepvals",
      "name": "Prep values",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body;const sp=$input.first().json;\nconst data=b.sheets.map(s=>({range:\"'\"+String(s.name).replace(/'/g,\"''\")+\"'!A1\",values:s.values}));\nreturn [{json:{spreadsheetId:sp.spreadsheetId,spreadsheetUrl:sp.spreadsheetUrl,body:{valueInputOption:'RAW',data:data}}}];"
      }
    },
    {
      "id": "write",
      "name": "Write values",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.spreadsheetId }}/values:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "perm",
      "name": "Set anyone with link viewer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $('Prep values').first().json.spreadsheetId }}/permissions?supportsAllDrives=true",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({role:'reader',type:'anyone'}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "out",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pv=$('Prep values').first().json;const p=$input.first().json||{};\nreturn [{json:{spreadsheetId:pv.spreadsheetId,url:pv.spreadsheetUrl,permission:p.id?('ok: '+p.type+'/'+p.role):('NOT SET - '+JSON.stringify(p).slice(0,300))}}];"
      }
    }
  ],
