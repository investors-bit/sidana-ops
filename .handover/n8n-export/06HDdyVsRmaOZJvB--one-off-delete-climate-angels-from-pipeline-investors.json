    {
      "id": "n4",
      "name": "Build delete requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $input.first().json;\nconst gid = {};\nfor (const s of (meta.sheets || [])) { gid[String(s.properties.title).trim()] = s.properties.sheetId; }\nif (gid['PIPELINE'] === undefined) { throw new Error('PIPELINE tab not found'); }\nif (gid['INVESTORS'] === undefined) { throw new Error('INVESTORS tab not found'); }\n\nconst hit = (s) => /climate\\s*angels/i.test(String(s || ''));\n\nconst pipeRows = [];\nfor (const p of $('Read PIPELINE').all()) { if (hit(p.json.investor)) { pipeRows.push(Number(p.json.row_number)); } }\nconst invRows = [];\nfor (const v of $('Read INVESTORS').all()) { if (hit(v.json.investor)) { invRows.push(Number(v.json.row_number)); } }\n\nif (pipeRows.length === 0 && invRows.length === 0) { throw new Error('No Climate Angels rows found - aborting'); }\nif (pipeRows.length > 20) { throw new Error('Sanity check: refusing to delete ' + pipeRows.length + ' PIPELINE rows'); }\nif (invRows.length > 3) { throw new Error('Sanity check: refusing to delete ' + invRows.length + ' INVESTORS rows'); }\nfor (const r of pipeRows.concat(invRows)) { if (!(r > 1)) { throw new Error('Bad row number ' + r + ' - aborting'); } }\n\npipeRows.sort((a, b) => b - a);\ninvRows.sort((a, b) => b - a);\n\nconst reqs = [];\nfor (const r of pipeRows) { reqs.push({ deleteDimension: { range: { sheetId: gid['PIPELINE'], dimension: 'ROWS', startIndex: r - 1, endIndex: r } } }); }\nfor (const r of invRows) { reqs.push({ deleteDimension: { range: { sheetId: gid['INVESTORS'], dimension: 'ROWS', startIndex: r - 1, endIndex: r } } }); }\n\nreturn [{ json: { pipeline_deleted: pipeRows.length, investors_deleted: invRows.length, pipeline_rows: pipeRows, investors_rows: invRows, body: { requests: reqs } } }];"
      }
    },
