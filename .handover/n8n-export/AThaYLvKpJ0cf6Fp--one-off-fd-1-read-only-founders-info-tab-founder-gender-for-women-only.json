        "jsCode": "const f = $('GET Founders Info').first().json.values || [];\nconst st = $('GET STARTUPS names').first().json.values || [];\nconst sh = st[0] || []; const iS = sh.indexOf('startup'), iA = sh.indexOf('active');\nconst active = st.slice(1).filter(function (r) { return String(r[iA] || '').trim().toLowerCase() === 'yes'; }).map(function (r) { return String(r[iS] || '').trim(); });\nreturn [{ json: { founders_rows: f.length, founders_header: f[0] || [], founders: f.slice(0, 400), active_startups: active } }];"
