      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nfunction colLetter(i) { let n = i + 1, out = ''; while (n > 0) { const m = (n - 1) % 26; out = String.fromCharCode(65 + m) + out; n = Math.floor((n - 1) / 26); } return out; }\nconst h = (($('GET INV header').first().json.values || [[]])[0] || []).map(s);\nconst i = h.indexOf('sector'); if (i < 0) { throw new Error('ABORT: sector column missing'); }\nconst inv = $input.all().map(function (x) { return x.json; });\nif (inv.length < 200) { throw new Error('ABORT: INVESTORS only ' + inv.length); }\nconst rs = inv.filter(function (r) { return nz(r.investor) === 'eximiusventures'; });\nif (rs.length !== 1) { throw new Error('ABORT: Eximius resolves to ' + rs.length + ' rows'); }\nconst want = 'AI, Consumer, EdTech, FinTech, HRTech, SaaS';\nreturn [{ json: { row: rs[0].row_number, was: s(rs[0].sector), now: want, data: [{ range: 'INVESTORS!' + colLetter(i) + rs[0].row_number, values: [[want]] }] } }];"
      }
