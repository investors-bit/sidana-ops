        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The 6 already-sent Deal Tracker duplicates with NO investor reply.\n// D02527 is deliberately excluded - that investor replied (\"Already connected with founder\").\nconst TARGETS = ['D00021','D00664','D01709','D01774','D02484','D02511'];\nfunction s(v) { return String(v == null ? '' : v).trim(); }\n\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst out = [];\nfor (const t of TARGETS) {\n  const hits = rows.filter(function (r) { return s(r.deal_id) === t; });\n  if (hits.length !== 1) { throw new Error('ABORT: expected 1 row for ' + t + ', found ' + hits.length); }\n  const h = hits[0];\n  if (s(h.deal_shared).toLowerCase() !== 'yes') { throw new Error('ABORT: ' + t + ' is not deal_shared=Yes'); }\n  if (s(h.investor_response) !== '') { throw new Error('ABORT: ' + t + ' has an investor_response - leave it alone'); }\n  if (s(h.pause) !== '') { continue; }\n  const prev = s(h.notes);\n  out.push({ json: {\n    deal_id: t,\n    pause: 'Yes',\n    next_action: 'Stopped - duplicate of Deal Tracker share',\n    notes: (prev ? prev + ' | ' : '') + 'Follow-ups stopped 2026-09-07: deal already shared per Deal Tracker'\n  }});\n}\n\nif (out.length === 0) { throw new Error('ABORT: nothing to pause'); }\nif (out.length > 6) { throw new Error('ABORT: ' + out.length + ' exceeds guard of 6'); }\nreturn out;"
      }
    },
