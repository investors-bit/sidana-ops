    {
      "id": "wh",
      "name": "Webhook",
      "webhookId": "c887ffc7-8271-4bb3-9569-2887203c0d47",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onb-fu-merge-4e9c21",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson",
        "options": {}
      }
    },
    {
      "id": "pr",
      "name": "Prep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};\nif(b.secret!=='onb-fu-2026-09-30-Rz4'){throw new Error('bad secret');}\nconst SHEET=38341156;\nconst mode=String(b.mode||'list');\nif(mode==='list'){return [{json:{mode:'list',doUnmerge:false}}];}\nif(mode!=='unmerge'){throw new Error('mode must be list or unmerge');}\nconst rs=Array.isArray(b.ranges)?b.ranges:[];\nif(!rs.length){throw new Error('no ranges');}\nif(rs.length>300){throw new Error('too many ranges: '+rs.length);}\nconst reqs=[];\nfor(const r of rs){\n  const sr=Number(r.sr),er=Number(r.er),sc=Number(r.sc),ec=Number(r.ec);\n  if(![sr,er,sc,ec].every(Number.isInteger)){throw new Error('non-integer range '+JSON.stringify(r));}\n  if(sr<1||er<=sr||er>900){throw new Error('bad rows '+sr+'..'+er+' (row 0 is the header, never touch it)');}\n  if(sc<0||ec<=sc||ec>42){throw new Error('bad cols '+sc+'..'+ec);}\n  if((er-sr)>1){throw new Error('refusing multi-row unmerge '+sr+'..'+er);}\n  reqs.push({unmergeCells:{range:{sheetId:SHEET,startRowIndex:sr,endRowIndex:er,startColumnIndex:sc,endColumnIndex:ec}}});\n}\nreturn [{json:{mode:'unmerge',doUnmerge:true,count:reqs.length,payload:JSON.stringify({requests:reqs})}}];"
      }
    },
    {
      "id": "ifu",
      "name": "Unmerge?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.doUnmerge }}",
              "rightValue": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "um",
      "name": "Unmerge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        620,
