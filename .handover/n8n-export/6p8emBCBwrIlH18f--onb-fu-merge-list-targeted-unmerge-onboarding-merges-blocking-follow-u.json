    {
      "id": "ck",
      "name": "Read merges",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "position": [
        860,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4?fields=sheets(properties(sheetId,title),merges)",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "o",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Prep').first().json;\nlet w=null;if(p.doUnmerge){try{w=$('Unmerge').first().json||{};}catch(e){w={error:'no response'};}}\nconst m=$input.first().json||{};\nlet onb=[];(m.sheets||[]).forEach(s=>{if((s.properties||{}).title==='ONBOARDING')onb=s.merges||[];});\nconst compact=onb.map(r=>({sr:r.startRowIndex,er:r.endRowIndex,sc:r.startColumnIndex,ec:r.endColumnIndex}));\nconst out={mode:p.mode,onboarding_merges_total:compact.length,merges:compact};\nif(p.doUnmerge){out.unmerge_requested=p.count;out.unmerge_replies=(w&&w.replies)?w.replies.length:0;out.unmerge_error=(w&&w.error)?(w.error.message||JSON.stringify(w.error)).slice(0,300):null;}\nreturn [{json:out}];"
      }
    }
  ],
