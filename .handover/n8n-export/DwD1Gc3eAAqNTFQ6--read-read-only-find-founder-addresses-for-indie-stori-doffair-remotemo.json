      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = (v) => String(v == null ? '' : v).trim();\nconst low = (v) => s(v).toLowerCase();\nconst boxes = [['Chaman dealflow@', 'MB2 Chaman'], ['Akansha', 'MB4 Akansha'], ['Shradhaa', 'MB5 Shradhaa']];\nconst out = [];\nfor (const [label, node] of boxes) {\n  let items = [];\n  try { items = $(node).all(); } catch (e) { continue; }\n  for (const it of items) {\n    const m = it.json || {};\n    if (m.error || !m.id) continue;\n    const h = {};\n    for (const k in (m.headers || {})) h[low(k)] = m.headers[k];\n    const subj = s(h.subject);\n    if (!/update on investor outreach/i.test(subj)) continue;\n    let body = s(m.text || m.textPlain || m.snippet).replace(/\\r/g, '');\n    body = body.split(/\\n\\s*On .{10,90} wrote:/)[0].slice(0, 900);\n    out.push({ mailbox: label, date: s(h.date), from: s(h.from), to: s(h.to), cc: s(h.cc), subject: subj, body });\n  }\n}\nout.sort((a, b) => new Date(a.date) - new Date(b.date));\nreturn [{ json: { thread_messages_found: out.length, messages: out } }];"
      }
    }
