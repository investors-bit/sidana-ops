      "id": "an",
      "name": "Piper",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst v = $('GET pilot').first().json.valueRanges || [];\nconst pipe = (v[0] || {}).values || [], elog = (v[1] || {}).values || [];\nif (pipe.length < 500) { throw new Error('ABORT short read'); }\nconst ph = (pipe[0] || []).map(s);\nconst rows = [];\nfor (let r = 1; r < pipe.length; r++) { const row = pipe[r] || []; if (!/piper/i.test(row.join(' '))) { continue; }\n  const o = { sheet_row: r + 1 }; ph.forEach(function (h, i) { const val = s(row[i]); if (val && h !== 'thread_id' && h !== 'message_id') { o[h] = val.slice(0, 160); } }); rows.push(o); }\nconst eh = (elog[0] || []).map(s);\nconst el = [];\nfor (let r = 1; r < elog.length; r++) { const row = elog[r] || []; if (!/piper/i.test(row.join(' '))) { continue; } const o = { sheet_row: r + 1 }; eh.forEach(function (h, i) { if (s(row[i])) { o[h] = s(row[i]).slice(0, 300); } }); el.push(o); }\nreturn [{ json: { pipeline_header: ph, piper_pipeline_rows: rows, piper_error_log: el } }];"
      }
    }
  ],
