    {
      "id": "p",
      "name": "Prep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};\nif(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst SH='1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4';\nconst ex=Object.keys(b.expect||{});\nconst url=ex.length?('https://sheets.googleapis.com/v4/spreadsheets/'+SH+'/values:batchGet?'+ex.map(r=>'ranges='+encodeURIComponent(r)).join('&')):'';\nreturn [{json:{url:url, hasExpect: ex.length>0}}];"
      }
    },
    {
      "id": "g",
      "name": "Get",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "url": "={{ $json.hasExpect ? $json.url : 'https://sheets.googleapis.com/v4/spreadsheets/1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4/values/LI_OUTREACH!A1' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "v",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body;\nconst ex=Object.keys(b.expect||{});\nif(ex.length){\n  const vr=$input.first().json.valueRanges||[];\n  ex.forEach((r,i)=>{\n    const got=String((((vr[i]||{}).values||[[]])[0]||[])[0]||'').trim();\n    if(got!==String(b.expect[r]).trim()){throw new Error('GUARD FAIL '+r+': expected \"'+b.expect[r]+'\" but found \"'+got+'\"');}\n  });\n}\nconst data=(b.set||[]).map(s=>({range:s.range,values:[[s.value]]}));\nif(!data.length){throw new Error('nothing to set');}\nreturn [{json:{body:{valueInputOption:'RAW',data:data}}}];"
      }
    },
    {
      "id": "w",
      "name": "Write",
      "type": "n8n-nodes-base.httpRequest",
