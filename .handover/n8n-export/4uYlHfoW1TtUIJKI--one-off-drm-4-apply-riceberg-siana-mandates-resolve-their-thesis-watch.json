    {
      "id": "cd3",
      "name": "Prep deletes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f=$('Find flags').all().map(i=>i.json);\nif(f.length!==2){throw new Error('ABORT: expected 2 flag rows, got '+f.length);}\nconst out=f.map(r=>({json:{row_number:Number(r._rn),investor:String(r.investor||'')}}));\nout.sort((a,b)=>b.json.row_number-a.json.row_number);\nif(out[0].json.row_number===out[1].json.row_number){throw new Error('ABORT: duplicate row_number');}\nreturn out;"
      }
