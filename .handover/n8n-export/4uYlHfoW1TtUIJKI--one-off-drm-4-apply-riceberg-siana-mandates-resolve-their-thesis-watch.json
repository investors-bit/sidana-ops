        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Corrections-sheet values for the two investors whose thesis changed. Both firms already\n// exist in INVESTORS - these are updates to the live row, never new rows.\n// Siana's cheque band ($1M-$2M) is unchanged in substance, so the existing INR gloss stays.\nfunction s(v){return String(v==null?'':v).trim();}\nconst rows=$input.all().map(i=>i.json);\nif(rows.length<100){throw new Error('ABORT: INVESTORS returned only '+rows.length+' rows');}\nconst U=[\n  {investor:'Riceberg Ventures', sector:'Foundational AI technology (foundational AI only - not application-layer AI platforms)'},\n  {investor:'Siana Capital', sector:'Deep-tech, IP-led innovation: HealthTech, Battery Tech, Biotech, MedTech', stage:'Pre-Series A - Series A'}\n];\nfor(const u of U){\n  const h=rows.filter(r=>s(r.investor)===u.investor);\n  if(h.length!==1){throw new Error('ABORT: expected 1 INVESTORS row for '+u.investor+', found '+h.length);}\n  if(s(h[0].do_not_contact).toLowerCase()==='yes'){throw new Error('ABORT: '+u.investor+' is do_not_contact');}\n}\nreturn U.map(u=>({json:u}));"
      }
    },
