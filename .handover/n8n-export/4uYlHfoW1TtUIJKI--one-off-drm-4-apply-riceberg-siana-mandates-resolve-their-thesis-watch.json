    {
      "id": "cd2",
      "name": "Find flags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Close only the two flags whose investor has actually been re-matched. Elevation Capital\n// stays open on purpose: five partners with five different theses sit on one INVESTORS row,\n// so there is no single mandate to apply and guessing would email a real investor a bad deal.\nfunction s(v){return String(v==null?'':v).trim();}\nconst DONE=['Riceberg Ventures','Siana Capital'];\nconst rows=$input.all().map(i=>i.json);\nif(rows.length<100){throw new Error('ABORT: ERROR LOG returned only '+rows.length+' rows');}\nconst hits=rows.filter(r=>s(r.workflow).toUpperCase()==='THESIS-WATCH' && s(r.resolved)==='' && DONE.indexOf(s(r.investor))>=0);\nif(hits.length!==2){throw new Error('ABORT: expected 2 open THESIS-WATCH flags to close, found '+hits.length);}\nreturn hits.map(function(r){\n  const o={};\n  for(const k of Object.keys(r)){ if(k!=='row_number'){ o[k]=r[k]; } }\n  o.resolved='Yes';\n  o._rn=Number(r.row_number);\n  return {json:o};\n});"
      }
    },
