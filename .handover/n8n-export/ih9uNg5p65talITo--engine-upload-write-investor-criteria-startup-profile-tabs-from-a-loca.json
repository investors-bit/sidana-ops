      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $('Webhook').first().json.body || {};\nif (body.secret !== 'sv-crit-2026-09-17-q8Lz') { throw new Error('ABORT: bad secret'); }\nconst tabs = body.tabs || [];\nconst ALLOWED = ['INVESTOR_CRITERIA', 'STARTUP_PROFILE', 'MATCH_REVIEW'];\nfor (const t of tabs) { if (ALLOWED.indexOf(t.name) < 0) { throw new Error('ABORT: tab not allowed ' + t.name); } if (!Array.isArray(t.values) || t.values.length < 2) { throw new Error('ABORT: empty tab ' + t.name); } }\nconst existing = (($('GET meta').first().json.sheets) || []).map(function (s) { return s.properties.title; });\nconst add = tabs.filter(function (t) { return existing.indexOf(t.name) < 0; }).map(function (t) { return { addSheet: { properties: { title: t.name, gridProperties: { rowCount: Math.max(1000, t.values.length + 50), columnCount: Math.max(30, t.values[0].length + 2), frozenRowCount: 1 } } } }; });\nreturn [{ json: { add: add, clear: tabs.map(function (t) { return \"'\" + t.name + \"'!A1:AZ5000\"; }), data: tabs.map(function (t) { return { range: \"'\" + t.name + \"'!A1\", values: t.values }; }), counts: tabs.map(function (t) { return t.name + ': ' + (t.values.length - 1) + ' rows'; }) } }];"
      }
    },
