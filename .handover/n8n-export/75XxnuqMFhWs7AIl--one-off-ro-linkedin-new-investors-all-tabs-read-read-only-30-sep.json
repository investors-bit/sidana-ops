        "jsCode": "const titles = $('Build').first().json.titles;\nconst vr = $input.first().json.valueRanges || [];\nconst tabs = titles.map((t, i) => { const v = ((vr[i]||{}).valueRange||{}).values || []; return { title: t, rows: v.length, values: v.map(r => (r||[]).map(c => String(c)).join(' | ')) }; });\nreturn [{ json: { tabs } }];"
