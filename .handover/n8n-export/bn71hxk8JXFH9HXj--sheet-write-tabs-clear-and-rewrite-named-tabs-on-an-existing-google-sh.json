      "name": "Prep clear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!b.spreadsheetId||!Array.isArray(b.sheets)||!b.sheets.length){throw new Error('need spreadsheetId + sheets[]');}\nconst q=s=>\"'\"+String(s).replace(/'/g,\"''\")+\"'\";\nreturn [{json:{spreadsheetId:b.spreadsheetId,body:{ranges:b.sheets.map(s=>q(s.name)+'!A1:Z2000')}}}];"
      }
    },
    {
      "id": "clr",
      "name": "Clear tabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $json.spreadsheetId }}/values:batchClear",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "p2",
      "name": "Prep write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body;const q=s=>\"'\"+String(s).replace(/'/g,\"''\")+\"'\";\nconst data=b.sheets.map(s=>({range:q(s.name)+'!A1',values:s.values}));\nreturn [{json:{spreadsheetId:b.spreadsheetId,body:{valueInputOption:'RAW',data:data}}}];"
      }
    },
    {
      "id": "wr",
      "name": "Write tabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
