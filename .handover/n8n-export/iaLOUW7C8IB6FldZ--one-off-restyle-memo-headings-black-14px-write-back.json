    {
      "id": "966a5a76-327b-4352-a37f-0f11d800cb7c",
      "name": "Compute restyled memos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nfunction restyle(html) {\n  let out = String(html == null ? '' : html);\n  out = out.split('color:#0b2e59').join('color:#000000');\n  out = out.split('color:#5a6472').join('color:#000000');\n  out = out.split('font-size:20px').join('font-size:14px');\n  out = out.split('font-size:15px').join('font-size:14px');\n  out = out.split('font-size:13px').join('font-size:14px');\n  return out;\n}\nconst out = [];\nfor (const r of rows) {\n  const memo = String(r.memo_html || '');\n  if (!memo) continue;\n  const styled = restyle(memo);\n  if (styled === memo) continue;   // no change -> skip\n  out.push({ json: { startup: r.startup, memo_html: styled } });\n}\nreturn out;"
      }
    },
