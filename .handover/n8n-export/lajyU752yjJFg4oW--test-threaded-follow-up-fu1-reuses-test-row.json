    {
      "id": "83283239-9ede-429e-a382-282b7dd07b31",
      "name": "Compute PIPELINE write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Build CONFIG object').first().json;\nconst tz = cfg.TIMEZONE || 'Asia/Kolkata';\nconst now = DateTime.now().setZone(tz);\nconst today = now.toISODate();\nconst fu2 = parseInt(cfg.FU2_DAYS, 10); const FU2 = isNaN(fu2) ? 7 : fu2;\n\nconst be = $('Build email').item.json;\nconst stage = be.stage; // FU1\nconst row = { deal_id: be.deal_id, last_contact: today };\nif (stage === 'FU1') {\n  row.fu1_done = 'Yes';\n  row.fu1_date = today;\n  row.next_action = 'Follow-up 2';\n  row.next_due = now.plus({ days: FU2 }).toISODate();\n}\nreturn { json: row };"
      }
    },
