      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst deckRe = /pitch\\s*deck/i;\nconst closeRe = /investment mandate|arrange a discussion|happy to arrange/i;\nconst withDeck = [];\nconst withClosing = [];\nfor (const r of rows) {\n  const memo = String(r.memo_html || '');\n  const name = r.startup_name || r.startup || r.name || r.startup_id || '(unknown)';\n  if (deckRe.test(memo)) withDeck.push(name);\n  if (closeRe.test(memo)) withClosing.push(name);\n}\nreturn [{ json: {\n  total_startups: rows.length,\n  memos_still_containing_pitch_deck: withDeck.length,\n  pitch_deck_startups: withDeck,\n  memos_still_containing_closing: withClosing.length,\n  closing_startups: withClosing,\n} }];"
      }
    }
  ],
