    {
      "id": "cd1",
      "name": "Count per startup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst m = {};\nfor (const r of rows) {\n  const st = s(r.startup);\n  const inv = s(r.investor);\n  if (!st || !inv) { continue; }\n  if (!m[st]) { m[st] = { startup: st, owner: s(r.owner), total: 0, pending: 0, sent: 0, paused: 0, replied: 0, investors: {} }; }\n  const e = m[st];\n  if (e.investors[inv]) { continue; }   // distinct investors only\n  e.investors[inv] = true;\n  e.total++;\n  if (s(r.pause) !== '') { e.paused++; }\n  else if (s(r.deal_shared).toLowerCase() === 'yes') { e.sent++; }\n  else { e.pending++; }\n  if (s(r.investor_response) !== '') { e.replied++; }\n}\n\nconst list = Object.keys(m).map(function (k) {\n  const e = m[k];\n  return { startup: e.startup, owner: e.owner, investors_matched: e.total,\n           pending: e.pending, sent: e.sent, paused: e.paused, replied: e.replied };\n});\nlist.sort(function (a, b) { return b.investors_matched - a.investors_matched; });\n\nlet tot = 0;\nfor (const x of list) { tot += x.investors_matched; }\nreturn [{ json: {\n  pipeline_rows: rows.length,\n  distinct_startups: list.length,\n  total_pairs: tot,\n  avg_investors_per_startup: Math.round(tot / list.length * 10) / 10,\n  per_startup: list\n}}];"
      }
    }
  ],
