      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};\nif(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!b.event_id){throw new Error('missing event_id');}\nreturn [{json:{b:b,url:'https://www.googleapis.com/calendar/v3/calendars/primary/events/'+b.event_id}}];"
      }
    },
