    {
      "id": "mg",
      "name": "Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Prep').first().json;const b=p.b;const ev=$input.first().json;\nif(!ev||!ev.id){throw new Error('event not found on this calendar: '+JSON.stringify(ev).slice(0,300));}\nconst cur=(ev.attendees||[]).map(function(a){return String(a.email).toLowerCase();});\nconst add=(b.add_attendees||[]).map(function(e){return String(e).trim().toLowerCase();});\nconst rm=(b.remove_attendees||[]).map(function(e){return String(e).trim().toLowerCase();});\nconst list=[].concat(cur,add).filter(function(e,i,arr){return arr.indexOf(e)===i&&rm.indexOf(e)<0;});\nconst patch={};\nif(b.cancel===true){patch.status='cancelled';}\nelse{\nif(add.length||rm.length){patch.attendees=list.map(function(e){return {email:e};});}\nif(b.start){patch.start={dateTime:b.start,timeZone:'Asia/Kolkata'};}\nif(b.end){patch.end={dateTime:b.end,timeZone:'Asia/Kolkata'};}\nif(b.summary){patch.summary=b.summary;}\nif(b.description){patch.description=b.description;}\n}\nif(!Object.keys(patch).length){throw new Error('nothing to change');}\nif(b.cancel===true&&b.expect_summary&&String(ev.summary||'')!==String(b.expect_summary)){throw new Error('REFUSING to cancel: summary is \"'+ev.summary+'\", expected \"'+b.expect_summary+'\"');}\nif(b.dry!==false){throw new Error('DRY OK | '+ev.summary+' | now '+((ev.start||{}).dateTime||'')+' | meet '+(ev.hangoutLink||'-')+' | attendees now: '+cur.join(', ')+' | patch='+JSON.stringify(patch));}\nreturn [{json:{url:p.url,patch:patch,was:ev.summary}}];"
      }
    },
