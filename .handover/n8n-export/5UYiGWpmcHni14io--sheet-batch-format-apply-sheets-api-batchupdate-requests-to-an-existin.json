    {
      "id": "p",
      "name": "Resolve sheet names",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!b.spreadsheetId||!Array.isArray(b.requests)||!b.requests.length){throw new Error('need spreadsheetId + requests[]');}\nconst meta=$input.first().json;const map={};(meta.sheets||[]).forEach(s=>{map[s.properties.title]=s.properties.sheetId;});\nfunction walk(v){if(Array.isArray(v)){return v.map(walk);}\n if(v&&typeof v==='object'){const o={};for(const k of Object.keys(v)){let x=v[k];if(k==='sheetId'&&typeof x==='string'&&x.charAt(0)==='@'){const n=x.slice(1);if(!(n in map)){throw new Error('no tab named '+n+' (have: '+Object.keys(map).join(', ')+')');}x=map[n];}else{x=walk(x);}o[k]=x;}return o;}\n return v;}\nreturn [{json:{spreadsheetId:b.spreadsheetId,tabs:map,body:{requests:walk(b.requests)}}}];"
      }
    },
