      ],
      "parameters": {
        "jsCode": "const today = '2026-09-01';\nconst rows = $input.all().map(i => i.json);\nconst sentToday = rows.filter(r => String(r.date_shared || '').trim() === today);\nconst byOwner = {};\nfor (const r of sentToday) {\n  const o = String(r.owner || 'unknown').trim();\n  byOwner[o] = byOwner[o] || [];\n  byOwner[o].push({ deal_id: r.deal_id, startup: r.startup, investor: r.investor, email: r.email, next_action: r.next_action, thread_id: r.thread_id });\n}\nconst summary = Object.keys(byOwner).map(o => ({ owner: o, count: byOwner[o].length }));\nreturn [{ json: { today, total_sent_today: sentToday.length, by_owner: summary, detail: byOwner } }];"
      },
      "executeOnce": true
    }
