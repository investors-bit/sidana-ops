    {
      "id": "n2",
      "name": "Build format rule",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json;\nconst sheets = resp.sheets || [];\nlet gid = null;\nlet cols = 35;\nfor (const s of sheets) {\n  if (String(s.properties.title).trim() === 'PIPELINE') {\n    gid = s.properties.sheetId;\n    if (s.properties.gridProperties && s.properties.gridProperties.columnCount) { cols = s.properties.gridProperties.columnCount; }\n    break;\n  }\n}\nif (gid === null) { throw new Error('PIPELINE tab not found in spreadsheet'); }\n\nconst FORMULA = '=OR($AD2=\"Passed\", $V2=\"Pass\", $V2=\"Passed\")';\n\nconst body = { requests: [ { addConditionalFormatRule: { index: 0, rule: {\n  ranges: [ { sheetId: gid, startRowIndex: 1, startColumnIndex: 0, endColumnIndex: cols } ],\n  booleanRule: {\n    condition: { type: 'CUSTOM_FORMULA', values: [ { userEnteredValue: FORMULA } ] },\n    format: { textFormat: { foregroundColor: { red: 0.8, green: 0, blue: 0 }, foregroundColorStyle: { rgbColor: { red: 0.8, green: 0, blue: 0 } } } }\n  }\n} } } ] };\n\nreturn [{ json: { gid: gid, columnCount: cols, formula: FORMULA, body: body } }];"
      }
    },
    {
      "id": "n3",
      "name": "Apply conditional format",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
