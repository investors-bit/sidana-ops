    {
      "id": "v2c",
      "name": "Row diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).replace(/\\s+/g, ' ').trim(); }\nconst grid = $('GET thesis raw').first().json.values || [];\nconst snap = (($('GET snapshot').first().json.values) || []).slice(1).filter(function (r) { return s(r[0]); });\nconst cur = {}; let firm = '';\nfor (let i = 0; i < grid.length; i++) { const cells = (grid[i] || []).map(s); while (cells.length && !cells[cells.length - 1]) { cells.pop(); } if (!cells.length) { continue; } if (cells[0]) { firm = cells[0]; } cur[String(i + 1)] = { firm: firm, text: cells.join(' | ').slice(0, 45000) }; }\nconst old = {}; snap.forEach(function (r) { old[s(r[0])] = { firm: s(r[1]), text: s(r[2]) }; });\nconst changed = Object.keys(cur).filter(function (k) { return old[k] && old[k].text !== cur[k].text; }).map(function (k) { return k + ' ' + cur[k].firm; });\nconst added = Object.keys(cur).filter(function (k) { return !old[k]; });\nconst removed = Object.keys(old).filter(function (k) { return !cur[k]; });\nreturn [{ json: { thesis_rows: Object.keys(cur).length, snapshot_rows: snap.length, changed: changed, new_rows: added, removed_rows: removed, detail: Object.keys(cur).filter(function (k) { return !old[k] || old[k].text !== cur[k].text; }).map(function (k) { return { row: k, now: cur[k].text.slice(0, 700), was: old[k] ? old[k].text.slice(0, 700) : '' }; }) } }];"
      }
    }
  ],
