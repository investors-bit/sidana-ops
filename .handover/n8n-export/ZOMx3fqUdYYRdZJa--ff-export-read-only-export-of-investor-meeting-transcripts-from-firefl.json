        "jsCode": "const c = $('Check').first().json;\nconst rows = $input.all().map(i => i.json).sort((a, b) => String(a.meeting_date).localeCompare(String(b.meeting_date)));\nconst page = rows.slice(c.offset, c.offset + c.size).map(r => ({ ff_id: r.ff_id, title: r.title, date: String(r.meeting_date || '').slice(0, 10), attendees: r.attendees, overview: r.overview, action_items: r.action_items, transcript_chars: r.transcript_chars, transcript: String(r.transcript || '').slice(0, c.cap) }));\nreturn [{ json: { total: rows.length, offset: c.offset, returned: page.length, rows: page } }];"
