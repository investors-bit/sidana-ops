    {
      "id": "cd1",
      "name": "Repoint to Angel Fund",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The INVESTORS row was renamed by IAN-1. Every PIPELINE row still carrying the OLD name would\n// fail investor lookup ('investor-not-found') and silently stop sending, so repoint them.\n// They go to the Angel Fund: that is the continuing relationship and its 2-6 Cr band matches\n// the raise sizes these rows were originally matched on.\nconst OLD = 'IAN Group (Indian Angel Network)';\nconst NEW = 'IAN Group - Angel Fund';\nfunction s(v) { return String(v == null ? '' : v).trim(); }\n\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst hits = rows.filter(function (r) { return s(r.investor) === OLD; });\nif (hits.length === 0) { throw new Error('ABORT: no PIPELINE rows found for ' + OLD + ' - already repointed?'); }\nif (hits.length > 60) { throw new Error('ABORT: ' + hits.length + ' rows exceeds guard of 60'); }\n\nreturn hits.map(function (h) { return { json: { deal_id: s(h.deal_id), investor: NEW } }; });"
      }
    },
