        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst rows = $input.all();\nconst cfg = {};\nfor (const it of rows) {\n  const k = it.json.setting !== undefined ? it.json.setting : it.json.key;\n  if (k === undefined || k === null || String(k).trim() === '') continue;\n  cfg[String(k).trim()] = it.json.value;\n}\ncfg.OWNER_NAME = 'Shradha';\ncfg.SENDER_NAME = 'Shradha';\nreturn [{ json: cfg }];\n"
      }
    },
