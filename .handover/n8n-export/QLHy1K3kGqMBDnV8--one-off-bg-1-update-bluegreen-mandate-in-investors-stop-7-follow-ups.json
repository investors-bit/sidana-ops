      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// BlueGreen rows already SENT with NO investor reply -> stop remaining follow-ups.\n// D00645 (Vilva AI) is excluded: that investor replied ('Other - needs review').\nconst TARGETS = ['D01706','D01710','D01720','D01740','D01741','D02501','D02564'];\nfunction s(v) { return String(v == null ? '' : v).trim(); }\n\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst out = [];\nfor (const t of TARGETS) {\n  const hits = rows.filter(function (r) { return s(r.deal_id) === t; });\n  if (hits.length !== 1) { throw new Error('ABORT: expected 1 row for ' + t + ', found ' + hits.length); }\n  const h = hits[0];\n  if (s(h.investor) !== 'BlueGreen Ventures') { throw new Error('ABORT: ' + t + ' is not BlueGreen (' + s(h.investor) + ')'); }\n  if (s(h.deal_shared).toLowerCase() !== 'yes') { throw new Error('ABORT: ' + t + ' is not deal_shared=Yes'); }\n  if (s(h.investor_response) !== '') { throw new Error('ABORT: ' + t + ' has an investor_response - leave it alone'); }\n  if (s(h.pause) !== '') { continue; }\n  const prev = s(h.notes);\n  out.push({ json: {\n    deal_id: t,\n    pause: 'Yes',\n    next_action: 'Stopped - off new BlueGreen mandate',\n    notes: (prev ? prev + ' | ' : '') + 'Follow-ups stopped 2026-09-07: BlueGreen mandate changed (Climate / Post AI Careers / Salt & Pepper)'\n  }});\n}\nif (out.length === 0) { throw new Error('ABORT: nothing to pause'); }\nif (out.length > 7) { throw new Error('ABORT: ' + out.length + ' exceeds guard of 7'); }\nreturn out;"
      }
    },
