      {
        "id": "win",
        "name": "Window",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -220,
          400
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Default window is wide on purpose: meetings get rescheduled and cancelled\n// after the fact, and iCalUID is the primary key so re-reading is free.\n// A backfill call can widen it further with {\"days_back\":600,\"days_fwd\":200}.\nlet b = {};\ntry { b = ($('Backfill hook').first().json.body) || {}; } catch (e) { b = {}; }\n// 30 days back catches a reschedule or a cancellation; 120 forward keeps the\n// upcoming list complete. A wider sweep is a backfill call, not every hour.\nconst back = Number(b.days_back) > 0 ? Number(b.days_back) : 30;\nconst fwd  = Number(b.days_fwd)  > 0 ? Number(b.days_fwd)  : 120;\nconst now = Date.now();\nreturn [{ json: {\n  timeMin: new Date(now - back * 86400000).toISOString(),\n  timeMax: new Date(now + fwd  * 86400000).toISOString(),\n} }];"
        }
      },
