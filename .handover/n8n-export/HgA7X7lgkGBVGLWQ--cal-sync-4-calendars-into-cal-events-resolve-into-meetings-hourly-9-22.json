              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 20,
              "requestInterval": 200
            }
          }
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "FMaJN0wYxb8FWUZs",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "id": "s1",
      "name": "Shape 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = [];\nfor (const it of $input.all()) {\n  for (const e of (it.json.items || [])) {\n    const when = (e.start && (e.start.dateTime || e.start.date)) || null;\n    if (!when) { continue; }\n    const uid = e.iCalUID || e.id;\n    if (!uid) { continue; }\n    rows.push({\n      ical_uid: uid, event_id: e.id || null,\n      summary: e.summary || null,\n      start_at: new Date(when).toISOString(),\n      status: e.status || null,\n      meet_link: e.hangoutLink || null,\n      attendees: (e.attendees || []).map(function (a) { return String(a.email || '').toLowerCase(); }).filter(Boolean).join(','),\n    });\n  }\n}\n// Deduplicate inside the batch. Postgres refuses an upsert that would touch\n// the same key twice in one statement, and a recurring event can repeat here.\nconst seen = {}; const out = [];\nfor (const r of rows) { if (seen[r.ical_uid]) { continue; } seen[r.ical_uid] = 1; out.push(r); }\nconst chunks = [];\nfor (let i = 0; i < out.length; i += 400) { chunks.push({ json: { chunk: out.slice(i, i + 400) } }); }\nreturn chunks;"
      }
    },
