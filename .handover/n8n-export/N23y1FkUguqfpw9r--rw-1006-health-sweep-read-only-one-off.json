      "parameters": {
        "jsCode": "const vr = $input.first().json.valueRanges || [];\nconst g = i => (vr[i] && vr[i].values) ? vr[i].values : [];\nconst CR = g(0), IN = g(1), EL = g(4);\nconst hdr = rows => (rows[0]||[]).map(h => String(h||'').trim());\nconst idx = (h,n) => h.findIndex(x => x.toLowerCase() === n.toLowerCase());\nconst S = v => (v===undefined||v===null) ? '' : String(v).trim();\nconst eh = hdr(EL), ch = hdr(CR);\nconst unres = [];\nfor (let r=1;r<EL.length;r++){ const row=EL[r]||[];\n  if (S(row[idx(eh,'workflow')]).toUpperCase()!=='THESIS-WATCH') continue;\n  if (S(row[idx(eh,'resolved')])!=='') continue;\n  unres.push((r+1)+' '+S(row[idx(eh,'investor')])+' '+S(row[idx(eh,'error_type')]));\n}\nconst checked = [2708,2715,2716,2717,2718,2719,2720,2721,2722,2723].map(n => n+':'+S((EL[n-1]||[])[idx(eh,'resolved')] || 'BLANK'));\nconst b = CR[235]||[];\nconst f = n => S(b[idx(ch,n)]);\nreturn [{ json: {\n  thesis_watch_unresolved_now: { n: unres.length, rows: unres },\n  resolved_cells_readback: checked,\n  beyond_seed_236: { investor: f('investor'), sector_mode: f('sector_mode'), sectors_in: f('sectors_in'), sectors_excluded: f('sectors_excluded'), stage_min: f('stage_min'), stage_max: f('stage_max'), arr_min_cr: f('arr_min_cr'), revenue_required: f('revenue_required'), rule_notes: f('rule_notes').slice(0,300) },\n  investors_E236: S((IN[235]||[])[4]).slice(0,160),\n  investors_G170: S((IN[169]||[])[6])\n} }];"
