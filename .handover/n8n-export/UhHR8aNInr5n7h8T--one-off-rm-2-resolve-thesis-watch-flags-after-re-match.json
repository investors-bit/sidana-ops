    {
      "id": "cd1",
      "name": "Find flags to close",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Close the THESIS-WATCH flags handled by RM-1 (Zeren, a99 VC, DSG Consumer Partners).\n// ERROR LOG has no unique key, so a row cannot be updated in place by a matching column:\n// delete the flag row and re-append it marked resolved, preserving the audit trail.\nconst DONE = ['zeren capital', 'a99 vc', 'dsg consumer', 'dsg consumer partners'];\nfunction s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 100) { throw new Error('ABORT: ERROR LOG returned only ' + rows.length + ' rows'); }\n\nconst hits = rows.filter(function (r) {\n  return s(r.workflow) === 'THESIS-WATCH' && s(r.resolved) === ''\n      && DONE.indexOf(s(r.investor).toLowerCase()) >= 0;\n});\nif (hits.length === 0) { throw new Error('ABORT: no matching open THESIS-WATCH flags - already closed?'); }\nif (hits.length > 6) { throw new Error('ABORT: ' + hits.length + ' exceeds guard of 6'); }\nfor (const h of hits) { if (!h.row_number) { throw new Error('ABORT: missing row_number'); } }\n\nconst out = hits.map(function (h) {\n  return { json: {\n    row_number: Number(h.row_number),\n    timestamp: s(h.timestamp), workflow: 'THESIS-WATCH', deal_id: '', startup: '',\n    investor: s(h.investor), error_type: s(h.error_type), details: s(h.details),\n    resolved: 'Yes - re-matched 2026-09-08'\n  }};\n});\nout.sort(function (a, b) { return b.json.row_number - a.json.row_number; });\nreturn out;"
      }
    },
