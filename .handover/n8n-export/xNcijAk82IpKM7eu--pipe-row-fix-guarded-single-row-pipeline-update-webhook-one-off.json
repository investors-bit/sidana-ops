        "jsCode": "const b=$('Webhook').first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst vr=$input.first().json.valueRanges;const h=(vr[0].values||[[]])[0].map(x=>String(x).trim());const r=(vr[1].values||[[]])[0]||[];const g=k=>String(r[h.indexOf(k)]||'').trim();\nif(g('deal_id')!==b.expect_deal_id){throw new Error('row '+b.row+' deal_id is '+g('deal_id'));}\nif(/^yes$/i.test(g('deal_shared'))){throw new Error('row already sent - refusing');}\nconst L=i=>{let n=i+1,t='';while(n>0){const m=(n-1)%26;t=String.fromCharCode(65+m)+t;n=Math.floor((n-1)/26);}return t;};\nconst data=[];for(const k of Object.keys(b.set||{})){const i=h.indexOf(k);if(i<0){throw new Error('no column '+k);}let v=b.set[k];if(k==='notes'&&b.append_notes){v=(g('notes')?g('notes')+' | ':'')+v;}data.push({range:'PIPELINE!'+L(i)+b.row,values:[[v]]});}\nreturn [{json:{body:{valueInputOption:'RAW',data:data}}}];"
