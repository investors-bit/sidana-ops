        2240,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst cfg = $('Build CONFIG object').first().json;\nconst tz = cfg.TIMEZONE || 'Asia/Kolkata';\nconst now = DateTime.now().setZone(tz);\nconst today = now.toISODate();\nconst fu1 = parseInt(cfg.FU1_DAYS, 10); const FU1 = isNaN(fu1) ? 4 : fu1;\n\nconst resp = $json;\nconst be = $('Build email').item.json;\nconst gmailId = resp.id || '';\nconst gmailThread = resp.threadId || '';\n\nreturn { json: {\n  deal_id: be.deal_id,\n  last_contact: today,\n  deal_shared: 'Yes',\n  date_shared: today,\n  channel: 'Email',\n  thread_id: gmailThread,\n  message_id: gmailId,\n  next_action: 'Follow-up 1',\n  next_due: now.plus({ days: FU1 }).toISODate(),\n} };\n"
      }
