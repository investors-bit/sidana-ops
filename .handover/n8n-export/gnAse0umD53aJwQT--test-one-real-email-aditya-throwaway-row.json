    {
      "id": "332f1b9a-865b-4cb9-8260-3101dfc8d7b6",
      "name": "Prepare test item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst blank = (x) => x === undefined || x === null || String(x).trim() === '';\nconst startups = $('Read STARTUPS').all().map(i => i.json);\nconst investors = $('Read INVESTORS').all().map(i => i.json);\nlet st = null;\nfor (const s of startups) {\n  if (String(s.active).trim().toLowerCase() === 'yes'\n    && !blank(s.memo_html) && !blank(s.highlight_1) && !blank(s.highlight_2) && !blank(s.highlight_3)\n    && !blank(s.deck_link) && !blank(s.sector) && !blank(s.raise_inr_cr)) { st = s; break; }\n}\nlet inv = null;\nfor (const v of investors) { if (!blank(v.contact_person) && !blank(v.investor)) { inv = v; break; } }\nif (!st) throw new Error('No fully-populated active startup found for the test.');\nif (!inv) throw new Error('No investor with contact_person found for the test.');\n// Only real PIPELINE columns here (this row is appended to PIPELINE).\n// pause is set so a real Workflow A run can NEVER pick this row up.\nreturn [{ json: {\n  deal_id: 'TEST-ADITYA-001',\n  owner: 'Aditya',\n  startup: st.startup,\n  investor: inv.investor,\n  email: '(delivered to test recipient set in Gmail node)',\n  deal_shared: 'No',\n  pause: 'TEST-HOLD — delete this row after the test',\n} }];\n"
      }
    },
