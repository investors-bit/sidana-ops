      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const C = $('Check').first().json; const day = C.day;\nconst vr = $('Sheets').first().json.valueRanges || [];\nconst tab = (vals) => { const h = (vals[0]||[]).map(x => String(x).trim()); return vals.slice(1).filter(r => r && r[0]).map(r => { const o = {}; h.forEach((k,i) => o[k] = r[i] != null ? String(r[i]).trim() : ''); return o; }); };\nconst P = tab((vr[0]||{}).values||[]); const S = tab((vr[1]||{}).values||[]);\nconst desk = {}; for (const r of S) desk[r.startup] = r.desk || 'HOT';\nconst is = d => (d||'').slice(0,10) === day;\nconst shares = P.filter(r => is(r.date_shared));\nconst fus = []; for (const r of P) for (const k of ['fu1','fu2','fu3']) if (is(r[k + '_date'])) fus.push({ r, k });\nconst touched = P.filter(r => is(r.last_contact) && !is(r.date_shared));\nconst grp = (arr, f) => { const m = {}; for (const x of arr) { const k = f(x); m[k] = (m[k]||0) + 1; } return m; };\nconst resp = touched.filter(r => r.investor_response).map(r => ({ startup: r.startup, desk: desk[r.startup], investor: r.investor, owner: r.owner, response: r.investor_response.slice(0,140), next: (r.next_action||'').slice(0,80) }));\nconst cal = {}; const info = {};\nfor (const n of ['Cal A','Cal B','Cal C','Cal D']) { const j = $(n).first().json; info[n] = j.items ? { count: j.items.length, truncated: !!j.nextPageToken } : { error: String(JSON.stringify(j.error||j)).slice(0,200) }; for (const e of (j.items||[])) { if (e.status === 'cancelled' || !e.summary) continue; const st = (e.start||{}).dateTime || (e.start||{}).date || ''; const k = st.slice(0,16) + '|' + e.summary.toLowerCase(); cal[k] = { start: st, s: e.summary.replace(/&amp;/g,'&'), created: e.created || '', ext: (e.attendees||[]).filter(a => !/sidanaventures\\.com$/i.test(a.email||'')).map(a => a.email) }; } }\nconst ev = Object.values(cal);\nconst istDay = iso => iso ? new Date(new Date(iso).getTime() + 5.5*3600e3).toISOString().slice(0,10) : '';\nconst todayMeet = ev.filter(e => istDay(e.start) === day || e.start.slice(0,10) === day).sort((a,b) => a.start.localeCompare(b.start)).map(e => e.start.slice(11,16) + ' ' + e.s + (e.ext.length ? ' [ext: ' + e.ext.length + ']' : ' [internal]'));\nconst booked = ev.filter(e => istDay(e.created) === day && !(istDay(e.start) === day)).map(e => istDay(e.start) + ' ' + e.start.slice(11,16) + ' ' + e.s + (e.ext.length ? ' [ext: ' + e.ext.length + ']' : ' [internal]'));\nreturn [{ json: { day, calInfo: info, pipelineRows: P.length,\n  shares: { total: shares.length, byOwner: grp(shares, r => r.owner), byDesk: grp(shares, r => desk[r.startup] || '?'), byStartup: grp(shares, r => r.startup), list: shares.map(r => r.startup + ' -> ' + r.investor + ' (' + r.owner + ')') },\n  followups: { total: fus.length, byOwner: grp(fus, x => x.r.owner), byStage: grp(fus, x => x.k), list: fus.map(x => x.k + ' ' + x.r.startup + ' -> ' + x.r.investor) },\n  touchedToday: touched.length, responses: resp,\n  meetingsToday: todayMeet, bookedToday: booked } }];"
      }
    }
