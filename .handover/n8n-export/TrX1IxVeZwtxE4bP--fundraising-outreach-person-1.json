    {
      "id": "c8d9def3-30f1-45fe-a18b-99c4ed7e1895",
      "name": "Decide Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        432
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('CONFIG').first().json;\nconst tpl = $('TEMPLATES').first().json;\nconst tz = cfg.TIMEZONE || \"Asia/Kolkata\";\nconst now = DateTime.now().setZone(tz);\nconst today = now.toFormat(\"yyyy-LL-dd\");\n\nconst norm = (v) => String(v == null ? \"\" : v).trim().toLowerCase();\nconst isYes = (v) => norm(v) === \"yes\" || norm(v) === \"true\" || norm(v) === \"y\";\nconst toList = (s) => String(s || \"\").split(\",\").map(x => x.trim().toLowerCase()).filter(x => x.length > 0);\nconst continueStates = toList(cfg.CONTINUE_STATES);\nconst stopStates = toList(cfg.STOP_STATES);\nconst dealStopStatuses = toList(cfg.DEAL_STOP_STATUSES);\nconst fu1Days = Number(cfg.FOLLOW_UP_1_DAYS || 4);\nconst fu2Days = Number(cfg.FOLLOW_UP_2_DAYS || 7);\nconst fu3Days = Number(cfg.FOLLOW_UP_3_DAYS || 7);\nconst limit = Number(cfg.DAILY_NEW_OUTREACH_LIMIT || 25);\nconst testMode = cfg.TEST_MODE === true || norm(cfg.TEST_MODE) === \"true\";\nconst testEmail = cfg.TEST_EMAIL || \"\";\nconst senderName = cfg.SENDER_NAME || \"\";\n\nconst parseDate = (s) => {\n  if (!s) return null;\n  const str = String(s).trim();\n  let d = DateTime.fromISO(str, { zone: tz });\n  if (!d.isValid) d = DateTime.fromFormat(str, \"yyyy-LL-dd\", { zone: tz });\n  if (!d.isValid) d = DateTime.fromFormat(str, \"dd/LL/yyyy\", { zone: tz });\n  if (!d.isValid) d = DateTime.fromFormat(str, \"LL/dd/yyyy\", { zone: tz });\n  return d.isValid ? d : null;\n};\nconst daysSince = (s) => {\n  const d = parseDate(s);\n  if (!d) return null;\n  return Math.floor(now.startOf(\"day\").diff(d.startOf(\"day\"), \"days\").days);\n};\nconst addDays = (n) => now.plus({ days: n }).toFormat(\"yyyy-LL-dd\");\nconst validEmail = (e) => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(e || \"\").trim());\n\n// Build lookup structures\nconst matchingRows = $(\"Read Matching List\").all().map(i => i.json);\nconst startupRows = $(\"Read Startup Master\").all().map(i => i.json);\nconst matchByDeal = new Set();\nconst matchByPair = new Set();\nfor (const m of matchingRows) {\n  const approved = m.Approved === undefined || isYes(m.Approved);\n  if (!approved) continue;\n  if (m[\"Deal ID\"]) matchByDeal.add(norm(m[\"Deal ID\"]));\n  matchByPair.add(norm(m[\"Startup Name\"]) + \"|\" + norm(m[\"Investor Email\"]));\n}\nconst startupByName = {};\nfor (const s of startupRows) { startupByName[norm(s[\"Startup Name\"])] = s; }\n\nconst REQUIRED_VARS = [\"InvestorName\", \"StartupName\", \"SenderName\"];\nconst render = (tplStr, vars, requiredExtra) => {\n  const missing = [];\n  const required = REQUIRED_VARS.concat(requiredExtra || []);\n  for (const r of required) { if (!vars[r] || String(vars[r]).trim() === \"\") missing.push(r); }\n  const out = String(tplStr || \"\").replace(/\\{\\{\\s*([A-Za-z0-9_]+)\\s*\\}\\}/g, (mm, k) => {\n    return (vars[k] !== undefined && vars[k] !== null) ? String(vars[k]) : \"\";\n  });\n  return { text: out, missing };\n};\n\nconst results = [];\nlet initialCandidates = [];\n\n// Count how many INITIAL sends already happened today (idempotency across runs)\nlet sentToday = 0;\nfor (const it of $(\"Read Deal Tracker\").all()) {\n  const r = it.json;\n  if (isYes(r[\"Deal Shared?\"]) && daysSince(r[\"Date Shared\"]) === 0) sentToday++;\n}\nlet remainingAllowance = Math.max(0, limit - sentToday);\n\nfor (const it of $(\"Read Deal Tracker\").all()) {\n  const row = it.json;\n  const dealId = row[\"Deal ID\"] || \"\";\n  const startupName = row[\"Startup Name\"] || \"\";\n  const investorName = row[\"Investor / VC Name\"] || row[\"Investor Name\"] || \"\";\n  const investorEmail = String(row[\"Investor Email\"] || \"\").trim();\n  const response = norm(row[\"Investor Response\"]);\n  const dealStatus = norm(row[\"Deal Status\"]);\n  const dnc = isYes(row[\"Do Not Contact\"]);\n\n  // 1) STOP STATE? -> skip permanently/temporarily\n  const isStop = dnc || stopStates.includes(response) || dealStopStatuses.includes(dealStatus) ||\n    (response !== \"\" && !continueStates.includes(response));\n  if (isStop) continue;\n\n  const startup = startupByName[norm(startupName)] || null;\n  const vars = {\n    InvestorName: investorName,\n    StartupName: startupName,\n    SenderName: senderName,\n    Sector: startup ? (startup.Sector || \"\") : \"\",\n    Subsector: startup ? (startup.Subsector || \"\") : \"\",\n    FundraiseAmount: startup ? (startup.FundraiseAmount || \"\") : \"\",\n    Stage: startup ? (startup.Stage || \"\") : \"\",\n    KeyHighlight1: startup ? (startup.KeyHighlight1 || \"\") : \"\",\n    KeyHighlight2: startup ? (startup.KeyHighlight2 || \"\") : \"\",\n    KeyHighlight3: startup ? (startup.KeyHighlight3 || \"\") : \"\",\n    DeckLink: startup ? (startup.DeckLink || \"\") : \"\",\n  };\n\n  const errItem = (type, details, extra) => Object.assign({\n    action: \"ERROR\", \"Deal ID\": dealId, owner: cfg.OWNER_NAME,\n    startupName, investorName, investorEmail,\n    errorType: type, errorDetails: details,\n    dateToday: today,\n  }, extra || {});\n\n  const shared = isYes(row[\"Deal Shared?\"]);\n\n  if (!shared) {\n    // ===== INITIAL candidate =====\n    const matchOk = matchByDeal.has(norm(dealId)) || matchByPair.has(norm(startupName) + \"|\" + norm(investorEmail));\n    if (!matchOk) { results.push(errItem(\"Missing match\", \"No approved Startup x Investor match found\")); continue; }\n    if (!validEmail(investorEmail)) { results.push(errItem(\"Invalid email\", \"Investor email missing or invalid: \" + investorEmail)); continue; }\n    if (!startup) { results.push(errItem(\"Missing memo\", \"No Startup Master row for: \" + startupName)); continue; }\n    const subj = render(tpl.INITIAL_SUBJECT, vars, [\"StartupName\"]);\n    const body = render(tpl.INITIAL_BODY, vars, [\"DeckLink\"]);\n    const missing = Array.from(new Set(subj.missing.concat(body.missing)));\n    if (missing.length > 0) { results.push(errItem(\"Missing template variable\", \"Unresolved required vars: \" + missing.join(\", \"))); continue; }\n    initialCandidates.push({\n      action: \"INITIAL\", \"Deal ID\": dealId, owner: cfg.OWNER_NAME,\n      startupName, investorName, investorEmail,\n      sendTo: testMode ? testEmail : investorEmail,\n      emailSubject: subj.text, emailBody: body.text,\n      messageId: \"\", dateToday: today, nextActionDue: addDays(fu1Days),\n      priority: row[\"Priority\"] || \"\",\n    });\n    continue;\n  }\n\n  // ===== Already shared: check follow-ups in priority order =====\n  const sharedAge = daysSince(row[\"Date Shared\"]);\n  if (sharedAge === null) { results.push(errItem(\"Bad date\", \"Deal Shared=Yes but Date Shared is missing/invalid\")); continue; }\n\n  const fu1Done = isYes(row[\"Follow-up 1 Done?\"]);\n  const fu2Done = isYes(row[\"Follow-up 2 Done?\"]);\n  const fu3Done = isYes(row[\"Follow-up 3 Done?\"]);\n  const messageId = String(row[\"Message ID\"] || \"\").trim();\n\n  let action = null; let body = null; let nextAction = \"\"; let nextDue = \"\";\n  if (!fu1Done && sharedAge >= fu1Days) {\n    action = \"FU1\"; body = render(tpl.FU1_BODY, vars); nextAction = \"Follow-up 2\"; nextDue = addDays(fu2Days);\n  } else if (fu1Done && !fu2Done && (daysSince(row[\"Follow-up 1 Date\"]) !== null) && daysSince(row[\"Follow-up 1 Date\"]) >= fu2Days) {\n    action = \"FU2\"; body = render(tpl.FU2_BODY, vars); nextAction = \"Follow-up 3\"; nextDue = addDays(fu3Days);\n  } else if (fu2Done && !fu3Done && (daysSince(row[\"Follow-up 2 Date\"]) !== null) && daysSince(row[\"Follow-up 2 Date\"]) >= fu3Days) {\n    action = \"FU3\"; body = render(tpl.FU3_BODY, vars); nextAction = \"Await investor revert\"; nextDue = \"\";\n  } else {\n    continue; // nothing due\n  }\n\n  if (!startup) { results.push(errItem(\"Missing memo\", \"No Startup Master row for: \" + startupName)); continue; }\n  if (body.missing.length > 0) { results.push(errItem(\"Missing template variable\", \"Unresolved required vars: \" + body.missing.join(\", \"))); continue; }\n  if (!messageId) { results.push(errItem(\"Threading failure\", \"No stored Message ID to reply into thread\")); continue; }\n\n  results.push({\n    action, \"Deal ID\": dealId, owner: cfg.OWNER_NAME,\n    startupName, investorName, investorEmail,\n    sendTo: testMode ? testEmail : investorEmail,\n    emailSubject: \"\", emailBody: body.text,\n    messageId, dateToday: today, nextAction, nextActionDue: nextDue,\n  });\n}\n\n// Apply daily new-outreach limit (follow-ups are NOT limited)\nconst allowedInitials = initialCandidates.slice(0, remainingAllowance);\nfor (const c of allowedInitials) results.push(c);\n\nreturn results.map(r => ({ json: r }));"
      }
    },
