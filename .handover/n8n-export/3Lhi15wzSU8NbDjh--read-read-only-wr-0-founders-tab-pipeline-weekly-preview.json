      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s = (v) => String(v == null ? '' : v).trim();\nconst low = (v) => s(v).toLowerCase();\nconst FROM = '2026-09-01', TO = '2026-09-30';\nconst inMonth = (d) => { d = s(d); return /^\\d{4}-\\d{2}-\\d{2}$/.test(d) && d >= FROM && d <= TO; };\nconst isYes = (x) => low(x) === 'yes';\nconst monthNew = [], monthFu = [], lifetimeShared = [];\nlet fuCount = 0;\nfor (const it of $input.all()) {\n  const r = it.json;\n  if (low(r.startup) !== 'mindwox') continue;\n  const inv = s(r.investor);\n  if (isYes(r.deal_shared)) lifetimeShared.push(low(inv));\n  if (inMonth(r.date_shared)) monthNew.push({ investor: inv, date: s(r.date_shared) });\n  const fus = ['fu1_date', 'fu2_date', 'fu3_date'].filter((c) => inMonth(r[c])).map((c) => s(r[c]));\n  if (fus.length) { monthFu.push({ investor: inv, dates: fus }); fuCount += fus.length; }\n}\nmonthNew.sort((a, b) => a.date.localeCompare(b.date));\nreturn [{ json: { startup: 'MindWox', month: FROM + ' .. ' + TO, total_reached_till_date_unique: Array.from(new Set(lifetimeShared)).length, month_new_investors: monthNew.length, month_new_list: monthNew, month_followups_total: fuCount, month_followup_investors: monthFu.length, month_followup_list: monthFu } }];"
      }
    }
