        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const p=$('Prep').first().json;\nconst npt=String($('Split').first().json.nextPageToken||'');\nconst RX=/[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/g;\nconst map={};let scanned=0;\nfor(const it of $input.all()){const m=it.json||{};if(!m.payload){continue;}scanned++;\n  const H={};(m.payload.headers||[]).forEach(h=>H[String(h.name).toLowerCase()]=h.value);\n  const ts=Number(m.internalDate||0);if(!ts){continue;}\n  const subj=String(H.subject||'');\n  const line=[H.to,H.cc,H.bcc].filter(Boolean).join(', ');\n  const hits=String(line).match(RX)||[];\n  for(const raw of hits){const a=raw.toLowerCase();\n    if(/@sidanaventures\\.com$/.test(a)){continue;}\n    const cur=map[a];\n    if(!cur||ts<cur.ts){map[a]={e:a,ts:ts,th:String(m.threadId||''),mb:p.mb,subj:subj.slice(0,80)};}\n  }\n}\nconst rows=Object.values(map).sort((x,y)=>x.ts-y.ts).map(r=>({e:r.e,d:new Date(r.ts).toISOString().slice(0,10),ts:r.ts,th:r.th,mb:r.mb}));\nreturn [{json:{mb:p.mb,q:p.q,messages_scanned:scanned,distinct_recipients:rows.length,nextPageToken:npt,rows:rows}}];"
        }
