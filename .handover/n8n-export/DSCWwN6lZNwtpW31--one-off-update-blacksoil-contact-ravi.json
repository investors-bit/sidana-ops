      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const NEW_CONTACT = 'Ravi';\nconst NEW_EMAIL = 'ravisaikrishna@blacksoil.co.in';\nconst hit = (s) => /blacksoil/i.test(String(s || ''));\nconst out = [];\nfor (const r of $('Read INVESTORS').all()) {\n  if (hit(r.json.investor) || hit(r.json.email)) {\n    out.push({ json: { investor: r.json.investor, contact_person: NEW_CONTACT, email: NEW_EMAIL } });\n  }\n}\nif (out.length === 0) { throw new Error('No BlackSoil row found in INVESTORS - aborting'); }\nreturn out;"
      }
    },
