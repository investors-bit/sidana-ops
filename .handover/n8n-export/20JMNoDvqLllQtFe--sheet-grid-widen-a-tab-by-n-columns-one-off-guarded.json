    {
      "id": "pr",
      "name": "Prep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};\nif(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!b.tab){throw new Error('missing tab');}\nconst n=parseInt(b.add_columns,10);\nif(!(n>0&&n<=20)){throw new Error('add_columns must be 1..20');}\nreturn [{json:{tab:b.tab,n:n,sheet:b.sheet||'1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4'}}];"
      }
    },
    {
      "id": "gm",
      "name": "Get meta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $json.sheet + '?fields=sheets.properties' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "bd",
      "name": "Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Prep').first().json;\nconst res=$input.first().json;\nif(res.statusCode!==200){throw new Error('meta read failed: '+res.statusCode+' '+JSON.stringify(res.body).slice(0,200));}\nconst sheets=(res.body.sheets||[]).map(function(s){return s.properties;});\nconst t=sheets.filter(function(s){return String(s.title)===String(p.tab);})[0];\nif(!t){throw new Error('tab not found: '+p.tab+' | have: '+sheets.map(function(s){return s.title;}).join(', '));}\nconst before=t.gridProperties.columnCount;\nreturn [{json:{url:'https://sheets.googleapis.com/v4/spreadsheets/'+p.sheet+':batchUpdate',\n  tab:p.tab, sheetId:t.sheetId, columns_before:before, columns_after:before+p.n,\n  body:{requests:[{appendDimension:{sheetId:t.sheetId,dimension:'COLUMNS',length:p.n}}]}}}];"
      }
    },
    {
      "id": "wr",
      "name": "Widen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "isXhjjhrsdp60dv1",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "ot",
      "name": "Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Build').first().json;\nconst r=$input.first().json;\nreturn [{json:{tab:b.tab, sheetId:b.sheetId, columns_before:b.columns_before, columns_after:b.columns_after, status:r.statusCode, ok:(r.statusCode>=200&&r.statusCode<300), error:(r.statusCode>=300?JSON.stringify(r.body).slice(0,300):null)}}];"
      }
    }
