        "jsCode": "const b=$('Webhook').first().json.body||{};if(b.secret!=='sv-ask-2026-09-17-Wm3'){throw new Error('bad secret');}\nconst rows=b.rows||[];if(!Array.isArray(rows)||rows.length<2||rows.length>200||rows[0][0]!=='ask_id'){throw new Error('bad rows');}\nreturn [{json:{n:rows.length}}];"
