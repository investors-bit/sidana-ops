      {
        "id": "mt",
        "name": "Match bookings",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1460,
          290
        ],
        "parameters": {
          "jsCode": "// Matches calendar events to onboarding recipients by ATTENDEE EMAIL ADDRESS.\n// Never by title text - a Calendly booking carries no firm name in its summary.\nconst vr=$json.valueRanges||[];\nconst rows=((vr[0]&&(vr[0].valueRange||vr[0]).values)||[]);\nif(!rows.length) return [{json:{abort:true,reason:'ONBOARDING empty'}}];\nconst H=rows[0].map(x=>String(x||'').trim());\nconst L=H.map(x=>x.toLowerCase());\nconst C=n=>L.indexOf(n);\nconst cE=C('email'),cF=C('firm'),cS=C('status'),cSent=C('sent_date'),cMB=C('meeting_booked'),cNotes=C('notes');\nif(cE<0||cMB<0) return [{json:{abort:true,reason:'columns not found',H}}];\nconst colLetter=n=>{let s='';while(n>=0){s=String.fromCharCode(65+(n%26))+s;n=Math.floor(n/26)-1;}return s;};\nconst MBCOL=colLetter(cMB);\n\n// gather every event from the four calendars\nconst events=[];\nfor(const n of ['Cal A','Cal B','Cal C','Cal D']){\n  let j=null; try{ j=$(n).first().json; }catch(e){ continue; }\n  const items=(j&&j.items)||[];\n  for(const ev of items){\n    if(String(ev.status||'')==='cancelled') continue;\n    const start=(ev.start&&(ev.start.dateTime||ev.start.date))||'';\n    const who=new Set();\n    for(const a of (ev.attendees||[])){ const e=String(a.email||'').toLowerCase().trim(); if(e) who.add(e); }\n    const org=String((ev.organizer&&ev.organizer.email)||'').toLowerCase().trim(); if(org) who.add(org);\n    const cre=String((ev.creator&&ev.creator.email)||'').toLowerCase().trim(); if(cre) who.add(cre);\n    events.push({id:ev.id,summary:String(ev.summary||''),start,who:[...who]});\n  }\n}\n// index: attendee address -> earliest event\nconst byAddr=new Map();\nfor(const ev of events){ for(const e of ev.who){\n  if(e.endsWith('@sidanaventures.com')) continue;   // our own people are on every event\n  const prev=byAddr.get(e);\n  if(!prev || String(ev.start) < String(prev.start)) byAddr.set(e,ev);\n}}\n\nconst data=[]; const matched=[]; const alreadyFlagged=[];\nlet sentRows=0;\nfor(let i=1;i<rows.length;i++){\n  const r=rows[i]||[];\n  const st=String(r[cS]||'').trim().toUpperCase();\n  if(st!=='SENT'&&st!=='ONBOARDED') continue;\n  sentRows++;\n  const em=String(r[cE]||'').trim().toLowerCase();\n  if(!em) continue;\n  const ev=byAddr.get(em);\n  if(!ev) continue;\n  const cur=String(r[cMB]==null?'':r[cMB]).trim();\n  if(cur){ alreadyFlagged.push({firm:String(r[cF]||''),email:em,existing:cur}); continue; }\n  const day=String(ev.start).slice(0,10);\n  data.push({range:'ONBOARDING!'+MBCOL+(i+1),values:[[day+' | '+ev.summary.slice(0,60)]]});\n  matched.push({row:i+1,firm:String(r[cF]||''),email:em,meetingOn:day,event:ev.summary.slice(0,70)});\n}\nreturn [{json:{abort:data.length===0, sentRowsChecked:sentRows, calendarEvents:events.length,\n  externalAttendees:byAddr.size, newlyMatched:matched.length, alreadyFlagged:alreadyFlagged.length,\n  matched, body:{valueInputOption:'RAW',data}}}];"
        }
      },
