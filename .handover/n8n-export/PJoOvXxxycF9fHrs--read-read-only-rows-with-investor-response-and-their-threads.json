        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst cols = Object.keys(rows[0] || {});\nconst hasDateCol = cols.some(function (c) { return c.toLowerCase().indexOf('response_date') >= 0 || c.toLowerCase().indexOf('response date') >= 0; });\n\nconst resp = rows.filter(function (r) { return s(r.investor_response) !== ''; });\nconst withThread = resp.filter(function (r) { return s(r.thread_id) !== ''; });\n\nconst byResp = {};\nfor (const r of resp) { const k = s(r.investor_response); byResp[k] = (byResp[k] || 0) + 1; }\n\nreturn [{ json: {\n  total_rows: rows.length,\n  existing_columns: cols,\n  response_date_column_exists: hasDateCol,\n  rows_with_investor_response: resp.length,\n  of_those_with_thread_id: withThread.length,\n  of_those_WITHOUT_thread_id: resp.length - withThread.length,\n  response_values: byResp,\n  sample: resp.slice(0, 12).map(function (r) {\n    return { deal_id: s(r.deal_id), investor: s(r.investor), startup: s(r.startup),\n             investor_response: s(r.investor_response), last_contact: s(r.last_contact),\n             thread_id: s(r.thread_id) ? 'yes' : 'NO' };\n  })\n}}];"
      }
    }
