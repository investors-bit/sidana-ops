      "id": "cd1",
      "name": "Find rows to pause",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TARGETS = [\n  { investor: 'kaizenvest', startup: 'appli',    why: 'Already shared - meeting held 26-05-26 (Deal Tracker)' },\n  { investor: 'kaizenvest', startup: 'orbit ai', why: 'Already shared - meeting 27-05-26, investor PASSED: too early for mandate (Deal Tracker)' }\n];\n\nconst existing = $input.all().map(function (i) { return i.json; });\nif (existing.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + existing.length + ' rows'); }\n\nconst out = [];\nfor (const t of TARGETS) {\n  const hits = existing.filter(function (r) {\n    return String(r.investor == null ? '' : r.investor).trim().toLowerCase() === t.investor\n        && String(r.startup  == null ? '' : r.startup ).trim().toLowerCase() === t.startup;\n  });\n  if (hits.length === 0) { throw new Error('ABORT: no PIPELINE row for ' + t.investor + ' <> ' + t.startup); }\n  for (const h of hits) {\n    if (String(h.deal_shared == null ? '' : h.deal_shared).trim().toLowerCase() === 'yes') {\n      throw new Error('ABORT: ' + h.deal_id + ' already has deal_shared=Yes - refusing to touch a sent row');\n    }\n    if (String(h.pause == null ? '' : h.pause).trim() !== '') { continue; }\n    out.push({ json: { deal_id: h.deal_id, pause: 'Yes', notes: t.why } });\n  }\n}\n\nif (out.length === 0) { throw new Error('ABORT: nothing to pause - already done?'); }\nif (out.length > 5) { throw new Error('ABORT: ' + out.length + ' rows exceeds guard of 5'); }\nreturn out;"
      }
    },
