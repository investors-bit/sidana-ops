        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst stripRe = /\\s*If the opportunity fits[\\s\\S]*?fundraising round\\.\\s*/i;\nconst closeRe = /investment mandate|arrange a discussion|happy to arrange/i;\nconst out = [];\nfor (const r of rows) {\n  const memo = String(r.memo_html || '');\n  if (!closeRe.test(memo)) continue;      // only the flagged ones\n  if (!stripRe.test(memo)) continue;      // safety: skip if rule no longer matches\n  const stripped = memo.replace(stripRe, ' ');\n  if (stripped === memo) continue;        // no change -> skip\n  out.push({ json: { startup: r.startup, memo_html: stripped } });\n}\nreturn out;"
      }
    },
