  "nodes": [
    {
      "id": "wh",
      "name": "Webhook",
      "webhookId": "1c6830c3-3f32-43c3-bcb1-81cf6f163f37",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "onb-fu-write-3d81f6",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson",
        "options": {}
      }
    },
    {
      "id": "bd",
      "name": "Build payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};\nif(b.secret!=='onb-fu-2026-09-30-Rz4'){throw new Error('bad secret');}\nconst ALLOWED={'AB':'sent_date','AM':'fu1_done','AN':'fu1_date','AO':'fu2_done','AP':'fu2_date'};\nconst col=String(b.col||'').toUpperCase();\nif(!ALLOWED[col]){throw new Error('column '+col+' not writable by this workflow; allowed: '+Object.keys(ALLOWED).join(','));}\nconst ups=Array.isArray(b.updates)?b.updates:[];\nif(!ups.length){throw new Error('no updates');}\nif(ups.length>300){throw new Error('too many updates in one call: '+ups.length);}\nconst data=[];const seen={};\nfor(const u of ups){\n  const row=Number(u.row);\n  if(!Number.isInteger(row)||row<2||row>900){throw new Error('bad row '+u.row);}\n  if(seen[row]){throw new Error('duplicate row '+row);}\n  seen[row]=1;\n  const v=String(u.value==null?'':u.value);\n  if(v.length>40){throw new Error('value too long for row '+row);}\n  if(col==='AB'&&v&&!/^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}:\\d{2})?$/.test(v)){throw new Error('row '+row+': sent_date must be YYYY-MM-DD[ HH:MM:SS], got '+v);}\n  if((col==='AN'||col==='AP')&&v&&!/^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}:\\d{2})?$/.test(v)){throw new Error('row '+row+': date column must be YYYY-MM-DD[ HH:MM:SS], got '+v);}\n  data.push({range:'ONBOARDING!'+col+row,values:[[v]]});\n}\nconst vio=(String(b.vio||'RAW').toUpperCase()==='USER_ENTERED')?'USER_ENTERED':'RAW';\nconst body={valueInputOption:vio,data:data};\nif(b.dry!==false){return [{json:{mode:'DRY_OK',vio:vio,column:col+' ('+ALLOWED[col]+')',cells:data.length,firstRange:data[0].range,lastRange:data[data.length-1].range,sampleValues:data.slice(0,3).map(d=>d.range+'='+d.values[0][0]),willWrite:false}}];}\nreturn [{json:{mode:'LIVE',vio:vio,column:col+' ('+ALLOWED[col]+')',cells:data.length,willWrite:true,payload:JSON.stringify(body)}}];"
      }
    },
    {
      "id": "ifw",
      "name": "Write?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2,
            "typeValidation": "loose"
          },
          "combinator": "and",
