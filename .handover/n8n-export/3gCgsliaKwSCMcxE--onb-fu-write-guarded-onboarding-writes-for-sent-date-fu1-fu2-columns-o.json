        "jsCode": "const b=$('Build payload').first().json;const r=$input.first().json;return [{json:{mode:'WRITTEN',column:b.column,cellsRequested:b.cells,totalUpdatedCells:r.totalUpdatedCells,totalUpdatedRows:r.totalUpdatedRows,totalUpdatedSheets:r.totalUpdatedSheets}}];"
      }
    },
