        "jsCode": "const TODAY = '2026-09-02';\nconst rows = $input.all().map(i => i.json);\nconst out = [];\nfor (const r of rows) {\n  if (String(r.date_shared || '').trim() !== TODAY) continue;\n  out.push({ json: {\n    deal_id: r.deal_id,\n    owner: r.owner,\n    startup: r.startup,\n    investor: r.investor,\n    last_contact: r.last_contact,\n    deal_shared: r.deal_shared,\n    date_shared: r.date_shared,\n    channel: r.channel,\n    thread_id: r.thread_id,\n    message_id: r.message_id,\n    next_action: r.next_action,\n    next_due: r.next_due,\n  }});\n}\nreturn out;"
