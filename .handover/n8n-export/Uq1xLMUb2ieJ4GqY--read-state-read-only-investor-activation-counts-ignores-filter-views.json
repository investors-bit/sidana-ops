      "parameters": {
        "jsCode": "const R = $json.valueRanges || [];\nconst pick = (n) => (R.find(x => String(x.range||'').indexOf(n) === 0) || {}).values || [];\nconst crit = pick('INVESTOR_CRITERIA');\nconst inv  = pick('INVESTORS!');\nconst g = (row,i) => (row && row[i] != null) ? String(row[i]).trim() : '';\nconst cm = {};\nfor (let i = 1; i < crit.length; i++) { const k = g(crit[i],0); if (k) cm[k] = crit[i]; }\nconst out = [108,142,221].map(n => { const r = inv[n-1]; const c = cm[String(n)];\n  return { row: n, investor: g(r,0), contact: g(r,1), email: g(r,2), sector: g(r,4).slice(0,60), stage: g(r,5), cheque: g(r,6), last_contacted: g(r,7), by: g(r,8), dnc: g(r,9) || '-',\n    crit_status: c ? g(c,3) : 'NO CRIT ROW', crit_confirmed: c ? g(c,4) : '-', review_reason: c ? g(c,5).slice(0,140) : '', stage_min: c ? g(c,11) : '', stage_max: c ? g(c,12) : '', geo: c ? g(c,19) : '' }; });\nreturn [{ json: { rows: out } }];"
      }
    }
