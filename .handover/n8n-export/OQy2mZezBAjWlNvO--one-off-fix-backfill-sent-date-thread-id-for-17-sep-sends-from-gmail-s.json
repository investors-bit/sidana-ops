    {
      "id": "a7000001-0000-4000-8000-000000000006",
      "name": "Match to rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const sheet = $('Read Onboarding sheet').all().map(i => i.json);\nconst keys = Object.keys(sheet[0] || {}).filter(k => k !== 'row_number');\nconst col = name => { const i = keys.indexOf(name); if (i < 0) throw new Error('column not found: ' + name); return i; };\nconst C_SENT = col('sent_date'), C_THREAD = col('thread_id');\nconst msgs = $('Get headers').all().map(i => i.json);\nconst PREFIX = 'Introducing Sidana Ventures - co-investment and curated dealflow for ';\nconst data = [];\nconst rows = [];\nconst cell = (r, c, v) => ({ dataFilter: { gridRange: { sheetId: 38341156, startRowIndex: r - 1, endRowIndex: r, startColumnIndex: c, endColumnIndex: c + 1 } }, majorDimension: 'ROWS', values: [[v]] });\nfor (const m of msgs) {\n  const h = {};\n  for (const x of (m.payload && m.payload.headers) || []) h[x.name.toLowerCase()] = x.value;\n  const subj = String(h.subject || '');\n  if (!subj.startsWith(PREFIX)) continue;\n  const firm = subj.slice(PREFIX.length).trim();\n  const row = sheet.find(r => String(r.firm).trim() === firm && String(r.status).trim() === 'SENT');\n  if (!row) continue;\n  const when = new Date(Number(m.internalDate)).toLocaleString('sv-SE', { timeZone: 'Asia/Kolkata' });\n  data.push(cell(row.row_number, C_SENT, when));\n  data.push(cell(row.row_number, C_THREAD, m.threadId));\n  rows.push([row.row_number, firm, when, m.threadId].join(' | '));\n}\nreturn [{ json: { cols: { sent_date: C_SENT, thread_id: C_THREAD }, rows, body: { valueInputOption: 'RAW', data } } }];"
      }
    },
    {
