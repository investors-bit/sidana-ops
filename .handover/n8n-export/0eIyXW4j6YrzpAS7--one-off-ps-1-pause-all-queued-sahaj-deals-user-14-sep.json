      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nfunction colLetter(i) { let n = i + 1, out = ''; while (n > 0) { const m = (n - 1) % 26; out = String.fromCharCode(65 + m) + out; n = Math.floor((n - 1) / 26); } return out; }\nconst yes = function (x) { return s(x).toLowerCase() === 'yes'; };\nconst hdr = (($('GET header').first().json.values || [[]])[0] || []).map(s);\nconst C = {}; for (const h of ['pause', 'next_action', 'notes']) { const i = hdr.indexOf(h); if (i < 0) { throw new Error('ABORT: PIPELINE column missing ' + h); } C[h] = colLetter(i); }\nconst pipe = $input.all().map(function (i) { return i.json; });\nif (pipe.length < 5200) { throw new Error('ABORT: PIPELINE only ' + pipe.length); }\nconst data = [], paused = [], sentToday = [];\nfor (const p of pipe) { if (nz(p.startup) !== 'sahaj') { continue; }\n  if (yes(p.deal_shared)) { if (s(p.date_shared).slice(0, 10) === '2026-09-14') { sentToday.push([s(p.deal_id), s(p.investor), s(p.date_shared)]); } continue; }\n  if (yes(p.pause)) { continue; }\n  const rn = p.row_number; const n = s(p.notes);\n  data.push({ range: 'PIPELINE!' + C.pause + rn, values: [['Yes']] }, { range: 'PIPELINE!' + C.next_action + rn, values: [['PAUSED - startup paused by user 14 Sep']] },\n    { range: 'PIPELINE!' + C.notes + rn, values: [[(n ? n + ' | ' : '') + 'PAUSED 2026-09-14 - Sahaj deal sharing paused by the user']] });\n  paused.push([rn, s(p.deal_id), s(p.investor), s(p.next_due)]); }\nif (!data.length) { data.push({ range: 'PIPELINE!' + C.pause + '1', values: [['pause']] }); }\nreturn [{ json: { to_pause: paused.length, paused: paused, already_sent_today: sentToday, data: data } }];"
      }
    },
