        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nconst yes = function (x) { return s(x).toLowerCase() === 'yes'; };\nconst plan = $('Plan').first().json;\nconst pipe = $input.all().map(function (i) { return i.json; });\nconst still = pipe.filter(function (p) { return nz(p.startup) === 'sahaj' && !yes(p.deal_shared) && !yes(p.pause); }).map(function (p) { return [s(p.deal_id), s(p.investor)]; });\nconst sent = pipe.filter(function (p) { return nz(p.startup) === 'sahaj' && yes(p.deal_shared); }).length;\nreturn [{ json: { paused_now: plan.to_pause, still_active: still, sahaj_sent_total: sent, already_sent_today: plan.already_sent_today, ok: still.length === 0 } }];"
