    {
      "id": "cdB",
      "name": "Sent no-reply to pause",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Already-sent L'Oreal rows: stop remaining follow-ups, but keep the row and its thread\n// so any reply still gets matched. Rows carrying an investor_response are left untouched.\nconst INV = \"L'Oreal Venture Capital\";\nfunction s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst out = [];\nfor (const r of rows) {\n  if (s(r.investor) !== INV) { continue; }\n  if (s(r.deal_shared).toLowerCase() !== 'yes') { continue; }\n  if (s(r.investor_response) !== '') { continue; }\n  if (s(r.pause) !== '') { continue; }\n  const prev = s(r.notes);\n  out.push({ json: {\n    deal_id: s(r.deal_id),\n    pause: 'Yes',\n    next_action: \"Stopped - below L'Oreal traction bar\",\n    notes: (prev ? prev + ' | ' : '') + \"Follow-ups stopped 2026-09-08: L'Oreal requires $1-10M traction; no current portfolio company qualifies\"\n  }});\n}\nif (out.length === 0) { return []; }\nif (out.length > 40) { throw new Error('ABORT: ' + out.length + ' exceeds guard of 40'); }\nreturn out;"
      }
    },
