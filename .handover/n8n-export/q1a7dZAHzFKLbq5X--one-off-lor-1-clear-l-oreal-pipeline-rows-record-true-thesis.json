      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// L'Oreal's real thesis needs $1-10M traction; the best revenue in the book is ~2.2 Cr (~$260K),\n// roughly 4x below their floor. So no current startup qualifies -> clear the unsent rows.\n// Sent rows are handled separately: deleting them would destroy thread_id and blind reply detection.\nconst INV = \"L'Oreal Venture Capital\";\nfunction s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\n\nconst mine = rows.filter(function (r) { return s(r.investor) === INV; });\nif (mine.length > 100) { throw new Error('ABORT: ' + mine.length + \" L'Oreal rows exceeds guard of 100\"); }\n\nconst del = mine.filter(function (r) {\n  return s(r.deal_shared).toLowerCase() !== 'yes' && s(r.pause) === '';\n});\nif (del.length === 0) { return []; }\nfor (const r of del) { if (!r.row_number) { throw new Error('ABORT: missing row_number'); } }\n\nconst out = del.map(function (r) {\n  return { json: { row_number: Number(r.row_number), deal_id: s(r.deal_id), startup: s(r.startup) } };\n});\nout.sort(function (a, b) { return b.json.row_number - a.json.row_number; });\nreturn out;"
      }
    },
