    {
      "id": "n3",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const hit = (s) => /cosmic\\s*port/i.test(String(s || ''));\n\nconst st = [];\nfor (const s of $('Read STARTUPS').all()) {\n  if (hit(s.json.startup)) { st.push({ row_number: s.json.row_number, startup: s.json.startup, owner: s.json.owner, active: s.json.active, raise: s.json.raise_inr_cr }); }\n}\n\nconst pipe = [];\nlet sent = 0, replied = 0, notSent = 0;\nfor (const p of $('Read PIPELINE').all()) {\n  if (!hit(p.json.startup)) continue;\n  const shared = String(p.json.deal_shared || '').trim().toLowerCase() === 'yes';\n  const resp = String(p.json.investor_response || '').trim();\n  if (shared) { sent++; } else { notSent++; }\n  if (resp !== '') { replied++; }\n  pipe.push({\n    row_number: p.json.row_number,\n    deal_id: p.json.deal_id,\n    owner: p.json.owner,\n    investor: p.json.investor,\n    email: p.json.email,\n    deal_shared: p.json.deal_shared,\n    date_shared: p.json.date_shared,\n    next_action: p.json.next_action,\n    next_due: p.json.next_due,\n    investor_response: resp,\n    deal_status: p.json.deal_status,\n  });\n}\n\nreturn [{ json: {\n  startups_matches: st,\n  pipeline_total: pipe.length,\n  already_sent: sent,\n  never_sent: notSent,\n  with_reply: replied,\n  pipeline_rows: pipe,\n} }];"
      }
    }
