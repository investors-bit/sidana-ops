        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst inv = $input.all().map(function (i) { return i.json; });\nconst dnc = inv.filter(function (r) { return s(r.do_not_contact) !== ''; }).map(function (r) { return [r.row_number, s(r.investor), s(r.email), s(r.do_not_contact)]; });\nconst debt = inv.filter(function (r) { return /debt/i.test(s(r.investor) + ' ' + s(r.sector) + ' ' + s(r.stage)) || /northern ?arc|blacksoil|coin-?age|debtworks|stride|innoven|capwise|epsilonx/i.test(s(r.investor)); }).map(function (r) { return [r.row_number, s(r.investor), s(r.do_not_contact)]; });\nreturn [{ json: { investors_rows: inv.length, dnc_count: dnc.length, dnc_rows: dnc, debt_investors_never_matched: debt } }];"
