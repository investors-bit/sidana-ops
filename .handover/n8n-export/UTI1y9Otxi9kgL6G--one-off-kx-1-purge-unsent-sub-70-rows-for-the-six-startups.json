    {
      "id": "c1",
      "name": "Pick rows to purge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nconst SIX = ['nexcore', 'recex', 'washtro', 'formverse', 'pixelence', 'doffair'];\n\nconst pipe = $input.all().map(function (i) { return i.json; });\nif (pipe.length < 500) { throw new Error('ABORT: PIPELINE only ' + pipe.length); }\n\nconst kill = [];\nconst kept = { sent: 0, at70: 0, no_priority: 0 };\nfor (const p of pipe) {\n  if (SIX.indexOf(nz(p.startup)) < 0) { continue; }\n  if (s(p.deal_shared).toLowerCase() === 'yes') { kept.sent++; continue; }   // never touch anything shared\n  const raw = s(p.priority);\n  if (raw === '') { kept.no_priority++; continue; }                          // unscored -> leave alone\n  const pr = parseFloat(raw);\n  if (isNaN(pr)) { kept.no_priority++; continue; }\n  if (pr >= 70) { kept.at70++; continue; }\n  kill.push({ row_number: p.row_number, deal_id: s(p.deal_id), startup: s(p.startup),\n    investor: s(p.investor), priority: pr, pause: s(p.pause) });\n}\n\nif (kill.length === 0) { throw new Error('NOTHING TO DO: no unsent sub-70 rows for the six'); }\nif (kill.length > 250) { throw new Error('ABORT: ' + kill.length + ' rows exceeds guard of 250'); }\n\n// deletes MUST run highest row first, or every later row_number shifts under us\nkill.sort(function (a, b) { return b.row_number - a.row_number; });\n\nconst byStartup = {};\nfor (const k of kill) { byStartup[k.startup] = (byStartup[k.startup] || 0) + 1; }\nconsole.log('purging ' + kill.length + ' rows', JSON.stringify(byStartup), 'kept', JSON.stringify(kept));\nreturn kill.map(function (k) { return { json: k }; });"
      }
    },
