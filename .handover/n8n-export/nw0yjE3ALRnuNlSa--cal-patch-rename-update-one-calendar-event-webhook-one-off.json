        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nif(!b.event_id){throw new Error('event_id required');}\nconst patch={};if(b.summary){patch.summary=b.summary;}if(b.description!==undefined){patch.description=b.description;}\nif(!Object.keys(patch).length){throw new Error('nothing to patch');}\nif(b.dry!==false){throw new Error('DRY OK | '+b.event_id+' | '+JSON.stringify(patch));}\nreturn [{json:{event_id:b.event_id,patch:patch}}];"
      }
    },
