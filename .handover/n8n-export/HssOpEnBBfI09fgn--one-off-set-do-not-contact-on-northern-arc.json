      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nfor (const v of $('Read INVESTORS').all()) {\n  const name = String(v.json.investor || '').trim();\n  if (!/northern\\s*arc/i.test(name)) { continue; }\n  out.push({ json: { investor: name, do_not_contact: 'yes' } });\n}\nif (out.length === 0) { throw new Error('NORTHERN ARC not found in INVESTORS - aborting'); }\nreturn out;"
      }
