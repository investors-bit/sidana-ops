        800,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v){return String(v==null?'':v).trim();}\nconst vr=$('GET pilot').first().json.valueRanges||[];\nconst pipe=(vr[0]||{}).values||[];const h=(pipe[0]||[]).map(s);const X={};h.forEach((k,i)=>X[k]=i);\nconst sample=[];for(const r of [1,2,pipe.length-2,pipe.length-1]){const row=pipe[r]||[];const o={};h.forEach((k,i)=>{o[k]=s(row[i]).slice(0,80);});sample.push(o);}\n// queue shape: unsent unpaused rows by next_due and owner\nconst byDay={};const naVals={};const pauseVals={};const sharedVals={};let maxId='';\nfor(let r=1;r<pipe.length;r++){const row=pipe[r]||[];const na=s(row[X.next_action]);naVals[na.slice(0,40)]=(naVals[na.slice(0,40)]||0)+1;pauseVals[s(row[X.pause])]=(pauseVals[s(row[X.pause])]||0)+1;sharedVals[s(row[X.deal_shared])]=(sharedVals[s(row[X.deal_shared])]||0)+1;\n const id=s(row[X.deal_id]);if(id>maxId)maxId=id;\n if(!/^yes$/i.test(s(row[X.deal_shared]))&&!/^yes$/i.test(s(row[X.pause]))){const d=s(row[X.next_due]).slice(0,10);const k=d+' '+s(row[X.owner]);byDay[k]=(byDay[k]||0)+1;}}\nconst days=Object.keys(byDay).sort().slice(0,120).map(k=>k+'='+byDay[k]);\nreturn [{json:{pipeline_rows:pipe.length,header:h,sample,maxId,next_action_values:naVals,pause_values:pauseVals,deal_shared_values:sharedVals,queue_by_day_owner:days,investors_hdr:((vr[1]||{}).values||[]),startups_hdr:((vr[2]||{}).values||[]),errorlog:((vr[3]||{}).values||[]),config:((vr[4]||{}).values||[]),runlog:((vr[5]||{}).values||[]),tracker_tabs:$('GET tracker meta').first().json.sheets.map(x=>x.properties.sheetId+':'+x.properties.title),pilot_tabs:$('GET pilot meta').first().json.sheets.map(x=>x.properties.sheetId+':'+x.properties.title+':'+x.properties.gridProperties.rowCount+'x'+x.properties.gridProperties.columnCount)}}];"
      }
    }
