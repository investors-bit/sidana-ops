      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}if(b.mb!=='3'){throw new Error('mailbox 3 only');}\nconst re=/^[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$/;const norm=v=>(Array.isArray(v)?v:String(v||'').split(',')).map(x=>String(x).trim().toLowerCase()).filter(Boolean).join(', ');const to=norm(b.to);if(!to||!to.split(', ').every(x=>re.test(x))){throw new Error('bad to');}if(norm(b.confirm_to)!==to){throw new Error('confirm_to mismatch');}\nif(!b.subject||!b.html){throw new Error('missing subject/html');}\nconst b64=Buffer.from(b.html,'utf8').toString('base64').replace(/(.{76})/g,'$1\\r\\n');\nconst mime=['From: Aditya SV <investors@sidanaventures.com>','To: '+to,(b.cc?'Cc: '+b.cc:'X-Sidana: 1'),'Subject: =?UTF-8?B?'+Buffer.from(b.subject,'utf8').toString('base64')+'?=','MIME-Version: 1.0','Content-Type: text/html; charset=\"UTF-8\"','Content-Transfer-Encoding: base64','',b64].join('\\r\\n');\nconst raw=Buffer.from(mime,'utf8').toString('base64').replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');\nif(b.dry!==false){throw new Error('DRY OK | to='+to+' | cc='+(b.cc||'')+' | subject='+b.subject+' | htmlLen='+b.html.length);}\nreturn [{json:{to:to,subject:b.subject,raw:raw}}];"
      }
    },
