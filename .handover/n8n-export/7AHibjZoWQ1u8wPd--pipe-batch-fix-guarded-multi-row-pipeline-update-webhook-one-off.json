      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$('Webhook').first().json.body||{};if(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nconst v=$input.first().json.values||[];const h=v[0].map(x=>String(x).trim());\nconst L=i=>{let n=i+1,t='';while(n>0){const m=(n-1)%26;t=String.fromCharCode(65+m)+t;n=Math.floor((n-1)/26);}return t;};\nconst data=[];const errs=[];\nfor(const u of (b.rows||[])){const r=v[u.row-1]||[];const g=k=>String(r[h.indexOf(k)]||'').trim();\n if(g('deal_id')!==u.deal_id){errs.push(u.row+' is '+g('deal_id'));continue;}\n if(/^yes$/i.test(g('deal_shared'))&&!b.allow_sent){errs.push(u.row+' already sent');continue;}\n if(u.expect_next_action!==undefined&&g('next_action')!==u.expect_next_action){errs.push(u.row+' next_action '+g('next_action'));continue;}\n for(const k of Object.keys(u.set||{})){const i=h.indexOf(k);if(i<0){throw new Error('no column '+k);}let val=u.set[k];if(k==='notes'&&u.append_notes){val=(g('notes')?g('notes')+' | ':'')+val;}data.push({range:'PIPELINE!'+L(i)+u.row,values:[[val]]});}}\nlet maxId=0;v.forEach(r=>{const m=String(r[0]||'').match(/^D(\\d+)$/);if(m){maxId=Math.max(maxId,+m[1]);}});\nlet next=v.length+1;const added=[];const appendRows=[];\nfor(const a of (b.appends||[])){const dup=v.some(r=>String(r[h.indexOf('startup')]||'').trim().toLowerCase()===String(a.startup).toLowerCase()&&String(r[h.indexOf('email')]||'').toLowerCase().indexOf(String(a.email).toLowerCase())>=0);if(dup){errs.push('dup '+a.startup);continue;}\n maxId++;const row=h.map(()=> '');row[h.indexOf('deal_id')]='D'+String(maxId).padStart(5,'0');for(const k of Object.keys(a)){const i=h.indexOf(k);if(i<0){throw new Error('no column '+k);}row[i]=a[k];}\n appendRows.push(row);added.push(row[0]+' '+a.startup);next++;}\nerrs.push.apply(errs,[]);$getWorkflowStaticData('global').added=added;\nif(errs.length&&!b.skip_errors){throw new Error('guard failed: '+errs.slice(0,20).join('; '));}\nreturn [{json:{errs:errs,added:added,appendRows:appendRows,anchor:v.length,body:{valueInputOption:'RAW',data:data}}}];"
