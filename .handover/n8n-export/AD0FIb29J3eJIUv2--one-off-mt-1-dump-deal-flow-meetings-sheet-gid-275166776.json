      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $input.first().json;\nconst sheets = (meta.sheets || []).map(function (x) { return x.properties; });\nconst want = sheets.filter(function (p) { return String(p.sheetId) === '275166776'; })[0];\nif (!want) { throw new Error('ABORT: gid 275166776 not found. Tabs: ' + JSON.stringify(sheets.map(function (p) { return p.sheetId + '=' + p.title; }))); }\nreturn [{ json: { title: want.title, range: \"'\" + want.title.replace(/'/g, \"''\") + \"'!A1:BZ500\",\n  tabs: sheets.map(function (p) { return p.sheetId + ' = ' + p.title + ' (' + (p.gridProperties ? p.gridProperties.rowCount + 'x' + p.gridProperties.columnCount : '?') + ')'; }) } }];"
