        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const pick = $('Pick tab').first().json;\nconst vals = $input.first().json.values || [];\nconst rows = [];\nlet maxCols = 0;\nfor (let i = 0; i < vals.length; i++) {\n  const r = vals[i].map(function (c) { return String(c == null ? '' : c).replace(/\\s+/g, ' ').trim(); });\n  while (r.length && r[r.length - 1] === '') { r.pop(); }\n  if (r.length > maxCols) { maxCols = r.length; }\n  rows.push((i + 1) + ': ' + r.join(' | '));\n}\nreturn [{ json: { tab: pick.title, all_tabs: pick.tabs, row_count: vals.length, max_cols: maxCols, grid: rows } }];"
      }
    }
