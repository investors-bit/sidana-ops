      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "var b=$('Webhook').first().json.body||{};\nif(b.secret!=='sv-mail-2026-09-17-Kq7'){throw new Error('bad secret');}\nfunction s(v){return String(v==null?'':v).trim();}\nvar rows=($('Read BOUNCES').first().json||{}).values||[];\nvar hdr=(rows[0]||[]).map(s);\nvar lc=hdr.map(function(x){return x.toLowerCase();});\nvar existing=[];\nfor(var i=1;i<rows.length;i++){var r=rows[i]||[];var any=false;for(var j=0;j<r.length;j++){if(s(r[j])){any=true;break;}}if(any)existing.push(r.map(s).join(' | ').toLowerCase());}\nvar recs=b.rows||[];\nvar bad=/[–—]|&mdash;|&ndash;/;\nvar outRows=[],skipped=[];\nfor(var k=0;k<recs.length;k++){\n  var rec=recs[k];\n  var key=s(rec.email||rec.address||'').toLowerCase();\n  var dup=false;\n  if(key){for(var m=0;m<existing.length;m++){if(existing[m].indexOf(key)>=0){dup=true;break;}}}\n  if(dup){skipped.push({email:key,reason:'already in BOUNCES'});continue;}\n  var arr=[];\n  for(var c=0;c<hdr.length;c++){\n    var v='';\n    var want=lc[c];\n    var ks=Object.keys(rec);\n    for(var q=0;q<ks.length;q++){if(ks[q].toLowerCase()===want){v=s(rec[ks[q]]);break;}}\n    if(bad.test(v)){throw new Error('DASH FOUND in '+want+', refusing to write');}\n    arr.push(v);\n  }\n  outRows.push(arr);\n}\nif(b.dry){return [{json:{dry:true,header:hdr,existing_rows:existing.length,would_append:outRows,skipped:skipped}}];}\nif(!outRows.length){return [{json:{header:hdr,appended:0,skipped:skipped,note:'nothing to append'}}];}\nreturn [{json:{header:hdr,skipped:skipped,body:{values:outRows}}}];"
      }
