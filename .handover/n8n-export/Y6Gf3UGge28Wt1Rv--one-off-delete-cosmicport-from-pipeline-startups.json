    {
      "id": "n4",
      "name": "Build delete requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const meta = $input.first().json;\nconst gid = {};\nfor (const s of (meta.sheets || [])) { gid[String(s.properties.title).trim()] = s.properties.sheetId; }\nif (gid['PIPELINE'] === undefined) { throw new Error('PIPELINE tab not found'); }\nif (gid['STARTUPS'] === undefined) { throw new Error('STARTUPS tab not found'); }\n\nconst hit = (s) => /cosmic\\s*port/i.test(String(s || ''));\n\nconst pipeRows = [];\nfor (const p of $('Read PIPELINE').all()) { if (hit(p.json.startup)) { pipeRows.push(Number(p.json.row_number)); } }\nconst stRows = [];\nfor (const s of $('Read STARTUPS').all()) { if (hit(s.json.startup)) { stRows.push(Number(s.json.row_number)); } }\n\nif (pipeRows.length === 0 && stRows.length === 0) { throw new Error('No Cosmicport rows found - aborting'); }\nif (pipeRows.length > 30) { throw new Error('Sanity check: refusing to delete ' + pipeRows.length + ' PIPELINE rows'); }\nif (stRows.length > 3) { throw new Error('Sanity check: refusing to delete ' + stRows.length + ' STARTUPS rows'); }\nfor (const r of pipeRows.concat(stRows)) { if (!(r > 1)) { throw new Error('Bad row number ' + r + ' - aborting'); } }\n\npipeRows.sort((a, b) => b - a);\nstRows.sort((a, b) => b - a);\n\nconst reqs = [];\nfor (const r of pipeRows) { reqs.push({ deleteDimension: { range: { sheetId: gid['PIPELINE'], dimension: 'ROWS', startIndex: r - 1, endIndex: r } } }); }\nfor (const r of stRows) { reqs.push({ deleteDimension: { range: { sheetId: gid['STARTUPS'], dimension: 'ROWS', startIndex: r - 1, endIndex: r } } }); }\n\nreturn [{ json: { pipeline_rows_to_delete: pipeRows.length, startups_rows_to_delete: stRows.length, pipeline_rows: pipeRows, startups_rows: stRows, body: { requests: reqs } } }];"
      }
    },
