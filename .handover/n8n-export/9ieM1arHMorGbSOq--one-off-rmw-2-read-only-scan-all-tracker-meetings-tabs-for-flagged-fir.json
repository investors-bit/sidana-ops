    {
      "id": "c3",
      "name": "Scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const KEYS=['riceberg','siana','dsg','blinc','prath'];\nfunction s(v){return String(v==null?'':v).replace(/\\s+/g,' ').trim();}\nconst out={tracker_tabs:$('Tracker ranges').first().json.tabs,meeting_tabs:$('Meetings ranges').first().json.tabs,hits:[],tab_rows:{}};\nfunction scan(label,vr){for(const v of (vr||[])){const rows=v.values||[];out.tab_rows[label+':'+v.range]=rows.length;for(let i=0;i<rows.length;i++){const line=rows[i].map(s).join(' | ');const low=line.toLowerCase();for(const k of KEYS){if(low.indexOf(k)>=0){out.hits.push({src:label,range:v.range,row:i+1,key:k,text:line.slice(0,700)});break;}}}}}\nscan('tracker',$('Tracker values').first().json.valueRanges);\nscan('meetings',$input.first().json.valueRanges);\nreturn [{json:out}];"
      }
    }
