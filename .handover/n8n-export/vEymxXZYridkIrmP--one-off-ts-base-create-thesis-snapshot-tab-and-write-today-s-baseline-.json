    {
      "id": "c1",
      "name": "Build snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Same row_text rule as the THESIS-WATCH row-diff node: every cell of the row, trimmed, joined with ' | ', trailing blanks dropped.\nfunction s(v) { return String(v == null ? '' : v).replace(/\\s+/g, ' ').trim(); }\nconst grid = $('GET thesis raw').first().json.values || [];\nif (grid.length < 5) { throw new Error('ABORT: Thesis tab read only ' + grid.length + ' rows'); }\nconst out = [['sheet_row', 'firm', 'row_text', 'snapshot_date']];\nconst today = new Date(Date.now() + 330 * 60000).toISOString().slice(0, 10);\nlet firm = '';\nfor (let i = 0; i < grid.length; i++) {\n  const cells = (grid[i] || []).map(s); while (cells.length && !cells[cells.length - 1]) { cells.pop(); }\n  if (!cells.length) { continue; }\n  if (cells[0]) { firm = cells[0]; }\n  out.push([String(i + 1), firm, cells.join(' | ').slice(0, 45000), today]);\n}\nwhile (out.length < 600) { out.push(['', '', '', '']); }\nreturn [{ json: { values: out, rows: out.filter(function (r) { return r[0]; }).length - 1 } }];"
      }
    },
    {
