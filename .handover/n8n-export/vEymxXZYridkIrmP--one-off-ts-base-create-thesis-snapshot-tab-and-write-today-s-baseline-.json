        "url": "https://sheets.googleapis.com/v4/spreadsheets/1hTpvAl-fj8ON4MiiWVgc478QCdWVcwEe-2dI3sLiGq4:batchUpdate",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"requests\":[{\"addSheet\":{\"properties\":{\"title\":\"THESIS SNAPSHOT\",\"gridProperties\":{\"rowCount\":600,\"columnCount\":6}}}}]}",
        "options": {}
