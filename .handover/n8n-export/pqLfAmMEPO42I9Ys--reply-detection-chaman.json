        "jsCode": "const all = $('Read labels final').all();\nconst wanted = $json.labelNames || [];\nconst out = [];\nfor (const n of wanted) { const f = all.find((l) => String((l.json.name || '')).trim() === n); if (f && f.json.id) out.push({ json: { messageId: $json.messageId, labelId: f.json.id } }); }\nreturn out;"
