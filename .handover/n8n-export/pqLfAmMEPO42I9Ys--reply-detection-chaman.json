    {
      "id": "2ad8c882-30a6-46e8-a29f-f6ebfde385d8",
      "name": "Classify reply",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        2464,
        432
      ],
      "parameters": {
        "text": "={{ $json.body }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": { \"type\": \"string\", \"enum\": [\"Positive / Meeting\", \"Interested / Reviewing\", \"Documents Requested\", \"Questions\", \"Pass\", \"Not Relevant\", \"Referral / Forwarded\", \"Out of Office\", \"Other\"] },\n    \"summary\": { \"type\": \"string\" },\n    \"confidence\": { \"type\": \"number\" }\n  },\n  \"required\": [\"category\", \"summary\", \"confidence\"]\n}",
        "options": {
          "systemPromptTemplate": "You classify an investor email reply into exactly one category from the provided enum. \"summary\" is a one-line summary of the reply. \"confidence\" is 0-100 for how sure you are of the category. If you are not clearly sure, use category \"Other\" and a low confidence. Never guess \"Pass\"."
        }
      }
    },
    {
      "id": "1bd559d1-bfdc-4cb8-aa18-e12ba16ba081",
      "name": "Chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        2544,
        656
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
