    {
      "id": "c0",
      "name": "Plan fills",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nfunction nz(x) { return s(x).toLowerCase().replace(/[^a-z0-9]/g, ''); }\nfunction colLetter(i) { let n = i + 1, out = ''; while (n > 0) { const m = (n - 1) % 26; out = String.fromCharCode(65 + m) + out; n = Math.floor((n - 1) / 26); } return out; }\nconst hdr = (($('GET INV header').first().json.values || [[]])[0] || []).map(s);\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 150) { throw new Error('ABORT: INVESTORS only ' + rows.length + ' rows'); }\nconst COL = {}; for (const h of ['contact_person', 'sector', 'stage', 'cheque_inr_cr']) { const i = hdr.indexOf(h); if (i < 0) { throw new Error('ABORT: column missing ' + h); } COL[h] = colLetter(i); }\n// values supplied by the team in the composition Excel (11 Sep 2026); fill BLANK cells only, never overwrite\nconst FILL = {\n  alexalpert: { cheque_inr_cr: 'US$100K-500K' },\n  ignacio: { sector: 'Sector agnostic (preferred: Gaming, Technology, Climate, Consumer, B2B SaaS, Real Estate)', stage: 'Pre-seed, Seed', cheque_inr_cr: 'US$100K-500K' },\n  ishansingh: { contact_person: 'Ishan Singh', sector: 'Sector agnostic', stage: 'Pre-seed, Seed', cheque_inr_cr: 'INR 0.5-5 Cr' },\n  jonathansolamon: { contact_person: 'Jonathan Solamon', sector: 'Emerging tech: Connected / Electric / Autonomous Vehicles, Digital Health & Medical Devices, Robotics & AI, SpaceTech, Big Data, IoT & Industry 4.0', stage: 'Seed, Pre-Series A, Series A', cheque_inr_cr: 'US$100K-1M' }\n};\nconst data = [], log = [];\nfor (const k of Object.keys(FILL)) {\n  const rs = rows.filter(function (r) { return nz(r.investor) === k; });\n  if (rs.length !== 1) { throw new Error('ABORT: ' + k + ' resolves to ' + rs.length + ' rows'); }\n  const r = rs[0];\n  for (const f of Object.keys(FILL[k])) {\n    if (s(r[f])) { log.push(k + '.' + f + ' kept (already: ' + s(r[f]).slice(0, 40) + ')'); continue; }\n    data.push({ range: 'INVESTORS!' + COL[f] + r.row_number, values: [[FILL[k][f]]] }); log.push(k + '.' + f + ' -> ' + COL[f] + r.row_number);\n  }\n}\nif (!data.length) { throw new Error('ABORT: nothing to fill - all cells already have values'); }\nreturn [{ json: { data: data, log: log } }];"
      }
    },
