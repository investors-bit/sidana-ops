        "jsCode": "function s(v) { return String(v == null ? '' : v).trim(); }\nconst names = ['Alex Alpert', 'Ignacio', 'Ishan Singh', 'Jonathan Solamon'];\nconst out = $input.all().map(function (i) { return i.json; }).filter(function (r) { return names.indexOf(s(r.investor)) >= 0; }).map(function (r) {\n  return { row: r.row_number, investor: s(r.investor), contact_person: s(r.contact_person), sector: s(r.sector), stage: s(r.stage), cheque_inr_cr: s(r.cheque_inr_cr), do_not_contact: s(r.do_not_contact) }; });\nreturn [{ json: { rows: out, log: $('Plan fills').first().json.log } }];"
