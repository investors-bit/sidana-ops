      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Pairs the FULL Deal Tracker (247 rows, read via Sheets API) shows as already shared.\n// The earlier Drive export truncated at row 117, which is how these got into PIPELINE.\nconst T = ['D00942','D00946','D01028','D01125','D02025','D02897','D02902','D02920','D02932','D02947','D02950','D02960','D02964','D02970','D02981','D02988','D03000','D03001','D03003','D03004','D03007','D03011','D03031','D03063','D03064','D03065','D03067'];\nfunction s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 500) { throw new Error('ABORT: PIPELINE returned only ' + rows.length + ' rows'); }\nconst out = [];\nfor (const t of T) {\n  const h = rows.filter(function (r) { return s(r.deal_id) === t; });\n  if (h.length !== 1) { throw new Error('ABORT: expected 1 row for ' + t + ', found ' + h.length); }\n  if (s(h[0].deal_shared).toLowerCase() === 'yes') { throw new Error('ABORT: ' + t + ' already sent - refusing to delete'); }\n  if (!h[0].row_number) { throw new Error('ABORT: no row_number for ' + t); }\n  out.push({ json: { row_number: Number(h[0].row_number), deal_id: t, investor: s(h[0].investor), startup: s(h[0].startup) } });\n}\nif (out.length !== T.length) { throw new Error('ABORT: resolved ' + out.length + ' of ' + T.length); }\nout.sort(function (a, b) { return b.json.row_number - a.json.row_number; });\nfor (let i = 1; i < out.length; i++) { if (out[i].json.row_number === out[i-1].json.row_number) { throw new Error('ABORT: duplicate row_number'); } }\nreturn out;"
      }
    },
