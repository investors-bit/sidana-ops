      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const names=$('Prep').first().json.names;\nconst vr=($input.first().json.valueRanges||[]);\nconst s=v=>String(v==null?'':v).trim();\nconst pick=n=>{const m=vr.find(x=>String(x.range||'').replace(/'/g,'').toUpperCase().startsWith(n+'!'));return (m&&m.values)?m.values:[];};\nconst CR=pick('INVESTOR_CRITERIA'),IN=pick('INVESTORS');\nconst crh=(CR[0]||[]).map(s), inh=(IN[0]||[]).map(s);\nconst ci=crh.map(h=>h.toLowerCase()).indexOf('investor');\nconst ii=inh.map(h=>h.toLowerCase()).findIndex(h=>/^(investor|firm|investor_name|name)$/.test(h));\nconst hit=(v)=>names.some(n=>s(v).toLowerCase().indexOf(n)>=0);\nconst crRows=[],inRows=[];\nfor(let i=1;i<CR.length;i++){const r=CR[i]||[];if(ci>=0&&hit(r[ci])){const o={_row:i+1};crh.forEach((h,k)=>{if(h&&s(r[k]))o[h]=s(r[k]);});crRows.push(o);}}\nfor(let i=1;i<IN.length;i++){const r=IN[i]||[];if(ii>=0&&hit(r[ii])){const o={_row:i+1};inh.forEach((h,k)=>{if(h&&s(r[k]))o[h]=s(r[k]);});inRows.push(o);}}\nreturn [{json:{crit_header:crh,crit_rows_total:CR.length-1,inv_rows_total:IN.length-1,criteria:crRows,investors:inRows}}];"
      }
    }
