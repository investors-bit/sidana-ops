    {
      "id": "n3",
      "name": "Build INVESTORS updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const FIX = [\n  { match: /^tvs capital funds$/i,  contact_person: 'Gaurav', email: 'Gaurav.Sekhri@herocorp.com' },\n  { match: /^flipkart ventures$/i,  contact_person: 'Parrth', email: 'partth.mahajan@flipkart.com' },\n];\nconst out = [];\nfor (const v of $('Read INVESTORS').all()) {\n  const name = String(v.json.investor || '').trim();\n  for (const f of FIX) {\n    if (f.match.test(name)) { out.push({ json: { investor: name, contact_person: f.contact_person, email: f.email } }); }\n  }\n}\nif (out.length !== FIX.length) { throw new Error('Expected ' + FIX.length + ' INVESTORS matches, found ' + out.length + ' - aborting'); }\nreturn out;"
      }
    },
