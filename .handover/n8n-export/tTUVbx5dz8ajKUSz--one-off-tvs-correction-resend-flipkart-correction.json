    {
      "id": "n5",
      "name": "Build PIPELINE updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const TVS_EMAIL = 'Gaurav.Sekhri@herocorp.com';\nconst FLIP_EMAIL = 'partth.mahajan@flipkart.com';\nconst RESEND_DUE = '2026-09-05';\nconst yes = (x) => String(x || '').trim().toLowerCase() === 'yes';\n\nconst out = [];\nlet tvsReset = 0, tvsEmailOnly = 0, flip = 0;\n\nfor (const p of $('Read PIPELINE').all()) {\n  const inv = String(p.json.investor || '').trim();\n  const id = String(p.json.deal_id || '').trim();\n\n  if (/^tvs capital funds$/i.test(inv)) {\n    if (yes(p.json.deal_shared)) {\n      // bounced - reset so it goes out fresh to the working address\n      tvsReset++;\n      out.push({ json: {\n        deal_id: id, email: TVS_EMAIL,\n        deal_shared: 'No', date_shared: '', channel: '', thread_id: '', message_id: '',\n        fu1_done: '', fu1_date: '', fu2_done: '', fu2_date: '', fu3_done: '', fu3_date: '',\n        last_contact: '', next_action: 'Initial', next_due: RESEND_DUE,\n      } });\n    } else {\n      tvsEmailOnly++;\n      out.push({ json: { deal_id: id, email: TVS_EMAIL } });\n    }\n    continue;\n  }\n\n  if (/^flipkart ventures$/i.test(inv)) {\n    flip++;\n    out.push({ json: { deal_id: id, email: FLIP_EMAIL } });\n  }\n}\n\nif (out.length === 0) { throw new Error('No rows matched - aborting'); }\nif (tvsReset > 10) { throw new Error('Sanity check: ' + tvsReset + ' TVS resets is more than expected'); }\nif (out.length > 60) { throw new Error('Sanity check: ' + out.length + ' rows is more than expected'); }\nreturn out;"
      }
    },
