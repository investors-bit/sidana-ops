    {
      "id": "cd2",
      "name": "Build two fund rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// IAN Group runs two distinct funds (corrections sheet, 2026-09-07). One row cannot hold both:\n// merging them would let a 20 Cr raise match the Angel consumer thesis and a 3 Cr deeptech deal\n// look eligible for Alpha. Split so each fund matches on its own stage and cheque band.\nconst prev = $('Locate old IAN row').first().json;\nreturn [\n  { json: {\n    investor: 'IAN Group - Angel Fund',\n    contact_person: 'Brendon',\n    email: 'brendon@iangroup.vc',\n    cc: '',\n    sector: 'Sector agnostic; mainly DeepTech, SaaS, Consumer (D2C, niche products, new category building), Healthcare (medical devices, biotech)',\n    stage: 'Pre-seed to Seed',\n    cheque_inr_cr: 'INR 2-6 Cr',\n    last_contacted_any: prev.carried_last_contacted,\n    contacted_by: prev.carried_contacted_by,\n    do_not_contact: ''\n  }},\n  { json: {\n    investor: 'IAN Group - Alpha Fund',\n    contact_person: 'Brendon',\n    email: 'brendon@iangroup.vc',\n    cc: '',\n    sector: 'Tech focus: DeepTech, AI, Enterprise, SaaS, emerging SaaS',\n    stage: 'Pre-Series A to Series A',\n    cheque_inr_cr: 'INR 15-30 Cr',\n    last_contacted_any: '',\n    contacted_by: '',\n    do_not_contact: ''\n  }}\n];"
      }
    },
