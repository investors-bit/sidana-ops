      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const OLD = 'IAN Group (Indian Angel Network)';\nfunction s(v) { return String(v == null ? '' : v).trim(); }\nconst rows = $input.all().map(function (i) { return i.json; });\nif (rows.length < 100) { throw new Error('ABORT: INVESTORS returned only ' + rows.length + ' rows'); }\n\nconst hits = rows.filter(function (r) { return s(r.investor) === OLD; });\nif (hits.length !== 1) { throw new Error('ABORT: expected 1 INVESTORS row for ' + OLD + ', found ' + hits.length); }\nconst h = hits[0];\nif (!h.row_number) { throw new Error('ABORT: no row_number'); }\n\n// Guard: the split rows must not already exist (re-run safety)\nfor (const n of ['IAN Group - Angel Fund', 'IAN Group - Alpha Fund']) {\n  if (rows.some(function (r) { return s(r.investor) === n; })) { throw new Error('ABORT: ' + n + ' already exists'); }\n}\n\nreturn [{ json: {\n  row_number: Number(h.row_number),\n  carried_last_contacted: s(h.last_contacted_any),\n  carried_contacted_by: s(h.contacted_by)\n}}];"
      }
    },
