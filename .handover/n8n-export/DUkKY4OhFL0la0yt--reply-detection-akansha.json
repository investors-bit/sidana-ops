    {
      "id": "6e56bf77-649a-494a-a133-0ad0aaed4a68",
      "name": "Match PIPELINE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const blank = (x) => x === undefined || x === null || String(x).trim() === '';\nconst byThread = {};\nfor (const p of $('Read PIPELINE').all()) {\n  const tid = String(p.json.thread_id || '').trim();\n  if (tid && byThread[tid] === undefined) byThread[tid] = p.json;\n}\nconst out = [];\nfor (const it of $input.all()) {\n  const m = it.json;\n  const tid = String(m.threadId || '').trim();\n  const row = tid ? byThread[tid] : undefined;\n  let route;\n  if (!row) route = 'unmatched';\n  else if (!blank(row.investor_response)) route = 'already';\n  else route = 'classify';\n  out.push({ json: {\n    route,\n    messageId: m.messageId,\n    threadId: m.threadId,\n    from: m.from,\n    subject: m.subject,\n    body: m.body,\n    deal_id: row ? row.deal_id : '',\n    startup: row ? row.startup : '',\n    investor: row ? row.investor : '',\n    existing_notes: row ? (row.notes || '') : '',\n  }});\n}\nreturn out;"
      }
    },
