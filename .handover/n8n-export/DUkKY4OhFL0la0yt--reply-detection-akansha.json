    {
      "id": "46cebe43-3833-49f9-8b6f-e4b92b1cf8c4",
      "name": "Flag auto-replies",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const out = [];\nconst subjRe = /out of office|automatic reply|auto-?reply|on leave|vacation/i;\nfor (const it of $input.all()) {\n  const m = it.json;\n  // Normalise header keys to lowercase for reliable lookup.\n  const rawHeaders = m.headers || {};\n  const h = {};\n  for (const k in rawHeaders) { h[String(k).toLowerCase()] = rawHeaders[k]; }\n\n  let isAuto = false;\n  let reason = '';\n  const autoSubmitted = h['auto-submitted'];\n  if (autoSubmitted !== undefined && autoSubmitted !== null && String(autoSubmitted).trim().toLowerCase() !== 'no') { isAuto = true; reason = 'Auto-Submitted header'; }\n  if (!isAuto && (h['x-autoreply'] !== undefined || h['x-autorespond'] !== undefined)) { isAuto = true; reason = 'X-Autoreply/X-Autorespond header'; }\n  if (!isAuto && h['precedence'] !== undefined) {\n    const p = String(h['precedence']).trim().toLowerCase();\n    if (p === 'bulk' || p === 'auto_reply' || p === 'junk') { isAuto = true; reason = 'Precedence: ' + p; }\n  }\n  const subject = String(m.Subject || m.subject || '');\n  if (!isAuto && subjRe.test(subject)) { isAuto = true; reason = 'Subject matched auto-reply pattern'; }\n\n  out.push({ json: {\n    messageId: m.id,\n    threadId: m.threadId,\n    from: m.From || m.from || '',\n    subject: subject,\n    body: String(m.text || m.snippet || ''),\n    is_auto: isAuto,\n    auto_reason: reason,\n  }});\n}\nreturn out;"
      }
    },
